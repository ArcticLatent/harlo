// The editor tab: the open file's path, how saving stands and Save; any
// question to answer; then the text with line numbers, coloured by
// language, or the picture, or why it doesn't show.

import { Theme, Size, Fonts } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Logic, Requests } from "data.slint";
import { Icon, HLine, VLine } from "widgets.slint";
import { CardButton } from "waiting.slint";

/// The editor's text size.
global Code {
    out property <length> size: 13px;
    /// The space around the text.
    out property <length> padding: 12px;
}

/// A question over the text, with its choices on the right.
component Bar inherits Rectangle {
    in property <string> text;

    background: Theme.surface-raised-base;
    VerticalLayout {
        HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 9px;
            Icon {
                text: Icons.circle-alert;
                color: Theme.icon-warning-base;
            }
            Text {
                horizontal-stretch: 1;
                text: root.text;
                vertical-alignment: center;
                wrap: word-wrap;
                font-size: Size.small;
                color: Theme.text-strong;
            }
            @children
        }
        HLine { }
    }
}

/// The text with its line numbers. The field draws on top of the coloured
/// copy with its own letters see-through, so the colours show; it draws
/// only its selection, and the cursor is drawn here.
component CodeView inherits Rectangle {
    // Rust's text replaces the field's when Rust changed it.
    property <int> revision: State.editor-revision;
    changed revision => {
        root.load();
    }
    init => {
        root.load();
    }
    property <int> focus-serial: Requests.focus-serial;
    changed focus-serial => {
        if Requests.focus == "editor" {
            input.focus();
        }
    }
    // Set while Rust's text goes in, so the field doesn't send it back.
    property <bool> loading;
    function load() {
        root.loading = true;
        input.text = State.editor-text;
        input.set-selection-offsets(State.editor-anchor, State.editor-cursor);
        root.loading = false;
    }
    function report() {
        if root.loading {
            return;
        }
        Logic.editor-edited(input.text, input.cursor-position-byte-offset,
            input.anchor-position-byte-offset);
    }

    /// Where the cursor is, in the field.
    property <Point> caret;
    /// Brings the cursor into view as it moves.
    function follow(at: Point) {
        root.caret = at;
        let top = at.y + flick.viewport-y;
        if top < 0 {
            flick.viewport-y = -at.y;
        } else if top + input.font-size * 1.6 > flick.height {
            flick.viewport-y = flick.height - at.y - input.font-size * 1.6;
        }
        let left = at.x + flick.viewport-x;
        if left < 0 {
            flick.viewport-x = -at.x;
        } else if left + 2px > flick.width {
            flick.viewport-x = flick.width - at.x - 24px;
        }
    }

    background: Theme.background-base;

    HorizontalLayout {
        // The line numbers, scrolled with the text.
        Rectangle {
            width: numbers.preferred-width + 2 * Code.padding;
            clip: true;
            numbers := Text {
                x: Code.padding;
                y: flick.viewport-y + Code.padding;
                text: State.editor-numbers;
                horizontal-alignment: right;
                font-family: Fonts.mono;
                font-size: Code.size;
                color: Theme.text-weaker;
                accessible-role: none;
            }
        }
        VLine { }
        flick := Flickable {
            horizontal-stretch: 1;
            viewport-width: max(self.width, input.preferred-width + 2 * Code.padding);
            viewport-height: max(self.height, input.preferred-height + 2 * Code.padding);

            TouchArea {
                mouse-cursor: MouseCursor.text;
                clicked => { input.focus(); }
            }
            StyledText {
                x: Code.padding;
                y: Code.padding;
                width: input.width;
                height: input.height;
                text: State.editor-colored;
                default-font-family: Fonts.mono;
                default-font-size: Code.size;
                default-color: Theme.text-base;
                accessible-role: none;
            }
            input := TextInput {
                x: Code.padding;
                y: Code.padding;
                width: max(self.preferred-width, flick.width - 2 * Code.padding);
                height: max(self.preferred-height, flick.height - 2 * Code.padding);
                single-line: false;
                wrap: no-wrap;
                font-family: Fonts.mono;
                font-size: Code.size;
                // Not fully see-through: the renderer skips a field whose
                // text is, selection and all.
                color: #ffffff01;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.text-strong;
                accessible-label: State.editor-card.path;
                edited => { root.report(); }
                cursor-position-changed(at) => {
                    root.follow(at);
                    root.report();
                }
            }
            if input.has-focus: Rectangle {
                x: input.x + root.caret.x;
                y: input.y + root.caret.y;
                width: 2px;
                height: input.font-size * 1.3;
                background: Theme.text-strong;
            }
        }
    }
}

/// The editor tab's body.
export component EditorView inherits Rectangle {
    background: Theme.background-base;

    VerticalLayout {
        HorizontalLayout {
            height: 44px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 10px;
            Text {
                text: State.editor-card.path;
                vertical-alignment: center;
                overflow: elide;
                font-family: Fonts.mono;
                font-size: Size.small;
                color: Theme.text-base;
            }
            Text {
                horizontal-stretch: 1;
                text: State.editor-card.status;
                vertical-alignment: center;
                overflow: elide;
                font-size: Size.small;
                color: State.editor-card.failed ? Theme.icon-critical-base : Theme.text-weak;
            }
            if State.editor-card.text: VerticalLayout {
                alignment: center;
                CardButton {
                    height: 26px;
                    text: "Save";
                    main: true;
                    enabled: State.editor-card.can-save;
                    clicked => { Logic.file-save(); }
                }
            }
        }
        HLine { }
        if State.editor-card.closing != "": Bar {
            text: State.editor-card.closing;
            CardButton {
                height: 26px;
                text: "Save";
                // Told apart from the header's Save.
                label: "Save first";
                main: true;
                clicked => { Logic.file-save-and-close(); }
            }
            CardButton {
                height: 26px;
                text: "Don't save";
                clicked => { Logic.file-discard(); }
            }
            CardButton {
                height: 26px;
                text: "Cancel";
                clicked => { Logic.file-keep-open(); }
            }
        }
        if State.editor-card.outside == 1: Bar {
            text: "This file changed on disk while you had unsaved changes.";
            CardButton {
                height: 26px;
                text: "Load the new version";
                clicked => { Logic.file-reload(); }
            }
            CardButton {
                height: 26px;
                text: "Keep mine";
                clicked => { Logic.file-keep-mine(); }
            }
        }
        if State.editor-card.outside == 2: Bar {
            text: "This file was deleted on disk. Saving puts it back.";
            CardButton {
                height: 26px;
                text: "OK";
                clicked => { Logic.file-keep-mine(); }
            }
        }
        if State.editor-card.body == 1: CodeView {
            vertical-stretch: 1;
        }
        if State.editor-card.body == 2: Rectangle {
            vertical-stretch: 1;
            Image {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                height: parent.height - 48px;
                source: State.editor-picture;
                image-fit: contain;
                accessible-role: image;
                accessible-label: State.editor-card.path;
            }
        }
        if State.editor-card.body == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                text: State.editor-card.note;
                font-size: Size.label;
                color: Theme.text-base;
            }
        }
    }
}
