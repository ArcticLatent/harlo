// A session's timeline: prompts, answers block by block, thoughts, tool
// calls and their diffs, and subagents, in one virtualized list.

import { ListView } from "std-widgets.slint";
import { Theme, Size, Fonts, Motion, Curves } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Logic, Shape, TimelineRow, DiffLine, Chip, PromptMark } from "data.slint";
import { Icon, Press, HLine, Breathing, Spinner } from "widgets.slint";
import { ThumbStrip } from "pictures.slint";

/// The timeline column's widest size.
export global Column {
    out property <length> width: Size.chat-width;
    /// The room each side of the column keeps for the prompt rail.
    out property <length> rail: 56px;
    /// The narrowest the column gets to make that room; narrower than
    /// this, the rail goes.
    out property <length> narrowest: 400px;
    /// The room each side of the column keeps without the rail.
    out property <length> margin: 24px;
    /// How far rows inside an open group are indented.
    out property <length> indent: 18px;
    /// A one-line row's height.
    out property <length> line: 24px;
    /// A diff line's height.
    out property <length> diff-line: 19px;
    /// One digit of the code font, as the window measures it: a diff's
    /// number column fits its largest number's digits.
    in-out property <length> diff-digit: 7.5px;
}

/// The agent whose turn starts here, before the turn's first line: its
/// icon and name in its colour, then a faint divider.
component TurnMark inherits HorizontalLayout {
    in property <string> agent;
    in property <color> tint;

    horizontal-stretch: 0;
    spacing: 7px;
    Icon {
        text: Icons.bot;
        font-size: 13px;
        color: root.tint;
    }
    Text {
        text: root.agent;
        vertical-alignment: center;
        font-size: Size.small;
        font-weight: 500;
        color: root.tint;
    }
    VerticalLayout {
        alignment: center;
        padding-left: 3px;
        padding-right: 3px;
        Rectangle {
            width: 1px;
            height: 11px;
            background: Theme.border-weak-base;
        }
    }
}

/// A row's marker, which turns while `working`.
component Glyph inherits Rectangle {
    in property <string> glyph;
    in property <color> glyph-color;
    in property <bool> working;
    in property <length> size: 13px;

    width: 14px;
    if root.working: Spinner {
        size: root.size;
        tint: root.glyph-color;
    }
    if !root.working: Icon {
        text: root.glyph;
        font-size: root.size;
        color: root.glyph-color;
    }
}

/// "+3 −1", in the added and removed colours.
export component Counts inherits HorizontalLayout {
    in property <int> added;
    in property <int> removed;

    spacing: 4px;
    if root.added > 0 || root.removed == 0: Text {
        text: "+\{root.added}";
        vertical-alignment: center;
        font-size: Size.small;
        color: Theme.added-ink;
    }
    if root.removed > 0: Text {
        text: "−\{root.removed}";
        vertical-alignment: center;
        font-size: Size.small;
        color: Theme.removed-ink;
    }
}

/// A small text button, in the link colour.
export component LinkButton inherits Press {
    in property <string> text;
    in property <string> glyph;

    height: 20px;
    label: root.text;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Size.small;
            color: Theme.text-interactive-base;
        }
        if root.glyph != "": Icon {
            text: root.glyph;
            font-size: 12px;
            color: Theme.text-interactive-base;
        }
    }
}

/// Answer text: Markdown, in the body colour, with links that open.
component Prose inherits StyledText {
    default-font-size: Size.answer;
    default-font-family: Fonts.sans;
    default-color: Theme.text-base;
    link-color: Theme.link-ink;
    selectable: true;
    selection-background-color: Theme.selection;
    link-clicked(url) => { Logic.link(url); }
}

/// A prompt's bubble, with Undo in its corner while the pointer is on it.
component PromptRow inherits Rectangle {
    in property <TimelineRow> item;
    // A prompt that just arrived fades in, rising a little.
    property <float> shown: root.item.fresh ? 0 : 1;
    animate shown {
        duration: Motion.appear;
        easing: Curves.settle;
    }
    init => {
        root.shown = 1;
    }

    height: bubble.preferred-height;
    opacity: root.shown;

    // The bubble and its Undo sit inside, so the pointer over either
    // counts as on the prompt.
    hover := TouchArea {
        bubble := Rectangle {
            y: (1 - root.shown) * Motion.rise;
            // Read out as the prompt; its Prose reads out nothing itself.
            accessible-role: groupbox;
            accessible-label: root.item.label;
            background: Theme.prompt-fill;
            border-radius: Size.composer-radius;
            opacity: root.item.sending ? 0.7 : 1;

            VerticalLayout {
                padding-top: 11px;
                padding-bottom: 11px;
                padding-left: 14px;
                // Room for Undo, so it never covers the words and they don't
                // move when it shows.
                padding-right: root.item.undo ? 76px : 16px;
                spacing: 8px;
                if root.item.label != "": HorizontalLayout {
                    spacing: 12px;
                    // Who said it, set apart from what was said.
                    VerticalLayout {
                        alignment: start;
                        // "You", or the agent that handed a subagent its work.
                        Text {
                            height: Size.answer * 1.4;
                            text: root.item.detail != "" ? root.item.detail : "You";
                            vertical-alignment: center;
                            font-size: Size.small;
                            font-weight: 500;
                            color: root.item.detail != "" ? Theme.agent-ink : Theme.accent-ink;
                            accessible-role: none;
                        }
                    }
                    Prose {
                        horizontal-stretch: 1;
                        text: root.item.text;
                        default-color: Theme.text-strong;
                    }
                }
                if root.item.pictures.length > 0: ThumbStrip {
                    pictures: root.item.pictures;
                }
                if root.item.chips.length > 0: HorizontalLayout {
                    alignment: start;
                    spacing: 6px;
                    for chip in root.item.chips: Rectangle {
                        background: Theme.control-fill;
                        border-radius: Size.radius;
                        border-width: 1px;
                        border-color: Theme.control-edge;
                        HorizontalLayout {
                            padding-top: 3px;
                            padding-bottom: 3px;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            Icon {
                                text: chip.glyph;
                                font-size: 11px;
                            }
                            Text {
                                text: chip.label;
                                vertical-alignment: center;
                                font-size: Size.small;
                                color: Theme.text-base;
                            }
                        }
                    }
                }
            }
        }

        if root.item.undo && hover.has-hover: Press {
            x: parent.width - self.width - 6px;
            y: 6px;
            width: undo-label.preferred-width;
            height: 22px;
            label: "Undo";
            rest: Theme.card;
            hover: Theme.chip-hover;
            outlined: true;
            clicked => { Logic.undo(root.item.key); }
            undo-label := HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 5px;
                Icon {
                    text: Icons.undo;
                    font-size: 12px;
                }
                Text {
                    text: "Undo";
                    vertical-alignment: center;
                    font-size: Size.small;
                    color: Theme.text-base;
                }
            }
        }
    }
}

/// A one-line row: a marker, a label, its detail, counts and a time.
component LineRow inherits Rectangle {
    in property <TimelineRow> item;

    height: Column.line;
    HorizontalLayout {
        spacing: 9px;
        if root.item.turn != "": TurnMark {
            agent: root.item.turn;
            tint: root.item.turn-color;
        }
        if root.item.glyph != "": Glyph {
            glyph: root.item.glyph;
            glyph-color: root.item.glyph-color;
            working: root.item.working;
        }
        Text {
            text: root.item.label;
            vertical-alignment: center;
            horizontal-stretch: root.item.detail == "" && root.item.action == "" ? 1 : 0;
            overflow: elide;
            font-size: root.item.nested ? Size.label : Size.small;
            color: root.item.nested ? Theme.text-base : Theme.text-weak;
        }
        if root.item.detail != "": Text {
            text: root.item.detail;
            vertical-alignment: center;
            // Before a button the words keep their width, so the button follows them.
            horizontal-stretch: root.item.action == "" ? 1 : 0;
            overflow: elide;
            font-size: root.item.mono ? Size.code : Size.small;
            font-family: root.item.mono ? Fonts.mono : Fonts.sans;
            color: !root.item.mono ? Theme.text-weaker
                : root.item.nested ? Theme.link-ink : Theme.text-base;
        }
        if root.item.counts: Counts {
            added: root.item.added;
            removed: root.item.removed;
        }
        if root.item.note != "": Text {
            text: root.item.note;
            vertical-alignment: center;
            font-size: Size.small;
            color: root.item.note-color;
        }
        // A way on from here, such as Continue after a stop.
        if root.item.action != "": VerticalLayout {
            alignment: center;
            Press {
                height: 24px;
                width: action-text.preferred-width + 20px;
                label: root.item.action;
                rest: Theme.control-fill;
                outlined: true;
                clicked => { Logic.continue-run(); }
                action-text := Text {
                    text: root.item.action;
                    font-size: Size.small;
                    color: Theme.text-strong;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
        // The rest of the row stays empty, so the button sits after the words.
        if root.item.action != "": Rectangle { horizontal-stretch: 1; }
    }
}

/// The header of a run of tool calls, which opens or closes it.
component GroupRow inherits Press {
    in property <TimelineRow> item;

    height: Column.line;
    label: root.item.label + ": " + root.item.detail;
    hover: transparent;
    accessible-expandable: true;
    accessible-expanded: root.item.open;
    clicked => { Logic.toggle-group(root.item.key); }

    HorizontalLayout {
        spacing: 9px;
        if root.item.turn != "": TurnMark {
            agent: root.item.turn;
            tint: root.item.turn-color;
        }
        Glyph {
            glyph: root.item.working ? Icons.loader
                : root.item.open ? Icons.chevron-down : Icons.chevron-right;
            glyph-color: root.item.working ? Theme.accent-ink : Theme.icon-quiet;
            working: root.item.working;
        }
        Text {
            text: root.item.label;
            vertical-alignment: center;
            font-size: Size.small;
            color: root.hovered ? Theme.text-strong : Theme.text-base;
        }
        Text {
            text: root.item.detail;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: Size.small;
            color: Theme.text-weaker;
        }
    }
}

/// One line of a diff: its number, + or −, and its text, tinted.
export component PatchLine inherits Rectangle {
    in property <DiffLine> line;
    /// The number column: its diff's digits, and a little room before them.
    out property <length> number-width: Column.diff-digit * max(1, root.line.digits) + 4px;

    height: Column.diff-line;
    background: root.line.kind == 1 ? Theme.added-line
        : root.line.kind == 2 ? Theme.removed-line : transparent;
    HorizontalLayout {
        padding-right: 8px;
        spacing: 10px;
        Text {
            width: root.number-width;
            text: root.line.number;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-family: Fonts.mono;
            font-size: Size.code;
            color: Theme.text-weaker;
        }
        Text {
            width: 10px;
            text: root.line.mark;
            vertical-alignment: center;
            font-family: Fonts.mono;
            font-size: Size.code;
            color: root.line.kind == 1 ? Theme.added-ink
                : root.line.kind == 2 ? Theme.removed-ink : Theme.text-weaker;
        }
        Text {
            text: root.line.text;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: clip;
            font-family: Fonts.mono;
            font-size: Size.code;
            color: root.line.kind == 3 ? Theme.text-weaker
                : root.line.kind == 0 ? Theme.text-weak : Theme.text-base;
        }
    }
}

/// Lines of a tool's diff, as one piece of its sunken box.
component DiffRow inherits Rectangle {
    in property <TimelineRow> item;

    height: body.preferred-height;

    // A changed file opens the Changes panel on it, at this edit's turn.
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { Logic.review(root.item.key, root.item.file); }
    }

    body := VerticalLayout {
        if root.item.top && root.item.label != "": HorizontalLayout {
            padding-bottom: 6px;
            spacing: 8px;
            Text {
                text: root.item.label;
                horizontal-stretch: 1;
                overflow: elide;
                font-family: Fonts.mono;
                font-size: Size.code;
                color: Theme.text-strong;
            }
            Counts {
                added: root.item.added;
                removed: root.item.removed;
            }
        }
        Rectangle {
            background: Theme.surface-inset-base;
            border-top-left-radius: root.item.top ? Size.radius : 0;
            border-top-right-radius: root.item.top ? Size.radius : 0;
            border-bottom-left-radius: root.item.bottom ? Size.radius : 0;
            border-bottom-right-radius: root.item.bottom ? Size.radius : 0;
            clip: true;

            VerticalLayout {
                padding-top: root.item.top ? 5px : 0;
                padding-bottom: root.item.bottom ? 5px : 0;
                for line in root.item.lines: PatchLine {
                    line: line;
                }
                if root.item.more != "": HorizontalLayout {
                    padding-left: Column.diff-digit * max(1, root.item.lines[0].digits) + 4px;
                    padding-top: 4px;
                    alignment: start;
                    LinkButton {
                        text: root.item.more;
                        clicked => { Logic.toggle-diff(root.item.key); }
                    }
                }
            }
        }
    }
}

/// Work handed to a subagent: who, what, how it stands, and a way to it.
component SubagentRow inherits Rectangle {
    in property <TimelineRow> item;

    height: 38px;
    background: Theme.surface-raised-base;
    border-color: Theme.border-weak-base;
    border-width: 1px;
    border-radius: Size.radius;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 9px;
        Glyph {
            glyph: Icons.bot;
            glyph-color: root.item.glyph-color;
            size: 14px;
        }
        Text {
            text: root.item.label;
            vertical-alignment: center;
            font-size: Size.label;
            font-weight: 500;
            color: Theme.text-strong;
        }
        Text {
            text: root.item.detail;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: Size.label;
            color: Theme.text-base;
        }
        if root.item.working: Breathing {
            Text {
                text: root.item.note;
                vertical-alignment: center;
                font-size: Size.small;
                color: root.item.note-color;
            }
        }
        if !root.item.working && root.item.note != "": Text {
            text: root.item.note;
            vertical-alignment: center;
            font-size: Size.small;
            color: root.item.note-color;
        }
        if root.item.child != "": VerticalLayout {
            alignment: center;
            LinkButton {
                text: "Open";
                glyph: Icons.arrow-right;
                clicked => { Logic.open-session(root.item.child); }
            }
        }
    }
}

/// What a subagent reported back, with its first lines below.
component ReportRow inherits VerticalLayout {
    in property <TimelineRow> item;

    spacing: 2px;
    HorizontalLayout {
        height: Column.line;
        spacing: 9px;
        Glyph {
            glyph: root.item.glyph;
            glyph-color: root.item.glyph-color;
        }
        Text {
            text: root.item.label;
            vertical-alignment: center;
            font-size: Size.small;
            color: Theme.text-base;
        }
        Text {
            text: root.item.detail;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: Size.small;
            color: Theme.text-weak;
        }
        VerticalLayout {
            alignment: center;
            LinkButton {
                text: "Open";
                glyph: Icons.arrow-right;
                clicked => { Logic.open-session(root.item.child); }
            }
        }
    }
    if root.item.note != "": HorizontalLayout {
        padding-left: 23px;
        Prose {
            text: root.item.text;
            default-font-size: Size.small;
            default-color: Theme.text-weak;
        }
    }
}

/// One timeline row, of whatever shape, in the column.
component RowView inherits Rectangle {
    in property <TimelineRow> item;
    /// The column's width and its left edge.
    in property <length> column;
    in property <length> left;

    height: content.preferred-height;
    // The list takes its widest row's minimum width; a long unbroken word
    // must wrap inside the column, not widen the list sideways.
    min-width: 0;

    // Calls inside an open group hang from a faint line down their indent.
    if root.item.nested: Rectangle {
        x: root.left + 6px;
        width: 1px;
        height: parent.height;
        background: Theme.border-weak-base;
    }

    content := VerticalLayout {
        padding-top: root.item.gap;
        padding-left: root.left + (root.item.nested ? Column.indent : 0);
        padding-right: root.width - root.left - root.column;

        if root.item.shape == Shape.notice: Text {
            text: root.item.label;
            horizontal-alignment: center;
            wrap: word-wrap;
            font-size: Size.label;
            color: Theme.text-weak;
        }
        // Under the call's name, past its marker, and wrapped in full.
        if root.item.shape == Shape.reason: HorizontalLayout {
            padding-left: 23px;
            Text {
                text: root.item.label;
                wrap: word-wrap;
                font-size: Size.small;
                color: Theme.text-weak;
            }
        }
        if root.item.shape == Shape.prompt: PromptRow {
            item: root.item;
        }
        if root.item.shape == Shape.text: Prose {
            text: root.item.text;
            accessible-role: text;
            accessible-label: root.item.label;
        }
        if root.item.shape == Shape.heading: Prose {
            text: root.item.text;
            accessible-role: text;
            accessible-label: root.item.label;
            // Headings rank by size and weight, below the session's title.
            default-color: Theme.text-strong;
            default-font-size: root.item.level == 1 ? Size.answer * 1.3
                : root.item.level == 2 ? Size.answer * 1.2 : Size.answer * 1.1;
        }
        if root.item.shape == Shape.list: VerticalLayout {
            spacing: 4px;
            accessible-role: text;
            accessible-label: root.item.label;
            for entry in root.item.items: HorizontalLayout {
                padding-left: entry.depth * 20px;
                spacing: 4px;
                Text {
                    width: entry.marker == "•" || entry.marker == "◦" ? 14px : 20px;
                    horizontal-alignment: center;
                    text: entry.marker;
                    font-size: Size.answer;
                    color: Theme.text-weaker;
                    accessible-role: none;
                }
                Prose {
                    horizontal-stretch: 1;
                    text: entry.text;
                    accessible-role: none;
                }
            }
        }
        if root.item.shape == Shape.table: HorizontalLayout {
            alignment: start;
            accessible-role: table;
            accessible-label: root.item.label;
            Rectangle {
                width: cells.preferred-width;
                height: cells.preferred-height;
                cells := HorizontalLayout {
                    for column in root.item.columns: VerticalLayout {
                        min-width: 110px;
                        for cell[r] in column.cells: HorizontalLayout {
                            height: r == 0 ? 30px : 24px;
                            padding-right: 28px;
                            Text {
                                text: cell.text;
                                vertical-alignment: r == 0 ? center : bottom;
                                overflow: elide;
                                font-size: r == 0 ? Size.small : Size.answer;
                                color: cell.tone;
                                accessible-role: none;
                            }
                        }
                        // Room under the last row, above the closing line.
                        Rectangle { height: 8px; }
                    }
                }
                // Lines under the heading and the last row.
                Rectangle {
                    y: 30px;
                    height: 1px;
                    background: Theme.border-weak-base;
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border-weak-base;
                }
            }
        }
        if root.item.shape == Shape.code: Rectangle {
            background: Theme.surface-inset-base;
            border-radius: Size.radius;
            height: code.preferred-height;
            // The language, quietly, in the corner.
            if root.item.note != "": Text {
                x: parent.width - self.width - 12px;
                y: 9px;
                text: root.item.note;
                font-size: Size.small * 0.9;
                color: Theme.text-weaker;
                accessible-role: none;
            }
            code := VerticalLayout {
                padding-top: 9px;
                padding-bottom: 9px;
                padding-left: 12px;
                padding-right: 12px;
                Prose {
                    text: root.item.text;
                    accessible-role: text;
                    accessible-label: root.item.label;
                    default-font-family: Fonts.mono;
                    default-font-size: Size.code;
                }
                // A script cut short shows the rest on asking.
                if root.item.more != "": HorizontalLayout {
                    padding-top: 4px;
                    alignment: start;
                    LinkButton {
                        text: root.item.more;
                        clicked => { Logic.toggle-diff(root.item.key); }
                    }
                }
            }
        }
        if root.item.shape == Shape.quote: HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 3px;
                border-radius: 1.5px;
                background: Theme.border-base;
            }
            Prose {
                text: root.item.text;
                accessible-role: text;
                accessible-label: root.item.label;
            }
        }
        if root.item.shape == Shape.rule: VerticalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            HLine { }
        }
        if root.item.shape == Shape.line: LineRow {
            item: root.item;
        }
        if root.item.shape == Shape.group: GroupRow {
            item: root.item;
        }
        if root.item.shape == Shape.diff: DiffRow {
            item: root.item;
        }
        if root.item.shape == Shape.subagent: SubagentRow {
            item: root.item;
        }
        if root.item.shape == Shape.report: ReportRow {
            item: root.item;
        }
        // Under the tool's name, past its mark.
        if root.item.shape == Shape.pictures: HorizontalLayout {
            padding-left: 22px;
            ThumbStrip {
                pictures: root.item.pictures;
            }
        }
    }
}

/// The timeline, which follows the newest row while it's at the end.
export component Timeline inherits ListView {
    /// Whether the view is at the end, and keeps there as rows grow.
    out property <bool> following: true;
    /// Whether the prompt rail has room beside the column. It needs two
    /// prompts; the column narrows to make room for it, and only on the
    /// number of prompts, never on the rows' heights, so it settles at once.
    out property <bool> railed: State.prompt-marks.length >= 2
        && self.visible-width - 2 * Column.rail >= Column.narrowest;
    /// The column's width, which the header and composer line up with.
    out property <length> column: min(Column.width, self.visible-width - 2 * (root.railed ? Column.rail : Column.margin));
    property <length> left: (self.visible-width - self.column) / 2;
    property <length> end: min(0, self.visible-height - self.content-height);

    /// How far down the view is, from 0 at the top to 1 at the end.
    out property <float> fraction: root.end < 0 ? clamp(self.content-y / root.end, 0, 1) : 1;
    /// The share of the whole that shows, from 0 to 1.
    out property <float> shown: self.content-height > 0 ? min(1, self.visible-height / self.content-height) : 1;
    /// The row being read: as far down the view as the view is down the
    /// whole, so the top row at the top and the last row at the end.
    /// Estimated the way the list places rows: each counts as the average
    /// height.
    out property <float> reading-row: self.content-height > 0
        ? (self.visible-height * root.fraction - self.content-y) / self.content-height * State.timeline.length
        : 0;

    accessible-label: "Timeline";
    // Rows fit the width; the timeline only scrolls up and down. Its scroll
    // bar is drawn beside it (`TimelineScrollbar`), with a thumb that stays
    // long enough to see in a long session.
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    vertical-scrollbar-policy: ScrollBarPolicy.always-off;

    /// The end moved while following: the view catches up on the event
    /// loop's next turn, by calling `catch-up()`.
    ///
    /// Not straight away: rows are made as they scroll into view, and their
    /// heights move the end again. Catching up inside the change handler
    /// chains those rounds within one frame.
    callback end-moved();

    scrolled => {
        root.following = self.content-y <= root.end + 4px;
    }
    // The end, watched only while following. Scrolled away, it stays put,
    // so rows measured while scrolling run no handler here: Slint counts
    // every handler run as a change and lays out once more for it.
    property <length> followed-end: root.following ? root.end : 1px;
    changed followed-end => {
        root.end-moved();
    }

    /// Goes to the end, and follows it from there.
    public function to-end() {
        root.following = true;
        self.content-y = root.end;
    }

    /// Puts the top of `row` at the top of the view, or goes to the end if
    /// the row is in the last screenful.
    ///
    /// From the end, every earlier row lies above the view, so the list
    /// places the row at its top edge once it lays the rows out.
    public function jump-to(row: int) {
        self.content-y = root.end;
        self.ensure-row-visible(row, ScrollBehavior.instant);
        root.following = self.content-y <= root.end + 4px;
    }

    /// Scrolls to `fraction` of the way down, from 0 at the top to 1 at
    /// the end, following the end when there.
    public function scroll-to(fraction: float) {
        self.content-y = root.end * clamp(fraction, 0, 1);
        root.following = fraction >= 1;
    }

    /// Scrolls a page up (`direction` -1) or down (1), keeping a little of
    /// the page before in view.
    public function page(direction: int) {
        self.content-y = clamp(self.content-y - direction * (self.visible-height - 48px), root.end, 0);
        root.following = self.content-y <= root.end + 4px;
    }

    /// Goes to the end again, if still following.
    public function catch-up() {
        if root.following {
            self.content-y = root.end;
        }
    }

    for row in State.timeline: RowView {
        item: row;
        column: root.column;
        left: root.left;
    }
}

/// The timeline's scroll bar. Its thumb never gets shorter than
/// `min-thumb`, so a long session still shows where the view is; it widens
/// under the pointer. Drag the thumb, or press above or below it to page.
export component TimelineScrollbar inherits Rectangle {
    /// How far down the view is, from 0 at the top to 1 at the end.
    in property <float> fraction;
    /// The share of the whole that shows, from 0 to 1.
    in property <float> shown;
    /// Asks to scroll to `fraction` of the way down.
    callback scroll-to(fraction: float);
    /// Asks to go a page up (-1) or down (1).
    callback page(direction: int);

    /// Long enough to find and grab, however long the session.
    property <length> min-thumb: 48px;
    property <length> pad: 6px;
    property <length> track: root.height - 2 * root.pad;
    property <length> thumb-height: min(root.track, max(root.min-thumb, root.track * root.shown));
    property <length> travel: root.track - root.thumb-height;
    property <bool> active: touch.has-hover || touch.pressed;

    width: 16px;

    thumb := Rectangle {
        width: root.active ? 8px : 4px;
        height: root.thumb-height;
        x: root.width - self.width - 4px;
        y: root.pad + root.travel * clamp(root.fraction, 0, 1);
        border-radius: self.width / 2;
        background: Theme.icon-quiet;
        opacity: root.active ? 0.9 : 0.55;

        animate width, opacity { duration: 120ms; easing: ease-out; }
    }

    touch := TouchArea {
        property <float> start-fraction;
        property <length> start-y;
        property <bool> dragging;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.dragging = self.mouse-y >= thumb.y && self.mouse-y <= thumb.y + thumb.height;
                if self.dragging {
                    self.start-fraction = root.fraction;
                    self.start-y = self.mouse-y;
                } else {
                    root.page(self.mouse-y < thumb.y ? -1 : 1);
                }
            }
        }
        moved => {
            if self.dragging && root.travel > 0 {
                root.scroll-to(self.start-fraction + (self.mouse-y - self.start-y) / root.travel);
            }
        }
    }
}

/// A mark beside the timeline for each of the session's prompts: a short
/// line, longer and brighter for the prompt in view. Hovering one shows the
/// prompt's first line; a click jumps to it. When the prompts don't all
/// fit, the marks around the view show.
export component PromptRail inherits Rectangle {
    /// The row the timeline's reader is at.
    in property <float> reading-row;
    /// How far down the timeline is, from 0 at the top to 1 at the end.
    in property <float> fraction;
    /// Asks to jump to the prompt at `row`.
    callback jump(row: int);

    /// The space each mark takes, which is also where it can be pressed.
    property <length> pitch: 12px;
    property <int> count: State.prompt-marks.length;
    property <int> fit: max(1, floor(root.height / root.pitch));
    property <int> shown: min(root.count, root.fit);
    property <int> first: clamp(round(root.fraction * root.count - root.shown / 2), 0, root.count - root.shown);
    property <length> top: (root.height - root.shown * root.pitch) / 2;

    width: 28px;
    accessible-role: navigation;
    accessible-label: "Prompts";

    for mark[i] in State.prompt-marks: mark-box := Rectangle {
        // The last prompt at or above the reader is the one being read.
        property <bool> current: mark.row <= root.reading-row
            && (i == root.count - 1 || State.prompt-marks[i + 1].row > root.reading-row);
        property <bool> hot: touch.has-hover;

        visible: i >= root.first && i < root.first + root.shown;
        x: 0;
        y: root.top + (i - root.first) * root.pitch;
        width: root.width;
        height: root.pitch;
        // Numbered, so it's plain the marks are the session's prompts.
        property <string> named: "Prompt " + (i + 1) + " of " + root.count + ": " + mark.text;
        accessible-role: button;
        accessible-label: self.named;
        accessible-action-default => { root.jump(mark.row); }

        Rectangle {
            width: parent.hot ? 22px : parent.current ? 18px : 12px;
            height: parent.hot || parent.current ? 3px : 2px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: self.height / 2;
            // Full strength: a 2px mark needs all its colour to be seen.
            background: parent.hot ? Theme.text-strong : parent.current ? Theme.accent-ink : Theme.icon-quiet;

            animate width { duration: 120ms; easing: ease-out; }
        }

        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.jump(mark.row); }
        }

        // The prompt's first line, to the left of the mark.
        if touch.has-hover: Rectangle {
            width: min(420px, tip.preferred-width + 20px);
            height: tip.preferred-height + 12px;
            x: -self.width - 4px;
            y: (parent.height - self.height) / 2;
            background: Theme.card;
            backdrop-blur: Theme.card-blur;
            border-radius: Size.radius;
            border-width: 1px;
            border-color: Theme.menu-edge;
            drop-shadow-color: #00000059;
            drop-shadow-offset-y: 4px;
            drop-shadow-blur: 14px;

            tip := Text {
                x: 10px;
                width: parent.width - 20px;
                text: mark-box.named;
                overflow: elide;
                font-size: Size.small;
                color: Theme.text-strong;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
}
