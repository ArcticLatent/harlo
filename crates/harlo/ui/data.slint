// What Rust pushes into the window (`State`), what the window reports back
// (`Logic`), and the window's own requests between its parts (`Requests`).

/// What the center shows.
export enum Content {
    /// A line of quiet text, for a tab with nothing to show yet.
    quiet,
    /// The start screen, for a new session.
    home,
    /// A session.
    session,
    /// The file editor.
    editor,
}

/// A tab: a document in the center, or a terminal.
export struct Tab {
    /// The tab's key, which Rust maps back to what it shows.
    key: int,
    title: string,
    /// The glyph before the title.
    glyph: string,
    /// Whether the glyph is a file-type icon rather than a Lucide one.
    file-icon: bool,
    /// The glyph's colour, for file-type icons.
    glyph-color: color,
    /// Whether it's the tab shown.
    active: bool,
    /// Whether it has a close button.
    closable: bool,
    /// Whether what it shows has unsaved changes.
    modified: bool,
    /// What hovering it says: a file's path, a session's folder.
    tooltip: string,
}

/// What a sidebar row is.
export enum RowKind {
    project,
    session,
    more,
}

/// One row of the sidebar's list.
export struct SidebarRow {
    kind: RowKind,
    /// A session's ID, or a folder for headings and "Show more".
    id: string,
    title: string,
    /// A session's age, or a heading's count.
    detail: string,
    selected: bool,
    busy: bool,
    waiting: bool,
    /// Whether all it waits for are answers, no approvals.
    asking: bool,
    /// Whether the session runs without asking ("Don't ask").
    trusted: bool,
    /// A session's maker logo: 0 none, 1 Anthropic, 2 OpenAI, 3 Z.ai.
    maker: int,
    /// The maker's tone, or a project's colour.
    tone: color,
    /// Whether the title is a placeholder.
    untitled: bool,
    /// Whether space follows, closing a project's group.
    gap: bool,
    /// A session's worktree, when it runs in one rather than the
    /// project's own folder, and the branch checked out there, once known.
    worktree: string,
    branch: string,
    /// For a project: whether it has a colour, `tone`, and its icon image,
    /// if it has one.
    colored: bool,
    picture: image,
}

/// A location in the location picker.
export struct LocationRow {
    label: string,
    detail: string,
    glyph: string,
    current: bool,
}

/// A picker chip: the current choice, which opens the picker's menu.
export struct Chip {
    /// The picker, by number.
    picker: int,
    glyph: string,
    glyph-color: color,
    label: string,
    /// A weaker note after the label.
    note: string,
}

/// A picture's thumbnail.
export struct Thumb {
    /// The picture's key, which the viewer opens it by.
    key: string,
    /// Its place in `State.thumbs`.
    slot: int,
    name: string,
    /// Whether the user sent it; otherwise a tool returned it.
    mine: bool,
}

/// One row of a picker's menu.
export struct MenuItem {
    label: string,
    /// An icon before the label; empty for none.
    glyph: string,
    /// What it does, in a column of its own after the label; empty for none.
    description: string,
    /// A note on the right, such as a model's provider.
    detail: string,
    /// A line under the label saying what the choice means; empty for none.
    below: string,
    dot: color,
    has-dot: bool,
    selected: bool,
}

/// What a timeline row is.
export enum Shape {
    /// Quiet text across the column: loading, or why it failed.
    notice,
    /// Something the user sent.
    prompt,
    /// A paragraph of an answer.
    text,
    /// A list in an answer, its nested lists included.
    list,
    /// A table in an answer.
    table,
    /// A heading in an answer.
    heading,
    /// A code block in an answer.
    code,
    /// A quote in an answer.
    quote,
    /// A rule across an answer.
    rule,
    /// A one-line row: a thought, a tool call, a note, a stop.
    line,
    /// The header of a run of tool calls.
    group,
    /// Lines of a tool's diff, in a sunken box.
    diff,
    /// Work handed to a subagent.
    subagent,
    /// What a subagent reported back.
    report,
    /// The pictures a tool returned, as thumbnails.
    pictures,
    /// Why a tool call failed, under its row.
    reason,
}

/// One item of a list in an answer.
export struct ListEntry {
    /// How deeply it's nested: 0 in the outermost list.
    depth: int,
    /// A bullet, or its number such as `2.`.
    marker: string,
    text: styled-text,
}

/// One cell of a table in an answer, and its colour.
export struct TableCell {
    text: string,
    tone: color,
}

/// One column of a table in an answer: its heading, then its cells.
export struct TableColumn {
    cells: [TableCell],
}

/// One line of a diff.
export struct DiffLine {
    /// Its number: in the new file, or the old one for a removed line.
    number: string,
    /// `+`, `−` or nothing.
    mark: string,
    text: string,
    /// 0 unchanged, 1 added, 2 removed, 3 a gap between hunks.
    kind: int,
    /// The digits of the largest number in its diff, which its number
    /// column fits.
    digits: int,
}

/// One of the session's prompts, on the rail that jumps to it.
export struct PromptMark {
    /// The prompt's row in the timeline.
    row: int,
    /// The prompt's first line.
    text: string,
}

/// One row of a session's timeline.
export struct TimelineRow {
    shape: Shape,
    /// The entry's key, which the row's actions name.
    key: string,
    /// Space above the row.
    gap: length,
    /// Indented, inside an open group of tool calls.
    nested: bool,
    /// A prompt's, an answer block's or a code block's text.
    text: styled-text,
    /// A line's label, a group's summary, a subagent's name, a diff's file.
    /// (For `pictures` rows: the tool that returned them.)
    label: string,
    /// What a line acts on, or a subagent's task.
    detail: string,
    /// Whether the detail is code, such as a command.
    mono: bool,
    /// Words on the right: how long a call took, how a subagent stands.
    note: string,
    note-color: color,
    glyph: string,
    glyph-color: color,
    /// A list's items.
    items: [ListEntry],
    /// A table's columns.
    columns: [TableColumn],
    /// The agent whose turn starts at this row, named before it; empty for
    /// none.
    turn: string,
    turn-color: color,
    /// Whether it's working, and breathes.
    working: bool,
    /// A heading's level, from 1.
    level: int,
    /// Whether a group's calls show below it.
    open: bool,
    /// Whether a prompt can be undone (offered under the pointer), and
    /// whether it's still on its way.
    undo: bool,
    sending: bool,
    /// Whether it's a prompt that just arrived, which fades in.
    fresh: bool,
    /// A tool's or a file's added and removed lines.
    added: int,
    removed: int,
    counts: bool,
    /// A prompt's attachments and skills.
    chips: [Chip],
    /// A prompt's pictures, or the pictures a tool returned.
    pictures: [Thumb],
    /// A subagent's child session, to open.
    child: string,
    /// The words of a line's button, such as "Continue" after a stop;
    /// empty for none.
    action: string,
    /// Which of a tool's files a diff shows.
    file: int,
    lines: [DiffLine],
    /// The note under a cut-short diff, such as "… 12 more lines".
    more: string,
    /// Whether a diff box starts or ends on this row.
    top: bool,
    bottom: bool,
}

/// A line above the session's composer: what the agent does, its todos, a
/// subagent at work, or a queued prompt.
export struct InboxRow {
    /// 0 activity, 1 todos, 2 a subagent, 3 a queued prompt, 4 the
    /// session's goal, 5 a background job.
    kind: int,
    /// The queued prompt's or the subagent session's ID; for the goal,
    /// the `/goal` word its action sends.
    id: string,
    glyph: string,
    glyph-color: color,
    /// Strong words first, such as a subagent's name or "3 of 5".
    strong: string,
    text: string,
    /// Weak words after, such as a command.
    detail: string,
    /// Words on the right, such as "Working" or "Sends before your next message".
    note: string,
    note-color: color,
    /// Whether it breathes.
    working: bool,
    /// The action button's words, such as "Steer"; empty for none.
    action: string,
    /// Whether it can be cancelled.
    cancel: bool,
    /// Todos done and in all, for the bar.
    done: int,
    total: int,
}

/// What Rust shows.
/// A file's patch on a card: its name and counts, its first lines, how
/// many more there are, and a warning under it.
export struct CardFile {
    name: string,
    added: int,
    removed: int,
    lines: [DiffLine],
    /// "… 12 more lines", or empty.
    more: string,
    warning: string,
}

/// A staged undo to keep or cancel.
export struct UndoCard {
    shown: bool,
    session: string,
    title: string,
    /// The prompt being undone, in quotes; empty when it isn't known.
    quote: string,
    note: string,
    files: [CardFile],
    /// Whether the user's own edits couldn't be told from the agent's.
    unchecked: bool,
    busy: bool,
}

/// An action the agent asks to take.
export struct ApprovalCard {
    shown: bool,
    id: string,
    title: string,
    /// How many approvals wait, this one included.
    count: int,
    /// The command or paths, when no files are shown.
    detail: string,
    /// Whether `detail` is a command to run.
    command: bool,
    files: [CardFile],
    message: string,
    /// The "Always allow" button's label.
    always: string,
    /// What "Always allow" covers, in words, and where to take it back.
    always-note: string,
    busy: bool,
    /// Whether a reason for refusing is being typed.
    refusing: bool,
    reason: string,
    reason-hint: string,
}

/// An option of a question.
export struct Choice {
    label: string,
    description: string,
    value: string,
    chosen: bool,
}

/// What kind of answer a question takes.
export enum Answer { one, many, number, yes-no, link }

/// One of the agent's questions.
export struct Question {
    form: string,
    key: string,
    title: string,
    description: string,
    answer: Answer,
    choices: [Choice],
    /// Whether it takes typed text too, and what the field says while empty.
    input: bool,
    hint: string,
    typed: string,
    /// A yes-or-no answer: -1 none yet, 0 no, 1 yes.
    flag: int,
    url: string,
    /// What's wrong with the answer, one per line.
    problems: string,
}

/// The agent's questions; the questions themselves are `State.questions`.
export struct QuestionCard {
    shown: bool,
    id: string,
    title: string,
    count: int,
    busy: bool,
}

/// A label and its value, in a panel.
export struct Fact {
    label: string,
    value: string,
    /// 0 for words, 1 for a number, set in the code font, 2 for an agent.
    kind: int,
}

/// An instruction file in the Context panel, and where it applies.
export struct InstructionFile {
    path: string,
    aside: string,
}

/// The Context panel's words and numbers; its lists are `State.context-facts`
/// and `State.context-files`.
export struct ContextCard {
    /// Shown alone, when no session is open.
    note: string,
    /// Why loading failed.
    error: string,
    /// What the window section says instead of a count.
    window-note: string,
    /// The tokens in the window, short, and what they're out of.
    used: string,
    of: string,
    /// Whether the model's window size is known, so the bar shows.
    bar: bool,
    /// How full the bar is, from 0 to 1, and whether that's nearly full.
    fill: float,
    warn: bool,
    percent: string,
    messages: string,
    /// What the instructions section says instead of files, or after them.
    files-note: string,
}

/// One of the agent's todos: what it is, and where it stands (0 not
/// started, 1 being worked on, 2 done, 3 dropped).
export struct TodoRow {
    text: string,
    status: int,
}

/// One of the Subagents panel's rows: a subagent's session.
export struct SubagentRow {
    id: string,
    /// Its agent's name, drawn in `tone`.
    agent: string,
    title: string,
    tone: color,
    selected: bool,
    busy: bool,
    waiting: bool,
    /// Whether all it waits for are answers, no approvals.
    asking: bool,
    /// How long ago it last changed.
    detail: string,
}

/// A side question asked with `/btw`, and its answer.
export struct AsideRow {
    question: string,
    /// The answer, Markdown drawn; empty while waiting or after a failure.
    answer: styled-text,
    waiting: bool,
    /// Why there's no answer, when it failed.
    failed: string,
}

/// One row of the Changes panel's list: a section's title, a note, a file,
/// or a line of a file's open diff. Rust gives each its height, so it knows
/// where every row sits.
export struct ChangeRow {
    /// 0 a title, 1 the turn's question, 2 a note, 3 a failure, 4 a file,
    /// 5 a diff line, 6 "N more lines", 7 the space between hunks, 8 a
    /// comment on the line above, 9 the field for one.
    kind: int,
    height: length,
    /// Space above, inside the height.
    gap: length,
    /// The file's key, which its actions name.
    key: string,
    /// A title, a note, a file's name, or what "more" says.
    text: string,
    /// Beside a title: its count or the branch. Beside a file: its folder.
    aside: string,
    /// Whether the aside is a branch, with its icon.
    branch: bool,
    /// Whether the title ends the review it names.
    closes: bool,
    /// A file's icon, from the file-icon font; it's drawn in the quiet tone.
    icon: string,
    added: int,
    removed: int,
    /// Whether the counts show (not for a deleted file).
    counts: bool,
    /// Whether a file's diff is open under it; whether it shows a chevron
    /// for that.
    open: bool,
    chevron: bool,
    /// Whether it's the selected file, or a line of the lit hunk.
    selected: bool,
    /// Whether it does anything when clicked.
    clickable: bool,
    /// A diff line, and its hunk's place in the file.
    line: DiffLine,
    hunk: int,
    /// A diff line's place in its file's diff, which commenting on it
    /// names; a comment's place in the list of comments.
    at: int,
}

/// The Changes panel's foot: committing and pushing, and how the last git
/// action went.
export struct ChangesFoot {
    /// A commit can be written: there's something to commit, here, in Git.
    commit: bool,
    /// The message is written and nothing's running.
    ready: bool,
    committing: bool,
    /// ✦ can write the message: nothing's running or being written.
    can-write: bool,
    /// The message is being written.
    writing: bool,
    /// "2 comments" on diff lines waiting to be sent; empty with none.
    comments: string,
    /// The comments can be sent: nothing else is being sent.
    can-send: bool,
    /// What sending them takes along, such as the composer's text.
    send-note: string,
    /// "Push 2 commits" or "Pushing…"; empty with nothing to push.
    push: string,
    can-push: bool,
    /// "to origin/main", and "(3 behind)".
    upstream: string,
    behind: string,
    /// Why nothing can be committed here.
    note: string,
    /// What the last git action did, or why it failed.
    outcome: string,
    failed: bool,
}

/// A file or folder in the Files panel's tree.
export struct FileRow {
    /// Its path in the folder, which its actions name.
    path: string,
    name: string,
    /// How many folders it's inside.
    depth: int,
    directory: bool,
    /// For a folder: whether it's open, and its list still on the way.
    open: bool,
    loading: bool,
    /// Whether Git ignores it.
    ignored: bool,
    /// Whether it's the file in the editor.
    selected: bool,
    /// A file's icon, from the file-icon font; it's drawn in the quiet tone.
    icon: string,
}

/// The file in the editor: its path, what shows, how saving stands, and
/// any question to answer.
export struct EditorCard {
    path: string,
    /// 0 a note, 1 the text, 2 a picture.
    body: int,
    /// Why the file doesn't show, or that it's opening.
    note: string,
    /// "Saving…", "Unsaved changes" or why saving failed.
    status: string,
    failed: bool,
    /// Whether it's text, which can be saved, and whether Save does anything.
    text: bool,
    can-save: bool,
    /// The question before closing, if one's asked.
    closing: string,
    /// 0 nothing, 1 it changed on disk under unsaved changes, 2 it was deleted.
    outside: int,
}

/// The Todos panel's words; its items are `State.todo-rows`.
export struct TodosCard {
    /// Shown alone, when there's no list.
    note: string,
    /// Whether the folder's agents lack the todo tool, and the setting that
    /// gives it to them.
    off: bool,
    setting: string,
    /// "2 of 5 done", and the counts for the bar.
    progress: string,
    done: int,
    total: int,
}

/// Text in one style in a terminal line, from a column on.
export struct TermRun {
    column: int,
    cells: int,
    text: string,
    color: color,
    background: color,
    filled: bool,
    bold: bool,
    italic: bool,
    underline: bool,
    strike: bool,
}

/// A terminal line: its runs, left to right.
export struct TermLine {
    runs: [TermRun],
}

/// The terminal's cursor. Shape 0 is a block, 1 an underline, 2 a beam and
/// 3 a hollow block.
export struct TermCursor {
    shown: bool,
    line: int,
    column: int,
    shape: int,
    text: string,
}

/// A file or image attached to the message being written; a new one
/// fades in.
export struct AttachedChip {
    label: string,
    glyph: string,
    fresh: bool,
    /// A pasted picture's thumbnail; -1 for none.
    thumb: Thumb,
}

/// A row on a page over the window: 0 a heading, 1 a name and its value,
/// 2 a note. Tone 1 is good, 2 bad, 3 quiet and 4 waiting.
export struct SheetRow {
    kind: int,
    name: string,
    value: string,
    tone: int,
    /// The kind: 0 a heading, 1 a name and value, 2 a note, 3 a switch, 4
    /// a choice among `options`, the one chosen numbered by `setting` and
    /// the choice by `choice`, with `value` as a line under its name (8
    /// shows the options as colour swatches), 5
    /// theme cards, dark ones for `setting` 0 and light ones for 1, 6 a
    /// text field holding `value` as field `setting`, which its `action`
    /// button takes (see `saves` for one without), or 7 the command `value`, run by its `action` button as
    /// step `setting`, or 9 a project, opened by step `setting`, or 10 the
    /// picture `picture` on white, such as a QR code, named by `name`, or
    /// 11 a shortcut: what it does as `value`, its keys as keycaps in
    /// `options`, and the keys as written in `name`.
    /// A value's tone: 0 plain, 1 good, 2 bad, 3 quiet, 4 a warning, 5 the accent.
    /// For a switch (kind 3): whether it's on, and the setting it turns.
    /// For a name and value (kind 1) with a button: the button's label,
    /// and `setting` numbers its step.
    on: bool,
    setting: int,
    action: string,
    options: [string],
    choice: int,
    /// For a text field (kind 6): what it shows while empty. For a row with
    /// a line under its name and a button (kind 13): a tag after the name,
    /// such as "Recommended"; that row's icon tile shows only with a glyph.
    hint: string,
    /// For swatches (kind 8): each option's colour; the first, none.
    colors: [color],
    /// For a project (kind 9): its colour, when `on`, and its icon image,
    /// if it has one; `setting` and `choice` number the step that opens it.
    /// For a text field (kind 6), `on` hides what's typed.
    color: color,
    picture: image,
    /// For a name and value with a button (kind 1): text the button copies
    /// before its step.
    copy: string,
    /// For a row that opens a page (kind 9): an icon glyph shown in place
    /// of a project's mark. A text field (kind 6) with no `action` saves
    /// each edit as it's typed.
    glyph: string,
    /// For a text field (kind 6): what screen readers call it, where its
    /// name alone doesn't say, as for one of several "Title" fields.
    label: string,
    /// For a name and value (kind 1): whether the name, or the value, is
    /// code, such as a model's id or a version, set in the code font.
    mono-name: bool,
    mono-value: bool,
    /// For a row with a button: whether the button deletes something, and
    /// is drawn in the danger colours.
    risky: bool,
    /// Where it sits in its group's card: 0 outside any card (a heading
    /// and the line under it), 1 alone in one, 2 at the top, 3 between
    /// others, 4 at the bottom.
    place: int,
    /// For a text field (kind 6) with no `action`: saved when Enter is
    /// pressed or the field is left, rather than as it's typed.
    saves: bool,
}

/// A theme in Settings → Appearance: its id and name, whether it's the one
/// chosen, and the colours its card previews, in the variant shown.
export struct ThemeCard {
    id: string,
    name: string,
    chosen: bool,
    background: color,
    sidebar: color,
    raised: color,
    text: color,
    weak: color,
    brand: color,
    keyword: color,
    function: color,
    text-string: color,
}

/// A section in Settings' list: its title, the group it's listed under
/// (empty for none) and its icon.
export struct SettingsSection {
    title: string,
    group: string,
    glyph: string,
}

/// A number on the stats page and what it counts.
export struct StatTile {
    value: string,
    label: string,
}

/// A day's bar on the stats page, as a share of the busiest day; slot 29
/// is the range's last day, 0 the day 29 days before it.
export struct DayBar {
    label: string,
    slot: int,
    share: float,
}

export global State {
    // The shell.
    in property <bool> sidebar-shown: true;
    in property <length> sidebar-width: 288px;
    in property <[bool]> panels-shown: [false, false, false, false, false, false, false];
    /// The tool panel on screen, by number, or -1; with `maximized` it
    /// covers the space between the rails.
    in property <int> panel: -1;
    in property <bool> maximized;
    in property <length> panel-width: 360px;
    in property <string> panel-title;
    in property <bool> panel-refresh;
    /// The center's tabs, what it shows, and its quiet text.
    in property <[Tab]> documents;
    in property <Content> content: Content.home;
    in property <string> quiet;
    /// The terminals under the center.
    in property <bool> terminals-shown;
    in property <length> terminal-height: 260px;
    in property <[Tab]> terminals;
    /// The shown terminal's visible lines, cursor and colours, and whether
    /// it's scrolled back from its newest output.
    in property <[TermLine]> term-lines;
    in property <TermCursor> term-cursor;
    in property <color> term-background;
    in property <color> term-foreground;
    in property <color> term-cursor-color;
    in property <bool> term-scrolled;
    /// The page over the window: 0 none, 1 stats, 2 settings, 3 the setup
    /// guide; its title, rows (see `SheetRow`) and a note on how its
    /// loading stands, or what the guide's step is for.
    in property <int> sheet;
    in property <string> sheet-title;
    /// Which page Settings shows, as a key that changes with it: a new
    /// page starts at its top.
    in property <string> sheet-page;
    in property <[SheetRow]> sheet-rows;
    in property <string> sheet-note;
    /// The stats' numbers, day bars and range: 0 a week, 1 a month, 2 all.
    in property <[StatTile]> stat-tiles;
    in property <[DayBar]> stat-days;
    /// The chart's top, its busiest day's steps, and its left end, in words.
    in property <string> stat-peak;
    in property <string> stat-from;
    in property <int> stat-range: 1;
    in property <string> harlo-version;
    /// Settings' sections, the one shown by its place, and what Settings
    /// is searched for.
    in property <[SettingsSection]> settings-sections;
    /// Which of them is Shortcuts, which the rail's keyboard button opens.
    in property <int> shortcuts-section;
    /// Which of them is Phone, which the rail's phone button opens.
    in property <int> phone-section;
    /// Whether a phone is paired, so the rail's phone button pauses its
    /// notifications rather than opening Settings → Phone.
    in property <bool> phone-paired;
    /// Whether notifications to phones are held back.
    in property <bool> phone-paused;
    /// The dark and the light themes Settings → Appearance lists, or those
    /// a search found.
    in property <[ThemeCard]> dark-theme-cards;
    in property <[ThemeCard]> light-theme-cards;
    in property <int> settings-section;
    in-out property <string> settings-query;
    /// The setup guide's steps' titles, and the one shown by its place.
    in property <[string]> setup-steps;
    in property <int> setup-step;

    // The tool panels.
    in property <ContextCard> context-card;
    in property <[Fact]> context-facts;
    in property <[InstructionFile]> context-files;
    in property <TodosCard> todos-card;
    in property <[TodoRow]> todo-rows;
    /// The Subagents panel's rows, and its words when it has none.
    in property <[SubagentRow]> subagent-rows;
    in property <string> subagents-note;
    /// How many of the open session's subagents work or wait, counted on
    /// the panel's rail button.
    in property <int> subagents-working;
    /// The Side questions panel's rows, and its words when it has none.
    in property <[AsideRow]> aside-rows;
    in property <string> asides-note;
    /// How many of the open session's side questions wait for an answer,
    /// counted on the panel's rail button.
    in property <int> asides-waiting;
    /// The Changes panel: a note instead of its lists while loading, the
    /// lists, the selected file's path and diff (maximized), its foot, the
    /// commit message, and where the selected rows sit in each list.
    /// The Files panel: the folder's name, a note instead of its tree, and
    /// the tree's rows.
    in property <string> files-folder;
    in property <string> files-note;
    in property <[FileRow]> file-rows;
    /// The editor: its file, its text with the cursor and selection (by
    /// byte), which the field reloads when the revision moves, the text
    /// coloured, the line numbers, and a picture.
    in property <EditorCard> editor-card;
    in property <string> editor-text;
    in property <int> editor-cursor;
    in property <int> editor-anchor;
    in property <int> editor-revision;
    in property <styled-text> editor-colored;
    in property <string> editor-numbers;
    in property <image> editor-picture;
    /// The Notes panel: the folder's name, whether the note is read yet,
    /// its text with the cursor and selection (by byte), which the field
    /// reloads when the revision moves, the todo count and an error.
    in property <string> notes-folder;
    in property <bool> notes-loaded;
    in property <string> notes-text;
    in property <int> notes-cursor;
    in property <int> notes-anchor;
    in property <int> notes-revision;
    in property <bool> notes-has-text;
    in property <string> notes-todos;
    in property <string> notes-error;
    in property <string> changes-note;
    in property <[ChangeRow]> change-rows;
    in property <string> change-path;
    in property <[ChangeRow]> change-diff;
    in property <ChangesFoot> changes-foot;
    in property <string> commit-message;
    in property <length> change-rows-y;
    in property <length> change-diff-y;

    // The sidebar.
    in property <string> location-label;
    in property <string> location-glyph;
    in property <color> status-color;
    in property <string> status-text;
    in property <bool> picking-location;
    in property <[LocationRow]> locations;
    in property <[SidebarRow]> sidebar-rows;
    /// What the list says when it has nothing to show.
    in property <string> sidebar-notice;

    // The start screen and composer.
    in property <bool> starting;
    in property <string> home-hint;
    in property <string> composer-text;
    /// Moves when Rust changes the composer's text; typing doesn't move it.
    in property <int> composer-revision;
    in property <int> composer-cursor;
    in property <int> composer-anchor;
    /// The `/` or `@` menu over the composer: what it offers, and the
    /// highlighted row.
    in property <[MenuItem]> composer-menu;
    in property <int> composer-menu-highlight;
    in property <string> send-error;
    in property <bool> sending;
    /// The files and images attached to the message, and whether a pasted
    /// image is still being read.
    in property <[AttachedChip]> attached;
    in property <bool> pasting;
    in property <bool> can-send;
    /// Dictation: 0 off (no speech model yet), 1 ready, 2 recording,
    /// 3 turning the recording into text.
    in property <int> voice;
    /// What dictation is doing, or why it failed; empty otherwise.
    in property <string> voice-note;
    in property <Chip> folder-chip;
    in property <[Chip]> chips;
    in property <string> shield-glyph;
    in property <color> shield-color;
    /// The permissions mode's short name, when it isn't the agent's own.
    in property <string> shield-label;

    // The open session.
    in property <string> session-id;
    in property <string> session-title;
    /// The subagent's parent, for its link back; empty for a session of its own.
    in property <string> session-parent;
    in property <string> session-parent-id;
    /// The user's avatar, as its place in `Avatars.pictures`.
    in property <int> avatar;
    /// Pictures' thumbnails; rows name theirs by place.
    in property <[image]> thumbs;
    /// The open session's pictures, in the order they were sent.
    in property <[Thumb]> session-pictures;
    in property <int> pictures-count;
    /// Whether they show in a grid over the session.
    in property <bool> pictures-grid;
    /// The picture viewer over the session: whether it's open, the picture
    /// and its size (0 while it decodes), its name, who sent it, and a note
    /// when it can't be shown.
    in property <bool> viewer-open;
    in property <image> viewer-image;
    in property <int> viewer-width;
    in property <int> viewer-height;
    in property <string> viewer-name;
    in property <string> viewer-from;
    in property <string> viewer-note;
    in property <string> session-agent;
    in property <string> session-agent-glyph;
    in property <color> session-agent-color;
    in property <bool> session-read-only;
    /// Whether the open session runs without asking ("Don't ask").
    in property <bool> session-trusted;
    in property <string> session-model;
    /// The worktree the open session runs in, by name; empty in a
    /// project's own folder.
    in property <string> session-worktree;
    /// The branch checked out in the session's worktree, once known.
    in property <string> session-branch;
    in property <bool> session-busy;
    in property <string> session-placeholder;
    in property <[TimelineRow]> timeline;
    in property <[PromptMark]> prompt-marks;
    in property <[InboxRow]> inbox;
    // What the open session waits on.
    in property <UndoCard> undo-card;
    in property <ApprovalCard> approval-card;
    in property <QuestionCard> question-card;
    in property <[Question]> questions;

    // The open picker's menu.
    in property <int> picker: -1;
    in property <[MenuItem]> menu-items;
    in property <int> menu-highlight;
    in property <string> menu-note;
    in property <string> menu-filter;
}

/// What the window reports to Rust.
export global Logic {
    callback resized(length, length);
    /// A key press; returns whether it was a shortcut.
    callback key(string, bool, bool, bool) -> bool;

    callback toggle-sidebar();
    /// Hold notifications to phones back, or let them go again.
    callback toggle-phone-pause();
    /// Use the avatar at this place in the picker as the user's picture.
    callback pick-avatar(int);
    /// Show the picture with this key in the viewer.
    callback view-picture(string);
    /// Close the viewer, or the pictures' grid.
    callback close-pictures();
    /// Show the session's pictures in a grid, or hide them.
    callback toggle-pictures();
    /// Show the viewer's picture in its folder.
    callback show-picture-in-folder();
    /// Turn the viewer's picture a quarter turn, clockwise or not.
    callback turn-picture(bool);
    /// Ask the open session's side question at this place again.
    callback retry-aside(int);
    callback toggle-panel(int);
    callback toggle-terminal();
    callback new-terminal();
    /// Remove an attachment from the message by its place.
    callback detach(int);
    /// Open a page over the window by its number, or close it if open.
    callback toggle-sheet(int);
    callback close-sheet();
    /// Open Settings at a section by its place, or close it if it's there.
    callback open-section(int);
    /// Show another section of Settings by its place.
    callback pick-section(int);
    /// Search Settings for this text.
    callback settings-search(string);
    /// Turn a setting, by its number, on or off.
    callback switch-setting(int);
    /// Take a step a row's button offers, by its number, for the row's
    /// item (its `choice`), such as which worktree to remove.
    callback settings-action(int, int);
    /// Save a row's text field, by its number.
    callback settings-text(int, string);
    /// Show the setup guide's step by its place, the next one (finishing
    /// after the last), or the one before.
    callback setup-step(int);
    callback setup-next();
    callback setup-back();
    /// Use the theme with this id.
    callback pick-theme(string);
    /// Show the theme's variant: 0 as the desktop is, 1 light, 2 dark.
    /// Takes option `option` of choice `choice` in Settings.
    callback choose(choice: int, option: int);
    /// The desktop's colour scheme changed: dark, or not.
    callback system-dark(bool);
    /// Show the stats for a range by its number.
    callback stats-range(int);
    /// A key pressed in the shown terminal, with Control, Alt and Shift;
    /// true when the terminal took it.
    callback terminal-key(string, bool, bool, bool) -> bool;
    /// Text pasted into the shown terminal.
    callback terminal-paste(string);
    /// The shown terminal's selected text, to copy.
    pure callback terminal-selection() -> string;
    /// The terminals have room for this many columns and lines.
    callback terminal-resized(int, int);
    /// The wheel turned over the shown terminal, by lines; up is positive.
    callback terminal-scroll(int);
    /// A press at a visible line and fractional column, by word when
    /// double; then a drag to another.
    callback terminal-select-from(int, float, bool);
    callback terminal-select-to(int, float);
    callback maximize(int);
    callback restore();
    callback close-panel();
    /// The Changes panel: a file's diff opened or closed, a file selected,
    /// a diff shown whole, a hunk lit, the review ended, the commit message
    /// edited, commit and push.
    /// The Notes panel: the note edited, the todo on the cursor's line
    /// ticked, a todo added, the note put into the message.
    callback notes-edited(string, int, int);
    callback toggle-todo();
    callback add-todo();
    callback insert-note();
    /// The Files panel: a folder opened or closed, a file opened, by path.
    callback file-toggle(string);
    callback file-open(string);
    /// The editor: its text edited, Save, and the answers to its questions.
    callback editor-edited(string, int, int);
    callback file-save();
    callback file-save-and-close();
    callback file-discard();
    callback file-keep-open();
    callback file-reload();
    callback file-keep-mine();
    callback change-toggle(string);
    callback change-select(string);
    callback change-whole(string);
    callback change-hunk(int);
    /// How many characters of code fit on a line of the panel's diffs, or of
    /// the maximized panel's diff when the first is true.
    callback diff-columns(bool, int);
    callback end-review();
    callback commit-message-edited(string);
    callback commit();
    /// ✦: have the commit-message model write the message.
    callback write-commit-message();
    /// Comments on diff lines: open the field under a line (the file's key
    /// and the line's place), add, cancel, remove one, send all, drop all.
    callback change-comment(string, int);
    callback change-comment-add(string);
    callback change-comment-cancel();
    callback change-comment-remove(int);
    callback change-comments-send();
    callback change-comments-discard();
    callback push();
    callback refresh(int);

    callback toggle-locations();
    callback pick-location(int);
    callback add-project();
    callback new-session(string);
    /// Open a project's settings, by its folder.
    callback project-settings(string);
    callback filter-edited(string);
    callback toggle-more(string);
    callback open-session(string);

    /// A center tab, by key, was clicked or closed.
    callback tab-selected(int);
    callback tab-closed(int);
    /// A terminal tab, by number, was clicked or closed.
    callback terminal-selected(int);
    callback terminal-closed(int);
    /// An edge (0 the sidebar's, 1 the right panel's, 2 the terminals') was
    /// dragged this far right or down; then let go.
    callback resize(int, length);
    callback resize-done();

    /// The composer's text changed or its cursor moved: the text, and the
    /// cursor's and the selection anchor's byte offsets.
    callback composer-edited(string, int, int);
    /// A key press in the composer; returns whether it was taken.
    callback composer-key(string, bool, bool, bool) -> bool;
    /// Row `index` of the `/` or `@` menu was clicked.
    callback composer-menu-pick(int);
    callback send();
    callback attach();
    /// Starts dictation, or stops it and puts the words in.
    callback dictate();
    callback stop();

    callback open-panel(int);
    callback toggle-group(string);
    callback toggle-diff(string);
    callback undo(string);
    /// Asks the open session's agent to go on after a stop.
    callback continue-run();
    callback review(string, int);
    callback link(string);
    callback steer-queued(string);
    callback cancel-queued(string);
    /// Pause, resume or clear the open session's goal, by the `/goal`
    /// word.
    callback goal-command(string);
    /// Stop a background job, named by its ID or, for a subagent, by its
    /// child session's.
    callback stop-job(string);
    /// Start a new session with the history before the prompt with this
    /// key, that prompt in its composer.
    callback fork-from(string);

    callback undo-keep(string);
    callback undo-cancel(string);
    /// An approval's answer: 0 allow once, 1 allow always, 2 deny.
    callback approve(string, int);
    callback refuse(string);
    callback refuse-reason(string);
    callback refuse-send();
    callback refuse-cancel();
    /// A question's form, field and option.
    callback form-choose(string, string, string);
    callback form-type(string, string, string);
    callback form-flag(string, string, bool);
    callback form-send(string);
    callback form-dismiss(string);

    callback toggle-picker(int);
    callback close-picker();
    callback pick(int);
    callback menu-filter-edited(string);
    callback menu-action();
}

/// Requests from Rust to one part of the window: focus a field, scroll a
/// list. A request names its target and moves `serial`, so asking twice in
/// a row works.
/// The name shown beside a rail button that the pointer rests on, drawn over
/// the whole window.
export global Tips {
    /// What it says; empty when none shows.
    in-out property <string> text;
    /// The keys that do the same, such as "Ctrl+,"; empty for none.
    in-out property <string> keys;
    /// The point it hangs from: the button's edge, halfway down.
    in-out property <length> x;
    in-out property <length> y;
    /// Whether it opens to the left of the point, from the right rail.
    in-out property <bool> leftward;
    /// Whether it opens above or below the point, centred on it, for a
    /// button in a row; the point is then the button's top or bottom edge.
    in-out property <bool> above;
    in-out property <bool> below;
}

/// Where the keyboard is, as the window's own elements report it.
export global Keyboard {
    /// Whether the shown terminal has the keyboard.
    in-out property <bool> in-terminal;
}

export global Requests {
    in property <string> focus;
    in property <int> focus-serial;
    in property <string> scroll;
    in property <length> scroll-y;
    in property <int> scroll-serial;
    /// Where the open picker's chip is in the window, which the menu hangs from.
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-height;
}
