// The Changes panel: the reviewed turn's changes, the open session's, then
// the folder's uncommitted ones, with a commit message, Commit and Push.
//
// On the right, a file opens its diff under it. Maximized, the lists sit on
// the left and the selected file's diff fills the right, its lit hunk marked.

import { ListView } from "std-widgets.slint";
import { Theme, Size, Fonts } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Logic, Requests, ChangeRow } from "data.slint";
import { Icon, FileIcon, Press, IconButton, Field, HLine, VLine, QuietBar } from "widgets.slint";
import { Counts, PatchLine, LinkButton } from "timeline.slint";
import { CardButton } from "waiting.slint";

/// The space at the lists' sides.
global Sides {
    out property <length> padding: 18px;
}

/// A section's title, with its count or branch, or a close button.
component TitleRow inherits VerticalLayout {
    in property <ChangeRow> entry;
    /// A section after the first is set apart by a line.
    property <bool> ruled: root.entry.gap > 16px;

    padding-top: root.ruled ? root.entry.gap / 2 : root.entry.gap;
    spacing: root.ruled ? root.entry.gap / 2 - 1px : 0px;
    if root.ruled: Rectangle {
        height: 1px;
        background: Theme.border-weak-base;
    }
    HorizontalLayout {
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.entry.text;
            vertical-alignment: center;
            font-size: Size.label;
            font-weight: 500;
            color: Theme.text-strong;
        }
        if root.entry.branch: Icon {
            text: Icons.git-branch;
            font-size: 12px;
            color: Theme.icon-quiet;
        }
        if root.entry.aside != "": Text {
            text: root.entry.aside;
            vertical-alignment: center;
            font-size: Size.small;
            color: Theme.text-weak;
        }
        if root.entry.closes: VerticalLayout {
            alignment: center;
            IconButton {
                width: 20px;
                height: 20px;
                label: "End review";
                glyph: Icons.close;
                glyph-size: 12px;
                glyph-color: Theme.icon-quiet;
                clicked => { Logic.end-review(); }
            }
        }
    }
}

/// A file: its name whole, its folder shortened, and its counts.
component FileRow inherits Press {
    in property <ChangeRow> entry;

    label: root.entry.aside == "" ? root.entry.text : root.entry.aside + "/" + root.entry.text;
    selected: root.entry.selected;
    enabled: root.entry.clickable;
    // Disabled rows still read as files, not greyed out.
    accessible-enabled: true;
    clicked => {
        if root.entry.chevron {
            Logic.change-toggle(root.entry.key);
        } else {
            Logic.change-select(root.entry.key);
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;
        if root.entry.chevron: Icon {
            width: 14px;
            text: root.entry.open ? Icons.chevron-down : Icons.chevron-right;
            font-size: 13px;
            color: root.entry.clickable ? Theme.icon-quiet : transparent;
        }
        if root.entry.icon != "": FileIcon {
            text: root.entry.icon;
            color: root.entry.icon-color;
            font-size: 13px;
        }
        if root.entry.icon == "": Icon {
            text: Icons.file;
            font-size: 13px;
            color: Theme.icon-quiet;
        }
        Text {
            text: root.entry.text;
            vertical-alignment: center;
            font-family: Fonts.mono;
            font-size: Size.code;
            color: Theme.text-strong;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0;
            text: root.entry.aside;
            vertical-alignment: center;
            overflow: elide;
            font-size: Size.small;
            color: Theme.text-weak;
        }
        if root.entry.counts: Counts {
            added: root.entry.added;
            removed: root.entry.removed;
        }
    }
}

/// A line of a diff: in the side list, indented under its file; in the
/// maximized diff, marked when its hunk is lit.
component LineRow inherits Rectangle {
    in property <ChangeRow> entry;
    in property <bool> marks;

    PatchLine {
        x: root.marks ? 3px : 0;
        width: parent.width - self.x;
        line: root.entry.line;
    }
    if root.marks && root.entry.selected: Rectangle {
        x: 0;
        width: 3px;
        background: Theme.text-interactive-base;
    }
    if root.marks: TouchArea {
        clicked => { Logic.change-hunk(root.entry.hunk); }
    }
    // The number opens the comment field under the line.
    if root.entry.clickable: number := TouchArea {
        x: root.marks ? 3px : 0;
        width: 40px;
        mouse-cursor: MouseCursor.pointer;
        accessible-role: button;
        accessible-label: "Comment on line " + root.entry.line.number;
        accessible-action-default => { Logic.change-comment(root.entry.key, root.entry.at); }
        clicked => { Logic.change-comment(root.entry.key, root.entry.at); }

        if number.has-hover: Rectangle {
            x: 6px;
            y: 1px;
            width: parent.width - 8px;
            height: parent.height - 2px;
            border-radius: 3px;
            background: Theme.surface-interactive-base;
            Icon {
                text: Icons.message-square-plus;
                font-size: 12px;
                color: Theme.text-on-interactive-base;
            }
        }
    }
}

/// A comment under the line it's on, with a button that removes it.
component CommentRow inherits Rectangle {
    in property <ChangeRow> entry;

    background: Theme.surface-inset-base;
    HorizontalLayout {
        padding-left: 46px;
        padding-right: 6px;
        padding-top: 2px;
        padding-bottom: 2px;
        Rectangle {
            border-radius: 4px;
            background: Theme.surface-raised-base;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 2px;
                spacing: 6px;
                Icon {
                    text: Icons.message-square;
                    font-size: 12px;
                    color: Theme.text-interactive-base;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.entry.text;
                    vertical-alignment: center;
                    overflow: elide;
                    font-size: Size.small;
                    color: Theme.text-strong;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        width: 20px;
                        height: 20px;
                        label: "Remove the comment";
                        glyph: Icons.close;
                        glyph-size: 11px;
                        glyph-color: Theme.icon-quiet;
                        clicked => { Logic.change-comment-remove(root.entry.at); }
                    }
                }
            }
        }
    }
}

/// The field for a comment on the line above: Enter or Add adds it.
component CommentField inherits Rectangle {
    background: Theme.surface-inset-base;
    HorizontalLayout {
        padding-left: 46px;
        padding-right: 6px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 6px;
        field := Field {
            horizontal-stretch: 1;
            min-height: 30px;
            placeholder: "Comment on this line";
            text-size: Size.small;
            init => { self.focus(); }
            accepted => { Logic.change-comment-add(self.text); }
        }
        CardButton {
            text: "Add";
            main: true;
            enabled: field.text != "";
            clicked => { Logic.change-comment-add(field.text); }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                width: 24px;
                height: 24px;
                label: "Cancel the comment";
                glyph: Icons.close;
                glyph-size: 12px;
                glyph-color: Theme.icon-quiet;
                clicked => { Logic.change-comment-cancel(); }
            }
        }
    }
}

/// One row of either list.
component Row inherits Rectangle {
    in property <ChangeRow> entry;
    in property <bool> marks;

    height: root.entry.height;

    HorizontalLayout {
        padding-left: Sides.padding;
        padding-right: Sides.padding;
        if root.entry.kind == 0: TitleRow {
            entry: root.entry;
        }
        if root.entry.kind == 1 || root.entry.kind == 2 || root.entry.kind == 3: VerticalLayout {
            padding-top: root.entry.gap;
            Text {
                text: root.entry.text;
                vertical-alignment: center;
                overflow: elide;
                font-size: Size.small;
                color: root.entry.kind == 3 ? Theme.icon-critical-base : Theme.text-weak;
            }
        }
        if root.entry.kind == 4: VerticalLayout {
            padding-top: root.entry.gap;
            FileRow {
                entry: root.entry;
            }
        }
        if root.entry.kind == 5: VerticalLayout {
            padding-top: root.entry.gap;
            Rectangle {
                background: Theme.surface-inset-base;
                LineRow {
                    entry: root.entry;
                    marks: root.marks;
                }
            }
        }
        if root.entry.kind == 8: CommentRow {
            entry: root.entry;
        }
        if root.entry.kind == 9: CommentField { }
        if root.entry.kind == 6: Rectangle {
            background: Theme.surface-inset-base;
            HorizontalLayout {
                padding-left: 40px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    LinkButton {
                        text: root.entry.text;
                        clicked => { Logic.change-whole(root.entry.key); }
                    }
                }
            }
        }
    }
}

/// The lists, which scroll; `marks` for the maximized diff's lines.
component Rows inherits Rectangle {
    in property <[ChangeRow]> rows;
    in property <bool> marks;
    /// The name Rust scrolls it by, and where in it Rust asks for.
    in property <string> name;
    in property <length> reveal-y;
    /// Its name for screen readers.
    in property <string> label;

    property <int> scroll-serial: Requests.scroll-serial;
    changed scroll-serial => {
        if Requests.scroll == root.name {
            list.content-y = -min(root.reveal-y,
                max(0, list.content-height - list.visible-height));
        }
    }

    list := ListView {
        width: parent.width;
        height: parent.height;
        accessible-label: root.label;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        for row in root.rows: Row {
            entry: row;
            marks: root.marks;
        }
    }
    QuietBar {
        x: parent.width - self.width;
        height: parent.height;
        content-y <=> list.content-y;
        content-height: list.content-height;
        visible-height: list.visible-height;
    }
}

/// The foot: the commit message and Commit, Push, and how the last went.
component Foot inherits VerticalLayout {
    property <bool> shown: State.changes-foot.commit || State.changes-foot.push != ""
        || State.changes-foot.note != "" || State.changes-foot.outcome != ""
        || State.changes-foot.comments != "";

    if root.shown: HLine { }
    if root.shown: VerticalLayout {
        padding-top: 12px;
        padding-bottom: 14px;
        padding-left: Sides.padding;
        padding-right: Sides.padding;
        spacing: 10px;
        if State.changes-foot.comments != "": HorizontalLayout {
            spacing: 8px;
            Icon {
                text: Icons.message-square;
                font-size: 13px;
                color: Theme.text-interactive-base;
            }
            Text {
                horizontal-stretch: 1;
                text: State.changes-foot.comments;
                vertical-alignment: center;
                font-size: Size.label;
                color: Theme.text-strong;
            }
            CardButton {
                text: "Discard";
                clicked => { Logic.change-comments-discard(); }
            }
            CardButton {
                text: "Send to the agent";
                main: true;
                enabled: State.changes-foot.can-send;
                clicked => { Logic.change-comments-send(); }
            }
        }
        if State.changes-foot.send-note != "": Text {
            text: State.changes-foot.send-note;
            wrap: word-wrap;
            font-size: Size.small;
            color: Theme.text-weak;
        }
        if State.changes-foot.commit: HorizontalLayout {
            spacing: 8px;
            message := Field {
                horizontal-stretch: 1;
                min-height: 30px;
                placeholder: State.changes-foot.writing ? "Writing…" : "Commit message";
                text-size: Size.label;
                // Rust's message replaces the field's when it changes there,
                // as when a commit uses it up.
                property <string> from-app: State.commit-message;
                changed from-app => {
                    if self.text != self.from-app {
                        self.text = self.from-app;
                    }
                }
                init => {
                    self.text = State.commit-message;
                }
                edited(text) => { Logic.commit-message-edited(text); }
                accepted => {
                    if State.changes-foot.ready {
                        Logic.commit();
                    }
                }
            }
            IconButton {
                label: State.changes-foot.writing ? "Writing the message…" : "Write the message";
                glyph: State.changes-foot.writing ? Icons.loader : Icons.sparkles;
                glyph-color: self.enabled ? Theme.icon-base : Theme.icon-quiet;
                enabled: State.changes-foot.can-write;
                clicked => { Logic.write-commit-message(); }
            }
            CardButton {
                text: State.changes-foot.committing ? "Committing…" : "Commit";
                main: true;
                enabled: State.changes-foot.ready;
                clicked => { Logic.commit(); }
            }
        }
        if State.changes-foot.push != "": HorizontalLayout {
            spacing: 8px;
            alignment: start;
            CardButton {
                text: State.changes-foot.push;
                enabled: State.changes-foot.can-push;
                clicked => { Logic.push(); }
            }
            Text {
                text: State.changes-foot.upstream;
                vertical-alignment: center;
                font-size: Size.small;
                color: Theme.text-weak;
            }
            if State.changes-foot.behind != "": Text {
                text: State.changes-foot.behind;
                vertical-alignment: center;
                font-size: Size.small;
                color: Theme.text-weak;
            }
        }
        if State.changes-foot.note != "": Text {
            text: State.changes-foot.note;
            wrap: word-wrap;
            font-size: Size.small;
            color: Theme.text-weak;
        }
        // What git said can run long; it scrolls past a few lines.
        if State.changes-foot.outcome != "": Flickable {
            height: min(outcome.preferred-height, 96px);
            content-height: outcome.preferred-height;
            outcome := Text {
                width: parent.width;
                text: State.changes-foot.outcome;
                wrap: word-wrap;
                font-size: Size.small;
                color: State.changes-foot.failed ? Theme.icon-critical-base : Theme.text-weak;
            }
        }
    }
}

/// The lists over their foot.
component Lists inherits VerticalLayout {
    if State.changes-note != "": VerticalLayout {
        vertical-stretch: 1;
        padding-top: 20px;
        padding-left: Sides.padding;
        padding-right: Sides.padding;
        alignment: start;
        Text {
            text: State.changes-note;
            wrap: word-wrap;
            font-size: Size.label;
            color: Theme.text-base;
        }
    }
    if State.changes-note == "": Rows {
        vertical-stretch: 1;
        label: "Changed files";
        rows: State.change-rows;
        name: "changes-list";
        reveal-y: State.change-rows-y;
    }
    Foot { }
}

/// The selected file's path over its whole diff.
component SelectedDiff inherits VerticalLayout {
    if State.change-path == "": Rectangle {
        vertical-stretch: 1;
        Text {
            text: "Select a file to see its changes.";
            font-size: Size.small;
            color: Theme.text-weak;
        }
    }
    if State.change-path != "": HorizontalLayout {
        height: 44px;
        padding-left: Sides.padding + 2px;
        padding-right: Sides.padding;
        spacing: 8px;
        Icon {
            text: Icons.folder;
            font-size: 14px;
            color: Theme.icon-quiet;
        }
        Text {
            horizontal-stretch: 1;
            text: State.change-path;
            vertical-alignment: center;
            overflow: elide;
            font-size: Size.label;
            color: Theme.text-strong;
        }
    }
    if State.change-path != "": HLine { }
    if State.change-path != "": Rows {
        vertical-stretch: 1;
        label: "Selected diff";
        rows: State.change-diff;
        marks: true;
        name: "changes-diff";
        reveal-y: State.change-diff-y;
    }
}

/// The Changes panel's body; `wide` when maximized.
export component ChangesPanel inherits Rectangle {
    in property <bool> wide;

    if !root.wide: Lists { }
    if root.wide: HorizontalLayout {
        Lists {
            width: min(380px, parent.width / 2);
        }
        VLine { }
        SelectedDiff {
            horizontal-stretch: 1;
        }
    }
}
