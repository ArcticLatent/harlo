// The pages that open over the window from the left rail: the stats
// across sessions, Settings with its list of sections and search, and the
// setup guide with its steps. A click outside the card or Esc closes them.

import { AboutSlint, Palette } from "std-widgets.slint";
import { Theme, Size, Fonts } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Logic, Requests, SheetRow, ThemeCard } from "data.slint";
import { Field, Icon, IconButton, Press, HLine, VLine, Switch, ProjectMark, QuietScroll } from "widgets.slint";
import { CardButton, GhostButton } from "waiting.slint";

/// A small button with a word on it, at the end of a row.
component ActionButton inherits Press {
    in property <string> text;
    /// Whether it deletes something, drawn in the danger colours.
    in property <bool> risky;
    height: 24px;
    width: label-text.preferred-width + 20px;
    label: root.text;
    rest: Theme.control-fill;
    outlined: true;
    border-color: root.risky ? Theme.risky-edge
        : root.hovered && root.enabled ? Theme.control-edge-hover : Theme.control-edge;

    label-text := Text {
        text: root.text;
        font-size: Size.small;
        color: root.risky ? Theme.risky-ink : Theme.text-strong;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

/// One of a few options side by side; the chosen one stands out.
component ChoiceButton inherits Press {
    in property <string> text;
    height: 24px;
    min-width: max(70px, words.preferred-width + 20px);
    label: root.text;
    rest: transparent;
    lit: Theme.selected-tint;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.border-interactive-base;
    accessible-checkable: true;
    accessible-checked: root.selected;

    words := Text {
        text: root.text;
        font-size: Size.small;
        color: root.selected ? Theme.text-strong : Theme.text-weak;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

/// A colour to choose: a dot, ringed while chosen; the first is none.
component Swatch inherits Press {
    in property <color> tint;
    in property <bool> none;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    rest: transparent;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.border-interactive-base;
    accessible-checkable: true;
    accessible-checked: root.selected;

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.none ? transparent : root.tint;
        border-width: root.none ? 1px : 0px;
        border-color: Theme.border-base;
        // None: a slash through an empty dot.
        if root.none: Rectangle {
            width: 1px;
            height: 14px;
            background: Theme.border-base;
            transform-rotation: 45deg;
        }
    }
}

/// A preview of a theme: a small window in its colours, and its name.
component ThemeTile inherits Press {
    in property <ThemeCard> card;
    height: 96px;
    label: root.card.name;
    rest: transparent;
    hover: transparent;
    lit: transparent;
    accessible-checkable: true;
    accessible-checked: root.card.chosen;

    preview := Rectangle {
        y: 0;
        height: 68px;
        border-radius: 6px;
        background: root.card.background;
        border-width: root.card.chosen ? 2px : 1px;
        border-color: root.card.chosen ? Theme.border-interactive-focus
            : root.hovered ? Theme.border-base : Theme.border-weak-base;
        clip: true;

        // The sidebar, with two sessions.
        Rectangle {
            x: 0;
            width: parent.width * 0.28;
            background: root.card.sidebar;
            for line[index] in 2: Rectangle {
                x: 8px;
                y: 12px + index * 10px;
                width: parent.width - 16px - index * 8px;
                height: 4px;
                border-radius: 2px;
                background: root.card.weak;
            }
        }
        // A reply: a line of text, a quieter one, and a line of code.
        Rectangle {
            x: parent.width * 0.28 + 10px;
            y: 12px;
            width: parent.width * 0.4;
            height: 5px;
            border-radius: 2.5px;
            background: root.card.text;
        }
        Rectangle {
            x: parent.width * 0.28 + 10px;
            y: 23px;
            width: parent.width * 0.52;
            height: 4px;
            border-radius: 2px;
            background: root.card.weak;
        }
        Rectangle {
            x: parent.width * 0.28 + 10px;
            y: 34px;
            width: parent.width * 0.62;
            height: 12px;
            border-radius: 3px;
            background: root.card.raised;
            HorizontalLayout {
                padding-left: 5px;
                padding-right: 5px;
                spacing: 4px;
                alignment: start;
                for colour[index] in [root.card.keyword, root.card.function, root.card.text-string]: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: index == 2 ? 22px : 12px;
                        height: 4px;
                        border-radius: 2px;
                        background: colour;
                    }
                }
            }
        }
        // The main button.
        Rectangle {
            x: parent.width - self.width - 8px;
            y: parent.height - self.height - 8px;
            width: 22px;
            height: 9px;
            border-radius: 4.5px;
            background: root.card.brand;
        }
    }
    Text {
        y: preview.height + 6px;
        width: parent.width;
        text: root.card.name;
        font-size: Size.small;
        font-weight: root.card.chosen ? 600 : 400;
        color: root.card.chosen ? Theme.text-strong : Theme.text-base;
        overflow: elide;
        accessible-role: none;
    }
}

/// The themes as cards, as many to a row as fit.
component ThemeGrid inherits Rectangle {
    in property <[ThemeCard]> cards;
    property <length> gap: 12px;
    property <int> columns: max(1, floor((root.width + root.gap) / (150px + root.gap)));
    property <length> tile-width: (root.width - (root.columns - 1) * root.gap) / root.columns;
    property <int> rows: ceil(root.cards.length / root.columns);
    height: root.rows * (96px + root.gap);

    for card[index] in root.cards: ThemeTile {
        x: mod(index, root.columns) * (root.tile-width + root.gap);
        y: floor(index / root.columns) * (96px + root.gap);
        width: root.tile-width;
        card: card;
        clicked => { Logic.pick-theme(card.id); }
    }
}

/// The heading over a group of theme cards, styled as the rows' headings.
component ThemeHeading inherits Text {
    height: 40px;
    font-size: Size.label;
    font-weight: 600;
    color: Theme.text-strong;
    vertical-alignment: bottom;
    accessible-role: AccessibleRole.text;
}

/// One row: a heading, a name with its value, a note, a switch with what
/// it does, or the light-or-dark choice.
/// What a row shows, by its kind.
component RowBody inherits VerticalLayout {
    in property <SheetRow> entry;
    in property <bool> first;
    // A field just saved says so for a moment.
    property <bool> saved;

    /// Takes the field's `text` as its setting, and says so for a moment.
    function save(text: string) {
        Logic.settings-text(root.entry.setting, text);
        root.saved = true;
    }

    Timer {
        interval: 1.6s;
        running: root.saved;
        triggered => { root.saved = false; }
    }

    if root.entry.kind == 0: Text {
        // Room above each group after the first.
        height: root.first ? 26px : 46px;
        text: root.entry.name;
        font-size: Size.label;
        font-weight: 600;
        color: Theme.text-strong;
        vertical-alignment: bottom;
        accessible-role: AccessibleRole.text;
    }
    if root.entry.kind == 0: Rectangle { height: 6px; }
    // About's head: Harlo's mark, its name, the versions and what it is.
    if root.entry.kind == 12: HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 18px;
        spacing: 16px;
        alignment: start;
        Rectangle {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            background: Theme.control-fill;
            border-width: 1px;
            border-color: Theme.border-weak-base;
            Rectangle {
                width: 31px;
                height: 32px;
                if Theme.own-logo: Image {
                    width: 100%;
                    height: 100%;
                    source: @image-url("images/logo-mark.svg");
                    accessible-role: none;
                }
                if !Theme.own-logo: Image {
                    width: 100%;
                    height: 100%;
                    source: @image-url("images/logo-mark-left.svg");
                    colorize: Theme.brand-ink;
                    accessible-role: none;
                }
                if !Theme.own-logo: Image {
                    width: 100%;
                    height: 100%;
                    source: @image-url("images/logo-mark-right.svg");
                    colorize: Theme.accent-ink;
                    accessible-role: none;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: root.entry.name;
                font-size: Size.text * 1.5;
                font-weight: 600;
                color: Theme.text-strong;
                accessible-role: AccessibleRole.text;
            }
            Text {
                text: root.entry.value;
                font-size: Size.small;
                color: Theme.text-weak;
                accessible-role: AccessibleRole.text;
            }
            Text {
                text: root.entry.hint;
                font-size: Size.small;
                color: Theme.text-base;
                accessible-role: AccessibleRole.text;
            }
        }
    }
    // An icon in a tile, a name with a line under it, and a button.
    if root.entry.kind == 13: HorizontalLayout {
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 12px;
        if root.entry.glyph != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: Theme.control-fill;
                Icon {
                    text: root.entry.glyph;
                    font-size: 14px;
                    color: Theme.icon-base;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.entry.name;
                    font-size: Size.small;
                    color: Theme.text-strong;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                }
                // A short tag after the name, such as "Recommended".
                if root.entry.hint != "": Rectangle {
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.control-edge;
                    width: tag.preferred-width + 10px;
                    tag := Text {
                        text: root.entry.hint;
                        font-size: Size.small - 1px;
                        color: Theme.text-weak;
                        vertical-alignment: center;
                        accessible-role: AccessibleRole.text;
                    }
                }
            }
            Text {
                text: root.entry.value;
                font-size: Size.small;
                color: Theme.text-weak;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }
        if root.entry.action != "": VerticalLayout {
            alignment: center;
            ActionButton {
                text: root.entry.action;
                label: root.entry.action + ": " + root.entry.name;
                clicked => { Logic.settings-action(root.entry.setting, root.entry.choice); }
            }
        }
    }
    // A shortcut: what it does, then its keys as keycaps, "or" between
    // ways of doing the same ("|" in `options`). Words that aren't keys,
    // such as a double click, are its `hint`. The keys as written are its
    // name for screen readers and search.
    if root.entry.kind == 11: HorizontalLayout {
        height: 30px;
        spacing: 16px;
        Text {
            horizontal-stretch: 1;
            text: root.entry.value;
            font-size: Size.small;
            color: Theme.text-base;
            overflow: elide;
            vertical-alignment: center;
            accessible-role: AccessibleRole.text;
        }
        Rectangle {
            accessible-role: AccessibleRole.text;
            accessible-label: root.entry.name;
            HorizontalLayout {
                spacing: 4px;
                if root.entry.hint != "": Text {
                    text: root.entry.hint;
                    font-size: Size.small;
                    color: Theme.text-weak;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                for token in root.entry.options: VerticalLayout {
                    alignment: center;
                    if token == "|": Text {
                        text: "or";
                        font-size: Size.small;
                        color: Theme.text-weak;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    if token != "|": Rectangle {
                        height: 22px;
                        width: max(22px, cap.preferred-width + 14px);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.control-edge;
                        background: Theme.control-fill;
                        cap := Text {
                            text: token;
                            font-size: Size.small;
                            color: Theme.text-strong;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                }
            }
        }
    }
    if root.entry.kind == 1: HorizontalLayout {
        height: 30px;
        spacing: 16px;
        // An icon before the name, such as an agent's.
        if root.entry.glyph != "": Icon {
            width: 14px;
            text: root.entry.glyph;
            font-size: 13px;
            color: Theme.agent-ink;
        }
        Text {
            horizontal-stretch: 1;
            text: root.entry.name;
            font-family: root.entry.mono-name ? Fonts.mono : Fonts.sans;
            font-size: root.entry.mono-name ? Size.code : Size.small;
            color: Theme.text-base;
            overflow: elide;
            vertical-alignment: center;
            accessible-role: AccessibleRole.text;
        }
        Text {
            horizontal-stretch: 2;
            text: root.entry.value;
            font-family: root.entry.mono-value ? Fonts.mono : Fonts.sans;
            font-size: root.entry.mono-value ? Size.code : Size.small;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            color: root.entry.tone == 1 ? Theme.icon-success-base
                : root.entry.tone == 2 ? Theme.icon-critical-base
                : root.entry.tone == 3 ? Theme.text-weak
                : root.entry.tone == 4 ? Theme.icon-warning-base : Theme.text-base;
            accessible-role: AccessibleRole.text;
        }
        if root.entry.action != "": VerticalLayout {
            alignment: center;
            clip := TextInput {
                visible: false;
                width: 0;
                height: 0;
            }
            ActionButton {
                text: root.entry.action;
                risky: root.entry.risky;
                clicked => {
                    if root.entry.copy != "" {
                        clip.text = root.entry.copy;
                        clip.select-all();
                        clip.copy();
                    }
                    // A menu it opens hangs from it.
                    Requests.anchor-x = self.absolute-position.x;
                    Requests.anchor-y = self.absolute-position.y;
                    Requests.anchor-height = self.height;
                    Logic.settings-action(root.entry.setting, root.entry.choice);
                }
            }
        }
    }
    if root.entry.kind == 2: Text {
        text: root.entry.name;
        font-size: Size.small;
        color: Theme.text-weak;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
    }
    if root.entry.kind == 4: HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.entry.name;
                font-size: Size.small;
                color: Theme.text-base;
                accessible-role: AccessibleRole.text;
            }
            if root.entry.value != "": Text {
                text: root.entry.value;
                font-size: Size.small;
                color: Theme.text-weak;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                border-radius: Size.radius + 2px;
                border-width: 1px;
                border-color: Theme.control-edge;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    for option[index] in root.entry.options: ChoiceButton {
                        text: option;
                        label: root.entry.name + ": " + option;
                        selected: root.entry.setting == index;
                        clicked => { Logic.choose(root.entry.choice, index); }
                    }
                }
            }
        }
    }
    if root.entry.kind == 8: HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 16px;
        Text {
            horizontal-stretch: 1;
            text: root.entry.name;
            font-size: Size.small;
            color: Theme.text-base;
            vertical-alignment: center;
            accessible-role: AccessibleRole.text;
        }
        HorizontalLayout {
            spacing: 4px;
            for tint[index] in root.entry.colors: Swatch {
                tint: tint;
                none: index == 0;
                label: root.entry.name + ": " + root.entry.options[index];
                selected: root.entry.setting == index;
                clicked => { Logic.choose(root.entry.choice, index); }
            }
        }
    }
    if root.entry.kind == 9: Press {
        height: 44px;
        label: root.entry.name;
        about: root.entry.value;
        clicked => { Logic.settings-action(root.entry.setting, root.entry.choice); }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                if root.entry.glyph == "": ProjectMark {
                    size: 18px;
                    picture: root.entry.picture;
                    colored: root.entry.on;
                    tint: root.entry.color;
                }
                if root.entry.glyph != "": Icon {
                    width: 18px;
                    text: root.entry.glyph;
                    font-size: 16px;
                    color: Theme.icon-base;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.entry.name;
                    font-size: Size.small;
                    font-weight: 600;
                    color: Theme.text-strong;
                    overflow: elide;
                    accessible-role: none;
                }
                Text {
                    text: root.entry.value;
                    font-size: Size.small;
                    color: Theme.text-weak;
                    overflow: elide;
                    accessible-role: none;
                }
            }
            Icon {
                text: Icons.chevron-right;
                color: Theme.icon-quiet;
            }
        }
    }
    if root.entry.kind == 10: HorizontalLayout {
        alignment: start;
        padding-top: 8px;
        padding-bottom: 8px;
        // White in either theme: a QR code needs it to be read.
        Rectangle {
            width: 256px;
            height: 256px;
            background: white;
            border-radius: 8px;
            // Smooth scaling keeps the modules even; the code has its own
            // white margin.
            Image {
                width: 248px;
                height: 248px;
                source: root.entry.picture;
                accessible-role: AccessibleRole.image;
                accessible-label: root.entry.name;
            }
        }
    }
    if root.entry.kind == 5: VerticalLayout {
        ThemeHeading {
            text: root.entry.name;
        }
        ThemeGrid {
            cards: root.entry.setting == 0 ? State.dark-theme-cards : State.light-theme-cards;
        }
    }
    // A long name, such as a sign-in form's question, sits above the field.
    if root.entry.kind == 6 && root.entry.name.character-count > 12: Text {
        text: root.entry.name;
        font-size: Size.small;
        color: Theme.text-base;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
    }
    if root.entry.kind == 6: HorizontalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 12px;
        if root.entry.name.character-count <= 12: Text {
            width: 72px;
            text: root.entry.name;
            font-size: Size.small;
            color: Theme.text-base;
            vertical-alignment: center;
            accessible-role: AccessibleRole.text;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            field := Field {
                width: parent.width;
                height: parent.height;
                text-size: Size.small;
                placeholder: root.entry.hint;
                label: root.entry.label != "" ? root.entry.label : root.entry.name;
                text: root.entry.value;
                secret: root.entry.on;
                accepted => {
                    if root.entry.saves && root.entry.action == "" {
                        root.save(self.text);
                    } else {
                        Logic.settings-text(root.entry.setting, self.text);
                    }
                }
                // Without a button, what's typed is taken as it's typed,
                // or when the field is left.
                edited(text) => {
                    if root.entry.action == "" && !root.entry.saves {
                        Logic.settings-text(root.entry.setting, text);
                    }
                }
                changed has-focus => {
                    if !self.has-focus && root.entry.saves && root.entry.action == ""
                        && self.text != root.entry.value {
                        root.save(self.text);
                    }
                }
            }
            // Over the field's end, on its own fill, so it reads over text.
            if root.saved: Rectangle {
                x: parent.width - self.width - 1px;
                y: 1px;
                width: saved-text.preferred-width + 20px;
                height: parent.height - 2px;
                border-radius: Size.radius;
                background: Theme.field-fill;
                saved-text := Text {
                    text: "Saved";
                    font-size: Size.small;
                    color: Theme.text-weak;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                }
            }
        }
        if root.entry.action != "": VerticalLayout {
            alignment: center;
            ActionButton {
                text: root.entry.action;
                label: root.entry.action + " " + root.entry.name;
                clicked => { Logic.settings-text(root.entry.setting, field.text); }
            }
        }
    }
    if root.entry.kind == 7: HorizontalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 12px;
        Rectangle {
            horizontal-stretch: 1;
            min-height: 32px;
            border-radius: Size.radius;
            background: Theme.surface-inset-base;
            clip: true;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                // Selectable, so it can be copied to run by hand.
                TextInput {
                    text: root.entry.value;
                    read-only: true;
                    single-line: true;
                    font-family: Fonts.mono;
                    font-size: Size.small;
                    color: Theme.text-strong;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                    accessible-label: root.entry.value;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            ActionButton {
                text: root.entry.action;
                clicked => { Logic.settings-action(root.entry.setting, root.entry.choice); }
            }
        }
    }
    if root.entry.kind == 3: HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.entry.name;
                font-size: Size.small;
                color: Theme.text-base;
                accessible-role: AccessibleRole.text;
            }
            Text {
                text: root.entry.value;
                font-size: Size.small;
                color: Theme.text-weak;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }
        VerticalLayout {
            alignment: center;
            Switch {
                on: root.entry.on;
                label: root.entry.name;
                toggled => { Logic.switch-setting(root.entry.setting); }
            }
        }
    }
}


/// A row of Settings, or a piece of the card its group sits in: rounded
/// at the card's top and bottom, with a line between rows.
component Row inherits Rectangle {
    in property <SheetRow> entry;
    /// Whether it's the page's first row, which needs no room above it.
    in property <bool> first;
    property <bool> carded: root.entry.place > 0;
    property <bool> top: root.entry.place == 1 || root.entry.place == 2;
    property <bool> bottom: root.entry.place == 1 || root.entry.place == 4;
    property <length> radius: 8px;

    background: root.carded ? Theme.control-fill : transparent;
    border-top-left-radius: root.top ? root.radius : 0;
    border-top-right-radius: self.border-top-left-radius;
    border-bottom-left-radius: root.bottom ? root.radius : 0;
    border-bottom-right-radius: self.border-bottom-left-radius;

    // A note in a card belongs to the row above it, so no line between.
    if root.carded && !root.top && root.entry.kind != 2: Rectangle {
        x: 14px;
        y: 0;
        width: parent.width - 28px;
        height: 1px;
        background: Theme.border-weak-base;
    }
    RowBody {
        entry: root.entry;
        first: root.first;
        padding-left: root.carded ? 14px : 0;
        padding-right: root.carded ? 10px : 0;
        padding-top: root.carded ? (root.top ? 7px : root.entry.kind == 2 ? 0 : 5px)
            : root.entry.kind == 1 ? 6px : 0;
        padding-bottom: root.carded ? (root.bottom ? 7px : 5px)
            : root.entry.kind == 2 ? 10px : 0;
    }
}


/// A section in Settings' list.
component SectionButton inherits Press {
    in property <string> text;
    in property <string> glyph;
    height: 30px;
    label: root.text;
    lit: Theme.selected-tint;

    // The chosen section's mark, at its start.
    if root.selected: Rectangle {
        x: 0;
        width: 2px;
        height: parent.height - 10px;
        border-radius: 1px;
        background: Theme.accent-ink;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            text: root.glyph;
            font-size: 14px;
            color: root.selected ? Theme.accent-ink : Theme.icon-base;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: Size.small;
            color: root.selected ? Theme.text-strong : Theme.text-base;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
}

/// The page's title and its close button.
component SheetHead inherits HorizontalLayout {
    height: 52px;
    padding-left: 20px;
    padding-right: 12px;
    Text {
        horizontal-stretch: 1;
        text: State.sheet-title;
        font-size: 16px * Size.text-scale;
        font-weight: 600;
        color: Theme.text-strong;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: AccessibleRole.text;
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            label: "Close";
            glyph: Icons.close;
            clicked => { Logic.close-sheet(); }
        }
    }
}

/// The page's note and rows.
component SheetRows inherits VerticalLayout {
    spacing: 6px;
    if State.sheet-note != "": Text {
        text: State.sheet-note;
        font-size: Size.small;
        color: Theme.text-weak;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
    }
    VerticalLayout {
        spacing: 0;
        for entry[index] in State.sheet-rows: Row {
            entry: entry;
            first: index == 0;
        }
    }
}

/// Settings' search and its list of sections, under their groups.
component SectionList inherits Rectangle {
    // Under glass it lets the card's blur through.
    background: Theme.surface-inset-base.with-alpha(Theme.glass ? 0.5 : 1);

    VerticalLayout {
        padding: 12px;
        padding-top: 14px;
        spacing: 2px;

        Text {
            height: 26px;
            text: "Settings";
            font-size: 16px * Size.text-scale;
            font-weight: 600;
            color: Theme.text-strong;
            accessible-role: AccessibleRole.text;
        }
        Field {
            height: 32px;
            glyph: Icons.search;
            placeholder: "Search settings";
            fill: Theme.surface-raised-strong;
            text <=> State.settings-query;
            edited(text) => { Logic.settings-search(text); }
        }
        Rectangle { height: 8px; }

        // The sections scroll when the card is too short for them all.
        QuietScroll {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 2px;

                for section[index] in State.settings-sections: VerticalLayout {
                    if section.group != ""
                        && (index == 0 || State.settings-sections[index - 1].group != section.group): Text {
                        height: 28px;
                        text: section.group;
                        font-size: Size.small;
                        color: Theme.text-weak;
                        vertical-alignment: bottom;
                        accessible-role: AccessibleRole.text;
                    }
                    if section.group == "" && index > 0
                        && State.settings-sections[index - 1].group != "": Rectangle {
                        height: 10px;
                    }
                    SectionButton {
                        text: section.title;
                        glyph: section.glyph;
                        selected: State.settings-section == index && State.settings-query == "";
                        clicked => { Logic.pick-section(index); }
                    }
                }
            }
        }
    }
}

/// A step in the setup guide's list: its number, or a tick once passed.
component StepButton inherits Press {
    in property <string> text;
    in property <int> number;
    in property <bool> done;
    height: 34px;
    label: root.text;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: root.selected ? Theme.surface-brand-base
                    : root.done ? Theme.selected-tint : Theme.surface-raised-strong;
                if root.done && !root.selected: Icon {
                    text: Icons.check;
                    font-size: 12px;
                    color: Theme.accent-ink;
                }
                if !root.done || root.selected: Text {
                    text: root.number;
                    font-size: 11px;
                    font-weight: 600;
                    color: root.selected ? Theme.text-on-brand-base : Theme.text-weak;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: Size.small;
            color: root.selected ? Theme.text-strong : Theme.text-base;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
}

/// The setup guide's steps.
component StepList inherits Rectangle {
    background: Theme.surface-inset-base.with-alpha(Theme.glass ? 0.5 : 1);

    VerticalLayout {
        padding: 12px;
        padding-top: 14px;
        spacing: 2px;

        Text {
            height: 26px;
            text: "Set up Harlo";
            font-size: 16px * Size.text-scale;
            font-weight: 600;
            color: Theme.text-strong;
            accessible-role: AccessibleRole.text;
        }
        Rectangle { height: 8px; }
        for title[index] in State.setup-steps: StepButton {
            text: title;
            number: index + 1;
            done: index < State.setup-step;
            selected: index == State.setup-step;
            clicked => { Logic.setup-step(index); }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

/// The guide's foot: skip, and back and on.
component StepFoot inherits HorizontalLayout {
    height: 56px;
    padding-left: 12px;
    padding-right: 16px;
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        GhostButton {
            text: "Skip setup";
            clicked => { Logic.close-sheet(); }
        }
    }
    Text {
        horizontal-stretch: 1;
        text: "Settings → General opens this again.";
        font-size: Size.small;
        color: Theme.text-weak;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: AccessibleRole.text;
    }
    if State.setup-step > 0: VerticalLayout {
        alignment: center;
        CardButton {
            text: "Back";
            clicked => { Logic.setup-back(); }
        }
    }
    VerticalLayout {
        alignment: center;
        CardButton {
            main: true;
            text: State.setup-step >= State.setup-steps.length - 1 ? "Finish" : "Next";
            clicked => { Logic.setup-next(); }
        }
    }
}

/// A range button on the stats page.
component RangeButton inherits Press {
    in property <string> text;
    height: 26px;
    label: root.text;
    lit: Theme.selected-tint;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.border-interactive-base;

    Text {
        text: root.text;
        font-size: Size.small;
        color: root.selected ? Theme.accent-ink : Theme.text-weak;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// The stats' range buttons, numbers and day bars.
component StatsHead inherits VerticalLayout {
    alignment: start;
    spacing: 16px;

    HorizontalLayout {
        alignment: start;
        Rectangle {
            border-radius: Size.radius + 2px;
            border-width: 1px;
            border-color: Theme.control-edge;
            HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                for range[index] in ["Last 7 days", "Last 30 days", "All time"]: RangeButton {
                    width: 96px;
                    text: range;
                    selected: State.stat-range == index;
                    clicked => { Logic.stats-range(index); }
                }
            }
        }
    }

    if State.stat-tiles.length > 0: Rectangle {
        height: 2 * 58px + 8px;
        for tile[index] in State.stat-tiles: Rectangle {
            property <int> per-row: 4;
            x: mod(index, self.per-row) * (parent.width + 8px) / self.per-row;
            y: floor(index / self.per-row) * (58px + 8px);
            width: (parent.width + 8px) / self.per-row - 8px;
            height: 58px;
            border-radius: Size.radius;
            border-width: 1px;
            border-color: Theme.control-edge;

            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                Text {
                    text: tile.value;
                    font-size: 18px * Size.text-scale;
                    font-weight: 600;
                    color: Theme.text-strong;
                    accessible-role: AccessibleRole.text;
                }
                Text {
                    text: tile.label;
                    font-size: Size.small;
                    color: Theme.text-weak;
                    accessible-role: AccessibleRole.text;
                }
            }
        }
    }

    if State.stat-days.length > 0: VerticalLayout {
        spacing: 8px;
        Text {
            text: "Model steps per day";
            font-size: Size.label;
            font-weight: 600;
            color: Theme.text-strong;
        }
        HorizontalLayout {
            spacing: 8px;
            // The scale: the busiest day at the top, none at the foot.
            VerticalLayout {
                width: 16px;
                height: 56px;
                Text {
                    text: State.stat-peak;
                    horizontal-alignment: right;
                    font-size: Size.small * 0.9;
                    color: Theme.text-weaker;
                }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "0";
                    horizontal-alignment: right;
                    font-size: Size.small * 0.9;
                    color: Theme.text-weaker;
                }
            }
            Rectangle {
                height: 56px;
                // Lines at the top and the foot.
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border-weak-base;
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border-base;
                }
                // A slot for each of the last 30 days, the newest at the right.
                for day in State.stat-days: Rectangle {
                    property <length> slot: parent.width / 30;
                    x: day.slot * self.slot;
                    width: max(2px, self.slot - 3px);
                    y: parent.height - self.height;
                    height: max(2px, day.share * parent.height);
                    border-radius: 2px;
                    background: Theme.text-interactive-base;
                    accessible-role: AccessibleRole.text;
                    accessible-label: day.label;
                }
            }
        }
        // How far back the chart goes, under it, past the scale.
        HorizontalLayout {
            padding-left: 24px;
            Text {
                horizontal-stretch: 1;
                text: State.stat-from;
                font-size: Size.small * 0.9;
                color: Theme.text-weaker;
            }
            Text {
                text: "Today";
                font-size: Size.small * 0.9;
                color: Theme.text-weaker;
            }
        }
    }
    // A line before the rows under the chart.
    if State.stat-tiles.length > 0: Rectangle {
        height: 1px;
        background: Theme.border-weak-base;
    }
}

/// The card over the window, which it shades. The shade takes no clicks, so
/// the rail buttons at either edge still switch pages.
export component SheetLayer inherits Rectangle {
    background: Theme.scrim;

    // A click outside the card, between the rails, closes it.
    TouchArea {
        x: Size.rail;
        width: root.width - 2 * Size.rail;
        clicked => { Logic.close-sheet(); }
    }

    card := Rectangle {
        width: min(State.sheet == 2 ? 900px : State.sheet == 3 ? 820px : 720px,
            root.width - 2 * Size.rail - 64px);
        height: min(State.sheet == 2 ? 760px : State.sheet == 3 ? 600px : 680px,
            root.height - 96px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.card;
        backdrop-blur: Theme.card-blur;
        border-radius: Size.menu-radius;
        border-width: 1px;
        border-color: Theme.menu-edge;
        drop-shadow-color: #00000073;
        drop-shadow-offset-y: 10px;
        drop-shadow-blur: 28px;
        clip: true;

        // Clicks on the card stay on it.
        TouchArea { }

        if State.sheet == 1: VerticalLayout {
            SheetHead { }
            HLine { }
            QuietScroll {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    padding: 20px;
                    padding-top: 4px;
                    spacing: 6px;
                    StatsHead { }
                    SheetRows { }
                }
            }
        }

        if State.sheet == 2: HorizontalLayout {
            SectionList {
                width: min(220px, card.width * 0.32);
            }
            VLine { }
            VerticalLayout {
                horizontal-stretch: 1;
                SheetHead { }
                HLine { }
                QuietScroll {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding: 20px;
                        padding-top: 4px;
                        spacing: 6px;
                        SheetRows { }
                        // The last section, About, ends with Slint's notice.
                        if State.settings-section == State.settings-sections.length - 1
                            && State.settings-query == "": HorizontalLayout {
                            padding-top: 20px;
                            alignment: start;
                            // Slint's badge, small: it credits the toolkit. It draws
                            // in the desktop's scheme, so its tile does too, and
                            // its words show in either of Harlo's.
                            Rectangle {
                                width: 130px;
                                height: 100px;
                                border-radius: 10px;
                                background: Palette.background;
                                AboutSlint {
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }
                    }
                }
            }
        }

        if State.sheet == 3: HorizontalLayout {
            StepList {
                width: min(200px, card.width * 0.3);
            }
            VLine { }
            VerticalLayout {
                horizontal-stretch: 1;
                SheetHead { }
                HLine { }
                QuietScroll {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding: 20px;
                        padding-top: 12px;
                        spacing: 6px;
                        SheetRows { }
                    }
                }
                HLine { }
                StepFoot { }
            }
        }
    }
}
