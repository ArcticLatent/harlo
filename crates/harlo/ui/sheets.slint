// The pages that open over the window from the left rail: the stats
// across sessions, and Settings with its list of sections and search. A
// click outside the card or Esc closes them.

import { AboutSlint, ScrollView } from "std-widgets.slint";
import { Theme, Size } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Logic, Requests, SheetRow, ThemeCard } from "data.slint";
import { Field, Icon, IconButton, Press, HLine, VLine, Switch } from "widgets.slint";

/// A small button with a word on it, at the end of a row.
component ActionButton inherits Press {
    in property <string> text;
    height: 24px;
    width: label-text.preferred-width + 20px;
    label: root.text;
    rest: Theme.surface-inset-base;
    border-width: 1px;
    border-color: Theme.border-weak-base;

    label-text := Text {
        text: root.text;
        font-size: Size.small;
        color: Theme.text-strong;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

/// One of a few options side by side; the chosen one stands out.
component ChoiceButton inherits Press {
    in property <string> text;
    height: 24px;
    min-width: max(70px, words.preferred-width + 20px);
    label: root.text;
    rest: transparent;
    lit: Theme.selected-tint;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.border-interactive-base;
    accessible-checkable: true;
    accessible-checked: root.selected;

    words := Text {
        text: root.text;
        font-size: Size.small;
        color: root.selected ? Theme.text-strong : Theme.text-weak;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

/// A preview of a theme: a small window in its colours, and its name.
component ThemeTile inherits Press {
    in property <ThemeCard> card;
    height: 96px;
    label: root.card.name;
    rest: transparent;
    hover: transparent;
    lit: transparent;
    accessible-checkable: true;
    accessible-checked: root.card.chosen;

    preview := Rectangle {
        y: 0;
        height: 68px;
        border-radius: 6px;
        background: root.card.background;
        border-width: root.card.chosen ? 2px : 1px;
        border-color: root.card.chosen ? Theme.border-interactive-focus
            : root.hovered ? Theme.border-base : Theme.border-weak-base;
        clip: true;

        // The sidebar, with two sessions.
        Rectangle {
            x: 0;
            width: parent.width * 0.28;
            background: root.card.sidebar;
            for line[index] in 2: Rectangle {
                x: 8px;
                y: 12px + index * 10px;
                width: parent.width - 16px - index * 8px;
                height: 4px;
                border-radius: 2px;
                background: root.card.weak;
            }
        }
        // A reply: a line of text, a quieter one, and a line of code.
        Rectangle {
            x: parent.width * 0.28 + 10px;
            y: 12px;
            width: parent.width * 0.4;
            height: 5px;
            border-radius: 2.5px;
            background: root.card.text;
        }
        Rectangle {
            x: parent.width * 0.28 + 10px;
            y: 23px;
            width: parent.width * 0.52;
            height: 4px;
            border-radius: 2px;
            background: root.card.weak;
        }
        Rectangle {
            x: parent.width * 0.28 + 10px;
            y: 34px;
            width: parent.width * 0.62;
            height: 12px;
            border-radius: 3px;
            background: root.card.raised;
            HorizontalLayout {
                padding-left: 5px;
                padding-right: 5px;
                spacing: 4px;
                alignment: start;
                for colour[index] in [root.card.keyword, root.card.function, root.card.text-string]: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: index == 2 ? 22px : 12px;
                        height: 4px;
                        border-radius: 2px;
                        background: colour;
                    }
                }
            }
        }
        // The main button.
        Rectangle {
            x: parent.width - self.width - 8px;
            y: parent.height - self.height - 8px;
            width: 22px;
            height: 9px;
            border-radius: 4.5px;
            background: root.card.brand;
        }
    }
    Text {
        y: preview.height + 6px;
        width: parent.width;
        text: root.card.name;
        font-size: Size.small;
        font-weight: root.card.chosen ? 600 : 400;
        color: root.card.chosen ? Theme.text-strong : Theme.text-base;
        overflow: elide;
        accessible-role: none;
    }
}

/// The themes as cards, as many to a row as fit.
component ThemeGrid inherits Rectangle {
    in property <[ThemeCard]> cards;
    property <length> gap: 12px;
    property <int> columns: max(1, floor((root.width + root.gap) / (150px + root.gap)));
    property <length> tile-width: (root.width - (root.columns - 1) * root.gap) / root.columns;
    property <int> rows: ceil(root.cards.length / root.columns);
    height: root.rows * (96px + root.gap);

    for card[index] in root.cards: ThemeTile {
        x: mod(index, root.columns) * (root.tile-width + root.gap);
        y: floor(index / root.columns) * (96px + root.gap);
        width: root.tile-width;
        card: card;
        clicked => { Logic.pick-theme(card.id); }
    }
}

/// The heading over a group of theme cards, styled as the rows' headings.
component ThemeHeading inherits Text {
    height: 40px;
    font-size: Size.label;
    font-weight: 600;
    color: Theme.text-strong;
    vertical-alignment: bottom;
    accessible-role: AccessibleRole.text;
}

/// One row: a heading, a name with its value, a note, a switch with what
/// it does, or the light-or-dark choice.
component Row inherits VerticalLayout {
    in property <SheetRow> entry;

    if root.entry.kind == 0: Text {
        height: 40px;
        text: root.entry.name;
        font-size: Size.label;
        font-weight: 600;
        color: Theme.text-strong;
        vertical-alignment: bottom;
        accessible-role: AccessibleRole.text;
    }
    if root.entry.kind == 1: HorizontalLayout {
        height: 30px;
        spacing: 16px;
        Text {
            horizontal-stretch: 1;
            text: root.entry.name;
            font-size: Size.small;
            color: Theme.text-base;
            overflow: elide;
            vertical-alignment: center;
            accessible-role: AccessibleRole.text;
        }
        Text {
            horizontal-stretch: 2;
            text: root.entry.value;
            font-size: Size.small;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            color: root.entry.tone == 1 ? Theme.icon-success-base
                : root.entry.tone == 2 ? Theme.icon-critical-base
                : root.entry.tone == 3 ? Theme.text-weak
                : root.entry.tone == 4 ? Theme.icon-warning-base : Theme.text-base;
            accessible-role: AccessibleRole.text;
        }
        if root.entry.action != "": VerticalLayout {
            alignment: center;
            ActionButton {
                text: root.entry.action;
                clicked => {
                    // A menu it opens hangs from it.
                    Requests.anchor-x = self.absolute-position.x;
                    Requests.anchor-y = self.absolute-position.y;
                    Requests.anchor-height = self.height;
                    Logic.settings-action(root.entry.setting);
                }
            }
        }
    }
    if root.entry.kind == 2: Text {
        text: root.entry.name;
        font-size: Size.small;
        color: Theme.text-weak;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
    }
    if root.entry.kind == 4: HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.entry.name;
                font-size: Size.small;
                color: Theme.text-base;
                accessible-role: AccessibleRole.text;
            }
            if root.entry.value != "": Text {
                text: root.entry.value;
                font-size: Size.small;
                color: Theme.text-weak;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                background: Theme.surface-inset-base;
                border-radius: Size.radius + 2px;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    for option[index] in root.entry.options: ChoiceButton {
                        text: option;
                        label: root.entry.name + ": " + option;
                        selected: root.entry.setting == index;
                        clicked => { Logic.choose(root.entry.choice, index); }
                    }
                }
            }
        }
    }
    if root.entry.kind == 5: VerticalLayout {
        ThemeHeading {
            text: root.entry.name;
        }
        ThemeGrid {
            cards: root.entry.setting == 0 ? State.dark-theme-cards : State.light-theme-cards;
        }
    }
    if root.entry.kind == 3: HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.entry.name;
                font-size: Size.small;
                color: Theme.text-base;
                accessible-role: AccessibleRole.text;
            }
            Text {
                text: root.entry.value;
                font-size: Size.small;
                color: Theme.text-weak;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }
        VerticalLayout {
            alignment: center;
            Switch {
                on: root.entry.on;
                label: root.entry.name;
                toggled => { Logic.switch-setting(root.entry.setting); }
            }
        }
    }
}


/// A section in Settings' list.
component SectionButton inherits Press {
    in property <string> text;
    in property <string> glyph;
    height: 30px;
    label: root.text;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            text: root.glyph;
            font-size: 14px;
            color: root.selected ? Theme.accent-ink : Theme.icon-base;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: Size.small;
            color: root.selected ? Theme.text-strong : Theme.text-base;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
}

/// The page's title and its close button.
component SheetHead inherits HorizontalLayout {
    height: 52px;
    padding-left: 20px;
    padding-right: 12px;
    Text {
        horizontal-stretch: 1;
        text: State.sheet-title;
        font-size: 16px * Size.text-scale;
        font-weight: 600;
        color: Theme.text-strong;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: AccessibleRole.text;
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            label: "Close";
            glyph: Icons.close;
            clicked => { Logic.close-sheet(); }
        }
    }
}

/// The page's note and rows.
component SheetRows inherits VerticalLayout {
    spacing: 6px;
    if State.sheet-note != "": Text {
        text: State.sheet-note;
        font-size: Size.small;
        color: Theme.text-weak;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
    }
    VerticalLayout {
        spacing: 0;
        for entry in State.sheet-rows: Row {
            entry: entry;
        }
    }
}

/// Settings' search and its list of sections, under their groups.
component SectionList inherits Rectangle {
    // Under glass it lets the card's blur through.
    background: Theme.surface-inset-base.with-alpha(Theme.glass ? 0.5 : 1);

    VerticalLayout {
        padding: 12px;
        padding-top: 14px;
        spacing: 2px;

        Text {
            height: 26px;
            text: "Settings";
            font-size: 16px * Size.text-scale;
            font-weight: 600;
            color: Theme.text-strong;
            accessible-role: AccessibleRole.text;
        }
        Field {
            height: 32px;
            glyph: Icons.search;
            placeholder: "Search settings";
            fill: Theme.surface-raised-strong;
            text <=> State.settings-query;
            edited(text) => { Logic.settings-search(text); }
        }
        Rectangle { height: 8px; }

        for section[index] in State.settings-sections: VerticalLayout {
            if section.group != ""
                && (index == 0 || State.settings-sections[index - 1].group != section.group): Text {
                height: 28px;
                text: section.group;
                font-size: Size.small;
                color: Theme.text-weak;
                vertical-alignment: bottom;
                accessible-role: AccessibleRole.text;
            }
            if section.group == "" && index > 0
                && State.settings-sections[index - 1].group != "": Rectangle {
                height: 10px;
            }
            SectionButton {
                text: section.title;
                glyph: section.glyph;
                selected: State.settings-section == index && State.settings-query == "";
                clicked => { Logic.pick-section(index); }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

/// A range button on the stats page.
component RangeButton inherits Press {
    in property <string> text;
    height: 26px;
    label: root.text;
    rest: Theme.surface-inset-base;
    lit: Theme.selected-tint;

    Text {
        text: root.text;
        font-size: Size.small;
        color: root.selected ? Theme.text-strong : Theme.text-weak;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// The stats' range buttons, numbers and day bars.
component StatsHead inherits VerticalLayout {
    alignment: start;
    spacing: 16px;

    HorizontalLayout {
        alignment: start;
        spacing: 4px;
        for range[index] in ["Last 7 days", "Last 30 days", "All time"]: RangeButton {
            width: 96px;
            text: range;
            selected: State.stat-range == index;
            clicked => { Logic.stats-range(index); }
        }
    }

    if State.stat-tiles.length > 0: Rectangle {
        height: 2 * 58px + 8px;
        for tile[index] in State.stat-tiles: Rectangle {
            property <int> per-row: 4;
            x: mod(index, self.per-row) * (parent.width + 8px) / self.per-row;
            y: floor(index / self.per-row) * (58px + 8px);
            width: (parent.width + 8px) / self.per-row - 8px;
            height: 58px;
            border-radius: Size.radius;
            background: Theme.surface-inset-base;

            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                Text {
                    text: tile.value;
                    font-size: 18px * Size.text-scale;
                    font-weight: 600;
                    color: Theme.text-strong;
                    accessible-role: AccessibleRole.text;
                }
                Text {
                    text: tile.label;
                    font-size: Size.small;
                    color: Theme.text-weak;
                    accessible-role: AccessibleRole.text;
                }
            }
        }
    }

    if State.stat-days.length > 0: VerticalLayout {
        spacing: 6px;
        Text {
            text: "Model steps a day";
            font-size: Size.small;
            color: Theme.text-weak;
        }
        Rectangle {
            height: 56px;
            // A slot for each of the last 30 days, the newest at the right.
            for day in State.stat-days: Rectangle {
                property <length> slot: parent.width / 30;
                x: day.slot * self.slot;
                width: max(2px, self.slot - 3px);
                y: parent.height - self.height;
                height: max(2px, day.share * parent.height);
                border-radius: 2px;
                background: Theme.text-interactive-base;
                accessible-role: AccessibleRole.text;
                accessible-label: day.label;
            }
        }
    }
}

/// The card over the window, which it shades. The shade takes no clicks, so
/// the rail buttons at either edge still switch pages.
export component SheetLayer inherits Rectangle {
    background: Theme.scrim;

    // A click outside the card, between the rails, closes it.
    TouchArea {
        x: Size.rail;
        width: root.width - 2 * Size.rail;
        clicked => { Logic.close-sheet(); }
    }

    card := Rectangle {
        width: min(State.sheet == 2 ? 900px : 720px, root.width - 2 * Size.rail - 64px);
        height: min(State.sheet == 2 ? 640px : 680px, root.height - 96px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.card;
        backdrop-blur: Theme.card-blur;
        border-radius: Size.menu-radius;
        border-width: 1px;
        border-color: Theme.menu-edge;
        drop-shadow-color: #00000073;
        drop-shadow-offset-y: 10px;
        drop-shadow-blur: 28px;
        clip: true;

        // Clicks on the card stay on it.
        TouchArea { }

        if State.sheet == 1: VerticalLayout {
            SheetHead { }
            HLine { }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    padding: 20px;
                    padding-top: 4px;
                    spacing: 6px;
                    StatsHead { }
                    SheetRows { }
                }
            }
        }

        if State.sheet == 2: HorizontalLayout {
            SectionList {
                width: min(220px, card.width * 0.32);
            }
            VLine { }
            VerticalLayout {
                horizontal-stretch: 1;
                SheetHead { }
                HLine { }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding: 20px;
                        padding-top: 4px;
                        spacing: 6px;
                        SheetRows { }
                        // The last section, About, ends with Slint's notice.
                        if State.settings-section == State.settings-sections.length - 1
                            && State.settings-query == "": HorizontalLayout {
                            padding-top: 14px;
                            alignment: start;
                            AboutSlint { }
                        }
                    }
                }
            }
        }
    }
}
