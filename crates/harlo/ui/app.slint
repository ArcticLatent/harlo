// The main window: the rails, the sidebar, the center with the terminals
// under it, the tool panel on the right, and the popovers over them.

import { Palette } from "std-widgets.slint";
import { TerminalView } from "terminal.slint";
import { EditorView } from "editor.slint";
import { SheetLayer } from "sheets.slint";
import { Theme, Size, Fonts, Motion, Curves } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Logic, Requests, Keyboard, Content } from "data.slint";
import { LeftRail, RightRail } from "rails.slint";
import { Sidebar, Locations } from "sidebar.slint";
import { DocumentTabs, TerminalStrip, PanelFrame, Grip } from "frame.slint";
import { PanelBody } from "panels.slint";
import { Home } from "home.slint";
import { PickerMenu, Pickers } from "composer.slint";
import { SessionView } from "session.slint";

export { Theme, Size, Fonts, Motion, Icons, State, Logic, Requests }

/// A line of quiet text, for a tab with nothing to show yet.
component Quiet inherits Rectangle {
    in property <string> text;
    background: Theme.background-base;
    VerticalLayout {
        padding-top: 20px;
        padding-left: 18px;
        padding-right: 18px;
        alignment: start;
        Text {
            text: root.text;
            wrap: word-wrap;
            font-size: Size.label;
            color: Theme.text-base;
        }
    }
}

export component AppWindow inherits Window {
    title: "Harlo";
    preferred-width: 1588px;
    preferred-height: 947px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.background-base;

    /// Whether the desktop prefers dark colours; Harlo reads it at start,
    /// and is told when it changes. A desktop that doesn't say counts as
    /// dark.
    out property <bool> system-dark: Palette.color-scheme != ColorScheme.light;
    changed system-dark => {
        Logic.system-dark(self.system-dark);
    }

    /// How far the sidebar is open, from 0 to 1: it slides rather than
    /// jumping, and the space it takes follows it.
    property <float> sidebar-open: State.sidebar-shown ? 1 : 0;
    animate sidebar-open {
        duration: Motion.slide;
        easing: Curves.glide;
    }
    property <length> sidebar-room: State.sidebar-width * root.sidebar-open;

    /// How far the tool panel on the right is open, from 0 to 1, sliding
    /// as the sidebar does. A maximized panel covers the window instead,
    /// and takes no room here.
    property <float> panel-open: State.panel >= 0 ? 1 : 0;
    animate panel-open {
        duration: Motion.slide;
        easing: Curves.glide;
    }
    property <length> panel-room: State.maximized ? 0 : State.panel-width * root.panel-open;
    /// The panel shown: the open one, or the last one while it slides away.
    property <int> last-panel: -1;
    property <int> open-panel: State.panel;
    changed open-panel => {
        if self.open-panel >= 0 {
            self.last-panel = self.open-panel;
        }
    }
    property <int> shown-panel: State.panel >= 0 ? State.panel : root.last-panel;

    /// How far the terminals are open, from 0 to 1: they rise from the
    /// bottom rather than appearing at once.
    property <float> terminal-open: State.terminals-shown ? 1 : 0;
    animate terminal-open {
        duration: Motion.slide;
        easing: Curves.glide;
    }
    property <length> terminal-room: State.terminal-height * root.terminal-open;
    default-font-family: Fonts.sans;
    default-font-size: Size.text;
    // Keys reach the window's shortcuts even before a field is focused.
    forward-focus: keys;

    changed width => {
        Logic.resized(self.width, self.height);
    }
    changed height => {
        Logic.resized(self.width, self.height);
    }

    keys := FocusScope {
        // Window-wide keys go to Rust first; it takes only its shortcuts.
        capture-key-pressed(event) => {
            // A terminal with the keyboard gets Ctrl keys for its shell,
            // except the ones that switch tabs.
            if Keyboard.in-terminal && State.terminals-shown && event.modifiers.control
                    && event.text != Key.Tab && event.text != Key.Backtab
                    && event.text != Key.PageUp && event.text != Key.PageDown {
                return reject;
            }
            if (Logic.key(event.text, event.modifiers.control, event.modifiers.shift,
                    event.modifiers.alt)) {
                return accept;
            }
            reject
        }

        HorizontalLayout {
            LeftRail { }
            if State.sidebar-shown || root.sidebar-open > 0: Rectangle {
                width: root.sidebar-room;
                clip: true;
                Sidebar {
                    x: parent.width - self.width;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.background-base;
                clip: true;

                VerticalLayout {
                    DocumentTabs { }
                    Rectangle {
                        vertical-stretch: 1;
                        if State.content == Content.home: Home { }
                        if State.content == Content.session: SessionView { }
                        if State.content == Content.quiet: Quiet {
                            text: State.quiet;
                        }
                        if State.content == Content.editor: EditorView { }
                    }
                    // The strip keeps its full height as it rises, so the
                    // shell isn't resized on every frame of the slide.
                    if State.terminals-shown || root.terminal-open > 0: Rectangle {
                        height: root.terminal-room;
                        clip: true;
                        TerminalStrip {
                            y: 0;
                            width: parent.width;
                            height: State.terminal-height;
                            TerminalView { }
                        }
                    }
                }
            }
            // The panel keeps its full width as it slides, so its content
            // doesn't reflow on every frame.
            if (State.panel >= 0 || root.panel-open > 0) && !State.maximized: Rectangle {
                width: root.panel-room;
                clip: true;
                PanelFrame {
                    x: 0;
                    width: State.panel-width;
                    height: parent.height;
                    PanelBody {
                        panel: root.shown-panel;
                    }
                }
            }
            RightRail { }
        }

        // The edges to drag, over the lines between the parts.
        if State.sidebar-shown && !State.maximized: Grip {
            edge: 0;
            label: "Sidebar width";
            x: Size.rail + root.sidebar-room - self.width / 2;
            width: 7px;
            height: root.height;
        }
        if State.panel >= 0 && !State.maximized: Grip {
            edge: 1;
            label: "Panel width";
            x: root.width - Size.rail - root.panel-room - self.width / 2;
            width: 7px;
            height: root.height;
        }
        if State.terminals-shown && !State.maximized: Grip {
            edge: 2;
            across: true;
            label: "Terminal height";
            x: Size.rail + root.sidebar-room;
            y: root.height - root.terminal-room - self.height / 2;
            width: root.width - 2 * Size.rail - root.sidebar-room - root.panel-room;
            height: 7px;
        }

        // A maximized panel covers the space between the rails.
        if State.panel >= 0 && State.maximized: PanelFrame {
            x: Size.rail;
            width: root.width - 2 * Size.rail;
            height: root.height;
            PanelBody { }
        }

        if State.picking-location: Locations { }
        if State.picker >= 0 && State.picker < Pickers.first-in-settings: PickerMenu { }
        // Over the whole window; the rail buttons still switch pages.
        if State.sheet > 0: SheetLayer { }
        // Opened from Settings, so over it.
        if State.picker >= Pickers.first-in-settings: PickerMenu { }
    }
}

