// Cards above the composer for what the open session waits on: a staged
// undo to keep or cancel, an approval to allow or refuse, and questions to
// answer. The oldest of each shows; "1 of 3" says more are waiting.

import { Theme, Size, Fonts } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Logic, CardFile, Question, Answer } from "data.slint";
import { Icon, Press, Field, QuietScroll } from "widgets.slint";
import { Counts, PatchLine, Column } from "timeline.slint";

/// How the cards are laid out.
global Cards {
    out property <length> padding: 14px;
}

/// A raised card with an outline in its accent.
component Card inherits Rectangle {
    in property <color> edge;
    in property <length> gap: 10px;

    background: Theme.surface-raised-base;
    border-color: root.edge;
    border-width: 1px;
    border-radius: Size.composer-radius;
    drop-shadow-color: #00000033;
    drop-shadow-offset-y: 4px;
    drop-shadow-blur: 14px;

    VerticalLayout {
        padding: Cards.padding;
        spacing: root.gap;
        @children
    }
}

/// A card's button: filled when it's the main action, plain otherwise.
export component CardButton inherits Press {
    in property <string> text;
    in property <bool> main;
    /// Whether it does something that can't be taken back: plain, with its
    /// label in the critical colour.
    in property <bool> risky;
    /// The key that presses it, shown after the label; empty for none.
    in property <string> keys;

    height: 30px;
    label: root.text;
    rest: !root.main ? Theme.control-fill
        : root.enabled ? Theme.surface-brand-base : Theme.primary-off;
    hover: root.main ? Theme.surface-brand-hover : Theme.chip-hover;
    lit: root.hover;
    border-width: root.main ? 0px : 1px;
    border-color: root.risky ? Theme.risky-edge
        : root.hovered && root.enabled ? Theme.control-edge-hover : Theme.control-edge;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Size.label;
            color: root.main && !root.enabled ? Theme.text-weak
                : root.main ? Theme.text-on-brand-base
                : root.risky ? Theme.risky-ink : Theme.text-strong;
        }
        if root.keys != "": Text {
            text: root.keys;
            vertical-alignment: center;
            font-size: Size.small * 0.92;
            color: root.main ? Theme.text-on-brand-base.transparentize(0.3) : Theme.text-weaker;
        }
    }
}

/// A plain text button, in a weaker colour.
export component GhostButton inherits Press {
    in property <string> text;

    height: 30px;
    label: root.text;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Size.small;
            color: Theme.text-weak;
        }
    }
}

/// A card's heading: an icon, what's asked, and how many wait.
component Heading inherits HorizontalLayout {
    in property <string> glyph;
    in property <color> accent;
    in property <string> text;
    in property <int> count: 1;

    spacing: 10px;
    Icon {
        width: 16px;
        text: root.glyph;
        font-size: 15px;
        color: root.accent;
    }
    Text {
        text: root.text;
        horizontal-stretch: 1;
        vertical-alignment: center;
        wrap: word-wrap;
        font-size: Size.text;
        font-weight: 500;
        color: Theme.text-strong;
    }
    if root.count > 1: Text {
        text: "1 of \{root.count}";
        vertical-alignment: center;
        font-size: Size.small;
        color: Theme.text-weak;
    }
}

/// A file's name and counts over its first patch lines, and a warning.
component PatchView inherits VerticalLayout {
    in property <CardFile> file;

    spacing: 6px;
    HorizontalLayout {
        spacing: 8px;
        Icon {
            width: 14px;
            text: Icons.file;
            font-size: 13px;
            color: Theme.icon-quiet;
        }
        Text {
            text: root.file.name;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            font-family: Fonts.mono;
            font-size: Size.code;
            color: Theme.text-base;
        }
        Counts {
            added: root.file.added;
            removed: root.file.removed;
        }
    }
    Rectangle {
        background: Theme.surface-inset-base;
        border-radius: Size.radius;
        clip: true;
        VerticalLayout {
            padding-top: 5px;
            padding-bottom: 5px;
            for line in root.file.lines: PatchLine {
                line: line;
            }
            if root.file.more != "": HorizontalLayout {
                padding-left: Column.diff-digit * max(1, root.file.lines[0].digits) + 4px;
                padding-top: 4px;
                Text {
                    text: root.file.more;
                    font-size: Size.small;
                    color: Theme.text-weak;
                }
            }
        }
    }
    if root.file.warning != "": Text {
        text: root.file.warning;
        wrap: word-wrap;
        font-size: Size.small;
        color: Theme.icon-critical-base;
    }
}

/// A staged undo: what it put back, whose edits that overwrote, and Undo or
/// Cancel undo. Cancel undo is the main action, since Undo can't be taken back.
component UndoView inherits Card {
    edge: Theme.warning-edge;
    accessible-role: groupbox;
    accessible-label: State.undo-card.title;

    Heading {
        glyph: Icons.undo;
        accent: Theme.icon-warning-base;
        text: State.undo-card.title;
    }
    VerticalLayout {
        spacing: 4px;
        if State.undo-card.quote != "": Text {
            text: State.undo-card.quote;
            wrap: word-wrap;
            font-size: Size.label;
            color: Theme.text-weak;
        }
        Text {
            text: State.undo-card.note;
            wrap: word-wrap;
            font-size: Size.label;
            color: Theme.text-base;
        }
    }
    for file in State.undo-card.files: PatchView {
        file: file;
    }
    if State.undo-card.unchecked: Text {
        text: "Couldn't check this undo, so your own edits can't be told from the agent's.";
        wrap: word-wrap;
        font-size: Size.small;
        color: Theme.text-weak;
    }
    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        CardButton {
            text: "Cancel undo";
            main: true;
            enabled: !State.undo-card.busy;
            clicked => { Logic.undo-cancel(State.undo-card.session); }
        }
        CardButton {
            text: "Undo";
            risky: true;
            enabled: !State.undo-card.busy;
            clicked => { Logic.undo-keep(State.undo-card.session); }
        }
    }
}

/// An action the agent asks to take: allow it once or always, or refuse.
component ApprovalView inherits Card {
    property <bool> busy: State.approval-card.busy;
    property <string> id: State.approval-card.id;

    edge: Theme.warning-edge;
    accessible-role: groupbox;
    accessible-label: State.approval-card.title;

    Heading {
        glyph: Icons.shield-alert;
        accent: Theme.icon-warning-base;
        text: State.approval-card.title;
        count: State.approval-card.count;
    }
    if State.approval-card.detail != "": Rectangle {
        background: Theme.field-fill;
        border-radius: Size.radius;
        border-width: 1px;
        border-color: Theme.control-edge;
        HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            // A command reads as typed at a prompt.
            if State.approval-card.command: Text {
                text: "$";
                font-family: Fonts.mono;
                font-size: Size.code;
                color: Theme.text-weaker;
                accessible-role: none;
            }
            Text {
                horizontal-stretch: 1;
                text: State.approval-card.detail;
                wrap: word-wrap;
                font-family: Fonts.mono;
                font-size: Size.code;
                color: Theme.text-strong;
            }
        }
    }
    for file in State.approval-card.files: PatchView {
        file: file;
    }
    if State.approval-card.message != "": Text {
        text: State.approval-card.message;
        wrap: word-wrap;
        font-size: Size.small;
        color: Theme.text-base;
    }
    if !State.approval-card.refusing: HorizontalLayout {
        alignment: start;
        spacing: 8px;
        CardButton {
            text: "Allow once";
            keys: "Alt+A";
            main: true;
            enabled: !root.busy;
            clicked => { Logic.approve(root.id, 0); }
        }
        CardButton {
            text: State.approval-card.always;
            about: State.approval-card.always-note;
            enabled: !root.busy;
            clicked => { Logic.approve(root.id, 1); }
        }
        CardButton {
            text: "Deny";
            keys: "Alt+D";
            enabled: !root.busy;
            clicked => { Logic.approve(root.id, 2); }
        }
        GhostButton {
            text: "Deny with a reason…";
            enabled: !root.busy;
            clicked => { Logic.refuse(root.id); }
        }
    }
    if !State.approval-card.refusing: Text {
        text: State.approval-card.always-note;
        wrap: word-wrap;
        font-size: Size.small;
        color: Theme.text-weak;
    }
    if State.approval-card.refusing: HorizontalLayout {
        spacing: 8px;
        Field {
            // Refusing starts with the reason to type.
            init => { self.focus(); }
            height: 32px;
            horizontal-stretch: 1;
            text-size: Size.label;
            placeholder: State.approval-card.reason-hint;
            text: State.approval-card.reason;
            edited(text) => { Logic.refuse-reason(text); }
            accepted => {
                if !root.busy {
                    Logic.refuse-send();
                }
            }
        }
        CardButton {
            text: "Deny";
            main: true;
            enabled: !root.busy;
            clicked => { Logic.refuse-send(); }
        }
        CardButton {
            text: "Cancel";
            clicked => { Logic.refuse-cancel(); }
        }
    }
}

/// An option to pick: a mark, its name, and more about it.
component ChoiceRow inherits Press {
    in property <string> glyph;
    in property <string> text;
    in property <string> description;

    height: 30px;
    label: root.text;
    lit: Theme.selected-tint;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            width: 15px;
            text: root.glyph;
            font-size: 14px;
            color: root.selected ? Theme.text-interactive-base : Theme.icon-base;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Size.label;
            font-weight: 400;
            color: Theme.text-strong;
        }
        if root.description != "": Text {
            text: root.description;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            font-size: Size.small;
            color: Theme.text-weak;
        }
    }
}

/// One of the agent's questions and the controls that answer it.
component QuestionView inherits VerticalLayout {
    in property <Question> item;

    spacing: 6px;
    if root.item.title != "": Text {
        text: root.item.title;
        wrap: word-wrap;
        font-size: Size.label;
        font-weight: 500;
        color: Theme.text-strong;
    }
    if root.item.description != "": Text {
        text: root.item.description;
        wrap: word-wrap;
        font-size: Size.label;
        color: Theme.text-base;
    }
    for choice in root.item.choices: ChoiceRow {
        glyph: root.item.answer == Answer.many
            ? (choice.chosen ? Icons.square-check : Icons.square)
            : (choice.chosen ? Icons.circle-dot : Icons.circle);
        text: choice.label;
        description: choice.description;
        selected: choice.chosen;
        clicked => { Logic.form-choose(root.item.form, root.item.key, choice.value); }
    }
    if root.item.input: HorizontalLayout {
        alignment: root.item.answer == Answer.number ? start : stretch;
        Field {
            width: root.item.answer == Answer.number ? 160px : parent.width;
            height: 32px;
            text-size: Size.label;
            placeholder: root.item.hint;
            text: root.item.typed;
            edited(text) => { Logic.form-type(root.item.form, root.item.key, text); }
        }
    }
    if root.item.answer == Answer.yes-no: HorizontalLayout {
        alignment: start;
        spacing: 6px;
        ChoiceRow {
            glyph: root.item.flag == 1 ? Icons.circle-dot : Icons.circle;
            text: "Yes";
            selected: root.item.flag == 1;
            clicked => { Logic.form-flag(root.item.form, root.item.key, true); }
        }
        ChoiceRow {
            glyph: root.item.flag == 0 ? Icons.circle-dot : Icons.circle;
            text: "No";
            selected: root.item.flag == 0;
            clicked => { Logic.form-flag(root.item.form, root.item.key, false); }
        }
    }
    if root.item.answer == Answer.link: HorizontalLayout {
        alignment: start;
        spacing: 10px;
        CardButton {
            text: "Open link";
            clicked => { Logic.link(root.item.url); }
        }
        Text {
            text: root.item.url;
            vertical-alignment: center;
            overflow: elide;
            font-family: Fonts.mono;
            font-size: Size.small;
            color: Theme.text-weak;
        }
    }
    if root.item.problems != "": Text {
        text: root.item.problems;
        wrap: word-wrap;
        font-size: Size.small;
        color: Theme.icon-critical-base;
    }
}

/// The agent's questions, with Send and Dismiss. Only the questions scroll:
/// the buttons stay at the card's foot, however many questions there are.
component QuestionsView inherits Card {
    /// The most height the card may take.
    in property <length> room;
    property <bool> busy: State.question-card.busy;

    edge: Theme.question-edge;
    gap: 14px;
    accessible-role: groupbox;
    accessible-label: State.question-card.title;

    heading := Heading {
        glyph: Icons.question;
        accent: Theme.text-interactive-base;
        text: State.question-card.title;
        count: State.question-card.count;
    }
    QuietScroll {
        height: min(questions.preferred-height,
            max(80px, root.room - 2 * Cards.padding - 2 * root.gap
                - heading.preferred-height - actions.preferred-height));
        questions := VerticalLayout {
            width: parent.visible-width;
            spacing: 14px;
            for question in State.questions: QuestionView {
                item: question;
            }
        }
    }
    actions := HorizontalLayout {
        alignment: start;
        spacing: 8px;
        CardButton {
            text: "Send answer";
            main: true;
            enabled: !root.busy;
            clicked => { Logic.form-send(State.question-card.id); }
        }
        CardButton {
            text: "Dismiss";
            enabled: !root.busy;
            clicked => { Logic.form-dismiss(State.question-card.id); }
        }
    }
}

/// The cards for what the open session waits on, as tall as `room` allows,
/// scrolling past it.
export component WaitingCards inherits QuietScroll {
    /// The most height the cards may take.
    in property <length> room;

    height: min(cards.preferred-height, root.room);

    cards := VerticalLayout {
        width: root.visible-width;
        others := VerticalLayout {
            spacing: 8px;
            // The gap before the question card, only when there's a card
            // above it: an empty slot takes no room.
            padding-bottom: (State.undo-card.shown || State.approval-card.shown)
                && State.question-card.shown ? 8px : 0;
            if State.undo-card.shown: UndoView { }
            if State.approval-card.shown: ApprovalView { }
        }
        if State.question-card.shown: QuestionsView {
            room: root.room - others.preferred-height;
        }
    }
}
