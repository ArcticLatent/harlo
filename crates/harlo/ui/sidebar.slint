// The sidebar: logo, location, new session, filter, then projects and their
// sessions in one virtualized list.

import { ListView } from "std-widgets.slint";
import { Theme, Size, Fonts } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Logic, SidebarRow, RowKind } from "data.slint";
import { Icon, Press, Dot, Breathing, Spinner, Field, VLine, ProjectMark, QuietBar } from "widgets.slint";

/// Space between the sidebar's edge and its content.
global Inset {
    out property <length> side: 14px;
}

/// The tile showing who made a session's model: the maker's logo, or a
/// plain chip while the model isn't known or Harlo has no logo for it. It
/// never changes with what the session is doing: a badge on its corner
/// says when the session wants looking at.
component Maker inherits Rectangle {
    /// The logo's number, from 1 (`harlo_core::makers::LOGOS`), or 0.
    in property <int> maker;
    in property <color> tone;
    /// The session waits for an approval or an answer: the badge breathes.
    in property <bool> waiting;
    /// The session has an answer nobody has looked at: a steady badge.
    in property <bool> unread;
    /// What is behind the tile, which rings the badge.
    in property <color> behind;
    /// The logos, in `LOGOS`' order.
    property <[image]> logos: [
        @image-url("images/providers/anthropic.svg"),
        @image-url("images/providers/openai.svg"),
        @image-url("images/providers/zai-coding-plan.svg"),
        @image-url("images/providers/claude-code.svg"),
        @image-url("images/providers/google.svg"),
        @image-url("images/providers/xai.svg"),
        @image-url("images/providers/deepseek.svg"),
        @image-url("images/providers/mistral.svg"),
        @image-url("images/providers/minimax-coding-plan.svg"),
        @image-url("images/providers/kimi-for-coding.svg"),
        @image-url("images/providers/groq.svg"),
        @image-url("images/providers/cerebras.svg"),
        @image-url("images/providers/together.svg"),
        @image-url("images/providers/fireworks.svg"),
        @image-url("images/providers/openrouter.svg"),
        @image-url("images/providers/opencode.svg"),
    ];
    width: 18px;
    height: 26px;

    if root.maker == 0: Icon {
        text: Icons.cpu;
        font-size: 15px;
        color: Theme.icon-quiet;
    }
    if root.maker > 0 && root.maker <= root.logos.length: Image {
        width: 15px;
        height: 15px;
        source: root.logos[root.maker - 1];
        colorize: root.tone;
    }
    // On the logo's lower right corner, mostly beside it, and ringed so
    // it reads over any logo.
    if root.waiting || root.unread: Rectangle {
        x: parent.width - 6px;
        y: parent.height - self.height;
        width: 10px;
        height: 10px;
        border-radius: self.width / 2;
        background: root.behind;
        if root.waiting: Breathing {
            Dot {
                size: 7px;
                background: Theme.icon-warning-base;
            }
        }
        if !root.waiting: Dot {
            size: 7px;
            background: Theme.accent-ink;
            accessible-role: image;
            accessible-label: "New answer";
        }
    }
}

/// The working indicator.
component Working inherits Spinner { }

/// One row of the list.
/// The accent bar at the left edge of the selected session's row.
component SelectedBar inherits Rectangle {
    x: 0;
    y: 8px;
    width: 3px;
    border-radius: 1.5px;
    background: Theme.accent-ink;
}

component Item inherits Rectangle {
    in property <SidebarRow> entry;

    height: entry.kind == RowKind.project ? 36px + (entry.gap ? 13px : 0)
        : entry.kind == RowKind.session ? 42px + (entry.gap ? 13px : 0)
        : 30px + (entry.gap ? 13px : 0);

    VerticalLayout {
        padding-left: Inset.side;
        padding-right: Inset.side;
        alignment: start;

        // Hovering the row shows its settings button.
        if entry.kind == RowKind.project: project-hover := TouchArea {
            height: 36px;
            HorizontalLayout {
                height: 36px;
                padding-left: 4px;
                padding-right: 4px;
                spacing: 9px;
                VerticalLayout {
                    alignment: center;
                    if !entry.other: ProjectMark {
                        picture: entry.picture;
                        colored: entry.colored;
                        tint: entry.tone;
                    }
                    // Sessions started without a project: not a folder.
                    if entry.other: Icon {
                        width: 16px;
                        height: 16px;
                        text: Icons.message-square;
                        font-size: 14px;
                        color: Theme.brand-ink;
                    }
                }
                Text {
                    text: entry.title;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: Size.label;
                    color: Theme.brand-ink.mix(Theme.text-base, 0.55);
                }
                // Its count stays still while a session works: the
                // session's own row says so.
                Text {
                    text: entry.detail;
                    vertical-alignment: center;
                    font-size: Size.small;
                    color: Theme.text-weaker;
                }
                // Shown while the pointer is over the row; the group of
                // sessions without a project has no settings.
                if !entry.other: Press {
                    width: 22px;
                    label: "Settings for " + entry.title;
                    opacity: project-hover.has-hover ? 1 : 0;
                    clicked => { Logic.project-settings(entry.id); }
                    Icon {
                        text: Icons.settings;
                        font-size: 13px;
                        color: Theme.icon-quiet;
                    }
                }
                Press {
                    width: 22px;
                    label: entry.other ? "New session without a project" : "New session in " + entry.title;
                    clicked => { Logic.new-session(entry.id); }
                    Icon {
                        text: Icons.plus;
                        font-size: 15px;
                    }
                }
            }
        }

        if entry.kind == RowKind.session: Press {
            height: 42px;
            label: entry.title;
            selected: entry.selected;
            lit: Theme.selected-tint;
            clicked => { Logic.open-session(entry.id); }
            if entry.selected: SelectedBar {
                height: parent.height - 16px;
            }
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 10px;
                alignment: stretch;
                VerticalLayout {
                    alignment: center;
                    Maker {
                        maker: entry.maker;
                        tone: entry.tone;
                        waiting: entry.waiting;
                        unread: entry.unread;
                        behind: Theme.background-stronger;
                    }
                }
                Text {
                    text: entry.title;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: Size.text;
                    // An answer not looked at yet stands out, as unread mail does.
                    font-weight: entry.unread ? 600 : 400;
                    color: entry.untitled ? Theme.text-weaker
                        : entry.selected || entry.unread ? Theme.text-strong : Theme.text-weak;
                }
                // Runs without asking: marked beside what it's doing.
                if entry.trusted: Icon {
                    text: Icons.shield-off;
                    color: Theme.icon-warning-base;
                    accessible-role: image;
                    accessible-label: "Don't ask";
                }
                if entry.waiting: Icon {
                    text: entry.asking ? Icons.circle-question : Icons.shield-alert;
                    color: entry.asking ? Theme.accent-ink : Theme.icon-warning-base;
                    accessible-role: image;
                    accessible-label: entry.asking ? "Asks a question" : "Waits for approval";
                }
                if entry.busy && !entry.waiting: Working { }
                if !entry.busy && !entry.waiting: Text {
                    text: entry.detail;
                    vertical-alignment: center;
                    font-size: Size.small * 0.92;
                    color: Theme.text-weaker;
                }
            }
        }

        if entry.kind == RowKind.more: HorizontalLayout {
            height: 30px;
            padding-left: 16px;
            alignment: start;
            Press {
                label: entry.title;
                clicked => { Logic.toggle-more(entry.id); }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: entry.title;
                        vertical-alignment: center;
                        font-size: Size.small;
                        color: Theme.text-weak;
                    }
                }
            }
        }
    }
}

/// The whole sidebar.
export component Sidebar inherits Rectangle {
    width: State.sidebar-width;
    background: Theme.background-stronger;

    HorizontalLayout {
        VerticalLayout {
            // The header.
            VerticalLayout {
                padding-top: 10px;
                padding-left: Inset.side;
                padding-right: Inset.side;
                padding-bottom: 7px;

                HorizontalLayout {
                    height: 40px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        // Harlo's theme shows the logo's own colours; any
                        // other theme tints its halves with its brand and
                        // interactive colours.
                        Rectangle {
                            width: 23px;
                            height: 24px;
                            if Theme.own-logo: Image {
                                width: 100%;
                                height: 100%;
                                source: @image-url("images/logo-mark.svg");
                                accessible-role: none;
                            }
                            if !Theme.own-logo: Image {
                                width: 100%;
                                height: 100%;
                                source: @image-url("images/logo-mark-left.svg");
                                colorize: Theme.brand-ink;
                                accessible-role: none;
                            }
                            if !Theme.own-logo: Image {
                                width: 100%;
                                height: 100%;
                                source: @image-url("images/logo-mark-right.svg");
                                colorize: Theme.accent-ink;
                                accessible-role: none;
                            }
                        }
                    }
                    Text {
                        text: "Harlo";
                        vertical-alignment: center;
                        font-size: Size.wordmark;
                        font-weight: 600;
                        color: Theme.text-strong;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Press {
                            label: "Add a project";
                            rest: Theme.control-fill;
                            outlined: true;
                            clicked => { Logic.add-project(); }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 9px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 5px;
                                Icon {
                                    text: Icons.plus;
                                    font-size: 11px;
                                    color: Theme.icon-quiet;
                                }
                                Text {
                                    text: "Project";
                                    font-size: Size.small;
                                    color: Theme.text-base;
                                    accessible-role: none;
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 6px; }

                // Which server Harlo follows, and how that's going.
                Press {
                    height: 31px;
                    label: "Location: " + State.location-label;
                    rest: Theme.control-fill;
                    outlined: true;
                    selected: State.picking-location;
                    clicked => { Logic.toggle-locations(); }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 7px;
                        VerticalLayout {
                            alignment: center;
                            Dot {
                                background: State.status-color;
                            }
                        }
                        Icon {
                            text: State.location-glyph;
                            font-size: 13px;
                        }
                        Text {
                            text: State.location-label;
                            horizontal-stretch: 1;
                            overflow: elide;
                            vertical-alignment: center;
                            font-size: Size.label;
                            color: Theme.text-strong;
                        }
                        Icon {
                            text: Icons.chevron-down;
                            font-size: 13px;
                        }
                    }
                }

                Rectangle { height: 14px; }

                Press {
                    height: 34px;
                    label: "New session";
                    clicked => { Logic.new-session(""); }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Icon {
                            text: Icons.new-session;
                            font-size: 17px;
                            color: Theme.text-strong;
                        }
                        Text {
                            text: "New session";
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            font-size: Size.text;
                            color: Theme.text-base;
                        }
                        Text {
                            text: "Ctrl+N";
                            vertical-alignment: center;
                            font-size: Size.small;
                            color: Theme.text-weaker;
                        }
                    }
                }

                Rectangle { height: 12px; }

                Field {
                    height: 36px;
                    glyph: Icons.search;
                    placeholder: "Filter sessions";
                    edited(text) => { Logic.filter-edited(text); }
                }
            }

            if State.sidebar-notice != "": VerticalLayout {
                padding-top: 12px;
                padding-left: Inset.side + 4px;
                padding-right: Inset.side + 4px;
                vertical-stretch: 1;
                alignment: start;
                Text {
                    text: State.sidebar-notice;
                    wrap: word-wrap;
                    font-size: Size.label;
                    color: Theme.text-weak;
                }
            }

            if State.sidebar-notice == "": Rectangle {
                vertical-stretch: 1;
                sessions := ListView {
                    width: parent.width;
                    height: parent.height;
                    vertical-scrollbar-policy: always-off;
                    for row in State.sidebar-rows: Item {
                        entry: row;
                    }
                }
                QuietBar {
                    x: parent.width - self.width;
                    height: parent.height;
                    content-y <=> sessions.content-y;
                    content-height: sessions.content-height;
                    visible-height: sessions.visible-height;
                }
            }
        }
        VLine { }
    }
}

/// The location picker: which server Harlo follows, and how the
/// connection stands. Clicking outside it closes it.
export component Locations inherits Rectangle {
    TouchArea {
        clicked => { Logic.toggle-locations(); }
    }

    card := Rectangle {
        x: Size.rail + Inset.side;
        y: 91px;
        width: Size.sidebar - 2 * Inset.side;
        height: content.preferred-height;
        background: Theme.card;
        backdrop-blur: Theme.card-blur;
        border-radius: Size.menu-radius;
        border-width: 1px;
        border-color: Theme.menu-edge;
        drop-shadow-color: #00000073;
        drop-shadow-offset-y: 10px;
        drop-shadow-blur: 28px;

        // Clicks on the card stay on it.
        TouchArea { }

        content := VerticalLayout {
            padding: 6px;
            spacing: 6px;

            VerticalLayout {
                spacing: 2px;
                for location[index] in State.locations: Press {
                    label: location.label;
                    clicked => { Logic.pick-location(index); }
                    HorizontalLayout {
                        padding: 8px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        spacing: 9px;
                        Icon {
                            width: 14px;
                            text: location.current ? Icons.check : "";
                            color: Theme.icon-selected;
                        }
                        Icon {
                            text: location.glyph;
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: location.label;
                                font-size: Size.label;
                                color: Theme.text-strong;
                            }
                            Text {
                                text: location.detail;
                                font-size: 11.5px * Size.text-scale;
                                color: Theme.text-weak;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.menu-edge;
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 8px;
                VerticalLayout {
                    padding-top: 5px;
                    alignment: start;
                    Dot {
                        background: State.status-color;
                    }
                }
                Text {
                    text: State.status-text;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                    font-size: Size.small;
                    color: Theme.text-base;
                }
            }
        }
    }
}
