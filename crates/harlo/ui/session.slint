// An open session: its header, the timeline, the lines above the composer
// (what the agent does, its todos, subagents, queued prompts), and the
// composer.

import { Theme, Size } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Logic, Requests, InboxRow } from "data.slint";
import { Icon, Press, HLine, Breathing, ErrorLine } from "widgets.slint";
import { Composer, PickerChip } from "composer.slint";
import { Timeline, TimelineScrollbar, PromptRail } from "timeline.slint";
import { WaitingCards } from "waiting.slint";

/// The Changes panel's number, as Rust's `panel_number` gives it.
global Panels {
    out property <int> todos: 1;
    out property <int> changes: 2;
}

/// A small text button, in the link colour.
component Action inherits Press {
    in property <string> text;

    height: 20px;
    label: root.text;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Size.small;
            color: Theme.text-interactive-base;
        }
    }
}

/// A thin bar showing how much of a list is done.
component Progress inherits Rectangle {
    in property <int> done;
    in property <int> total;

    width: 48px;
    height: 4px;
    border-radius: 2px;
    background: Theme.surface-raised-strong;
    Rectangle {
        x: 0;
        width: root.total > 0 ? parent.width * root.done / root.total : 0;
        border-radius: 2px;
        background: Theme.icon-success-base;
    }
}

/// One line above the composer.
component InboxLine inherits Rectangle {
    in property <InboxRow> item;

    height: 30px;
    // What the agent does is a bare line; the rest are boxed.
    background: root.item.kind == 0 ? transparent : Theme.surface-raised-base;
    border-radius: Size.radius;

    HorizontalLayout {
        padding-left: root.item.kind == 0 ? 4px : 12px;
        padding-right: root.item.kind == 0 ? 4px : 8px;
        spacing: 8px;

        if root.item.working && root.item.kind == 0: Breathing {
            width: 14px;
            Icon {
                text: root.item.glyph;
                font-size: 13px;
                color: root.item.glyph-color;
            }
        }
        if !root.item.working || root.item.kind != 0: Icon {
            width: 14px;
            text: root.item.glyph;
            font-size: 13px;
            color: root.item.glyph-color;
        }
        if root.item.strong != "": Text {
            text: root.item.strong;
            vertical-alignment: center;
            font-size: Size.small;
            font-weight: 500;
            color: Theme.text-strong;
        }
        if root.item.kind == 1: VerticalLayout {
            alignment: center;
            Progress {
                done: root.item.done;
                total: root.item.total;
            }
        }
        Text {
            text: root.item.text;
            vertical-alignment: center;
            horizontal-stretch: root.item.detail == "" ? 1 : 0;
            overflow: elide;
            font-size: Size.small;
            color: Theme.text-base;
        }
        if root.item.detail != "": Text {
            text: root.item.detail;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: Size.small;
            color: Theme.text-weak;
        }
        if root.item.working && root.item.note != "": Breathing {
            Text {
                text: root.item.note;
                vertical-alignment: center;
                font-size: Size.small;
                color: root.item.note-color;
            }
        }
        if !root.item.working && root.item.note != "": Text {
            text: root.item.note;
            vertical-alignment: center;
            font-size: Size.small;
            color: root.item.note-color;
        }
        if root.item.action != "": VerticalLayout {
            alignment: center;
            Action {
                text: root.item.action;
                clicked => {
                    if root.item.kind == 1 {
                        Logic.open-panel(Panels.todos);
                    } else if root.item.kind == 2 {
                        Logic.open-session(root.item.id);
                    } else {
                        Logic.steer-queued(root.item.id);
                    }
                }
            }
        }
        if root.item.cancel: VerticalLayout {
            alignment: center;
            Press {
                label: "Cancel";
                width: 20px;
                height: 20px;
                clicked => { Logic.cancel-queued(root.item.id); }
                Icon {
                    text: Icons.close;
                    font-size: 12px;
                }
            }
        }
    }
}

/// The session's title, then its agent and model, and a way to its changes.
component Header inherits Rectangle {
    in property <length> column;

    height: body.preferred-height;

    body := HorizontalLayout {
        padding-top: 14px;
        padding-bottom: 14px;
        padding-left: (root.width - root.column) / 2;
        padding-right: (root.width - root.column) / 2;
        spacing: 16px;

        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            alignment: center;

            if State.session-parent != "": HorizontalLayout {
                alignment: start;
                Press {
                    label: "Subagent of \{State.session-parent}";
                    height: 18px;
                    clicked => { Logic.open-session(State.session-parent-id); }
                    HorizontalLayout {
                        spacing: 5px;
                        Icon {
                            text: Icons.arrow-left;
                            font-size: 12px;
                            color: Theme.text-interactive-base;
                        }
                        Text {
                            text: "Subagent of \{State.session-parent}";
                            vertical-alignment: center;
                            overflow: elide;
                            font-size: Size.small;
                            color: Theme.text-interactive-base;
                        }
                    }
                }
            }
            Text {
                text: State.session-title;
                overflow: elide;
                font-size: Size.session-title;
                font-weight: 600;
                color: Theme.text-strong;
            }
            HorizontalLayout {
                spacing: 7px;
                alignment: start;
                Icon {
                    text: State.session-agent-glyph;
                    font-size: 13px;
                    color: State.session-agent-color;
                }
                if State.session-agent != "": Text {
                    text: State.session-agent;
                    font-size: Size.small;
                    color: Theme.text-weak;
                }
                if State.session-read-only: Text {
                    text: "read-only";
                    font-size: Size.small;
                    color: Theme.text-weaker;
                }
                if State.session-model != "": Text {
                    text: State.session-model;
                    font-size: Size.small;
                    color: Theme.text-weak;
                }
                // Running without asking is said where the session is named,
                // not only in the composer.
                if State.session-trusted: HorizontalLayout {
                    spacing: 4px;
                    Icon {
                        text: Icons.shield-off;
                        font-size: 12px;
                        color: Theme.icon-warning-base;
                    }
                    Text {
                        text: "Don't ask";
                        font-size: Size.small;
                        color: Theme.icon-warning-base;
                    }
                }
                // Only the icon breathes: the word stays readable throughout.
                if State.session-busy: HorizontalLayout {
                    spacing: 5px;
                    Breathing {
                        Icon {
                            text: Icons.loader;
                            font-size: 12px;
                            color: Theme.text-interactive-base;
                        }
                    }
                    Text {
                        text: "Working";
                        font-size: Size.small;
                        color: Theme.text-base;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Press {
                label: "Changes";
                height: 28px;
                clicked => { Logic.open-panel(Panels.changes); }
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    Text {
                        text: "Changes";
                        vertical-alignment: center;
                        font-size: Size.label;
                        color: Theme.text-base;
                    }
                }
            }
        }
    }
}

/// An open session.
/// A round button over the timeline's foot that goes back to the end.
component JumpToEnd inherits Press {
    width: 34px;
    height: 34px;
    border-radius: self.height / 2;
    label: "Jump to the end";
    rest: Theme.menu-edge;
    hover: Theme.menu-edge.mix(Theme.icon-selected, 0.88);
    lit: Theme.menu-edge.mix(Theme.icon-selected, 0.78);
    border-width: 1px;
    border-color: Theme.border-base;
    drop-shadow-color: #00000066;
    drop-shadow-offset-y: 2px;
    drop-shadow-blur: 10px;

    Icon {
        text: Icons.arrow-down;
        font-size: 16px;
        color: Theme.accent-ink;
    }
}

export component SessionView inherits Rectangle {
    property <length> column: timeline.column;

    background: Theme.background-base;

    // Rust asks for the end when a prompt is sent.
    property <int> scroll-serial: Requests.scroll-serial;
    changed scroll-serial => {
        if Requests.scroll == "timeline" {
            timeline.to-end();
        }
    }
    // Another session opens at its end, however far up the last was read.
    property <string> session: State.session-id;
    changed session => {
        timeline.to-end();
    }

    follow := Timer {
        interval: 0ms;
        running: false;
        triggered => {
            self.running = false;
            timeline.catch-up();
        }
    }

    VerticalLayout {
        header := Header {
            column: root.column;
        }
        HLine { }
        timeline := Timeline {
            vertical-stretch: 1;
            end-moved => {
                follow.running = true;
            }
        }
        HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 16px;
            alignment: center;
            VerticalLayout {
                width: root.column;
                spacing: 4px;
                if State.undo-card.shown || State.approval-card.shown || State.question-card.shown: VerticalLayout {
                    padding-bottom: 4px;
                    // What the header, the composer, the gaps around them
                    // (about 40px) and a strip of the timeline (120px)
                    // leave free.
                    WaitingCards {
                        room: max(160px, root.height - header.preferred-height
                            - composer.preferred-height - 160px);
                    }
                }
                for row in State.inbox: InboxLine {
                    item: row;
                }
                Rectangle { height: 4px; }
                composer := Composer {
                    placeholder: State.session-placeholder;
                    busy: State.session-busy;
                    for chip in State.chips: VerticalLayout {
                        alignment: center;
                        PickerChip {
                            chip: chip;
                            compact: true;
                            // Below this the names push Send out of the box.
                            bare: root.column < 500px;
                        }
                    }
                }
                if State.send-error != "": ErrorLine {
                    text: State.send-error;
                }
            }
        }
    }

    // The overlays below are always there and only shown or hidden: they
    // depend on the timeline's height, which settles over several rounds
    // as the list measures its rows, and creating or removing an element
    // in each round would make Slint lay out again and again.

    // The rail sits in the space right of the column, which narrows for it.
    PromptRail {
        visible: timeline.railed && timeline.shown < 1;
        x: timeline.x + (timeline.width + root.column) / 2
            + ((timeline.width - root.column) / 2 - 16px - self.width) / 2;
        y: timeline.y + 24px;
        height: timeline.height - 48px;
        reading-row: timeline.reading-row;
        fraction: timeline.fraction;
        jump(row) => { timeline.jump-to(row); }
    }

    TimelineScrollbar {
        visible: timeline.shown < 1;
        x: timeline.x + timeline.width - self.width;
        y: timeline.y;
        height: timeline.height;
        fraction: timeline.fraction;
        shown: timeline.shown;
        scroll-to(fraction) => { timeline.scroll-to(fraction); }
        page(direction) => { timeline.page(direction); }
    }

    // Shown once the reader has scrolled away from the end.
    JumpToEnd {
        visible: !timeline.following && timeline.content-height > timeline.visible-height;
        x: (root.width - self.width) / 2;
        y: timeline.y + timeline.height - self.height - 12px;
        clicked => { timeline.to-end(); }
    }
}
