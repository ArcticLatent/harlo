// Small parts the window is built from: icons, pressable surfaces, lines,
// a breathing indicator, a fading error line and a one-line text field.

import { Theme, Size, Fonts, Motion, Curves } from "theme.slint";
import { Icons } from "icons.slint";
import { Tips } from "data.slint";

/// A button's name, shown above or below it once the pointer rests on it,
/// with the keys that do the same. Put it inside the button and pass the
/// button's state; it takes no room.
export component HoverTip {
    in property <string> text;
    in property <string> keys;
    in property <bool> hovered;
    in property <bool> pressed;
    /// Whether it opens above the button rather than below.
    in property <bool> above;
    /// The button's place in the window and its size.
    in property <length> button-x;
    in property <length> button-y;
    in property <length> button-width;
    in property <length> button-height;
    /// Pressed since the pointer came: the name stays away until it leaves.
    property <bool> quiet;
    width: 0;
    height: 0;

    changed hovered => {
        if !self.hovered {
            root.quiet = false;
            if Tips.text == root.text {
                Tips.text = "";
            }
        }
    }
    changed pressed => {
        if self.pressed {
            root.quiet = true;
            if Tips.text == root.text {
                Tips.text = "";
            }
        }
    }
    Timer {
        interval: Motion.tip-delay;
        running: root.hovered && !root.quiet && root.text != "" && Tips.text != root.text;
        triggered => {
            Tips.keys = root.keys;
            Tips.leftward = false;
            Tips.above = root.above;
            Tips.below = !root.above;
            Tips.x = root.button-x + root.button-width / 2;
            Tips.y = root.above ? root.button-y - 6px : root.button-y + root.button-height + 6px;
            Tips.text = root.text;
        }
    }
}

/// A Lucide icon: set `text` to one of `Icons`' glyphs.
export component Icon inherits Text {
    font-family: Icons.font;
    font-size: 14px;
    color: Theme.icon-base;
    horizontal-alignment: center;
    vertical-alignment: center;
    accessible-role: none;
}

/// A project's mark: the icon image chosen for it, or a folder, in its
/// colour when it has one.
export component ProjectMark inherits Rectangle {
    in property <image> picture;
    in property <bool> colored;
    in property <color> tint;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;

    if root.picture.width > 0: Image {
        width: root.size;
        height: root.size;
        source: root.picture;
        image-fit: contain;
        accessible-role: none;
    }
    if root.picture.width == 0: Icon {
        width: root.size;
        height: root.size;
        text: Icons.folder-open;
        font-size: root.size * 0.9;
        color: root.colored ? root.tint : Theme.brand-ink;
    }
}

/// A file-type icon from the bundled font.
export component FileIcon inherits Text {
    font-family: Fonts.file-icons;
    font-size: 14px;
    horizontal-alignment: center;
    vertical-alignment: center;
    accessible-role: none;
}

/// A surface that reacts to the pointer and can be pressed; its children
/// draw on top. `rest` and `hover` are its fills; `selected` holds it lit.
export component Press inherits Rectangle {
    in property <string> label;
    /// More about it, for screen readers: what it shows beside its label.
    in property <string> about;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <brush> rest: transparent;
    in property <brush> hover: Theme.surface-base-hover;
    in property <brush> lit: Theme.surface-base-active;
    /// Drawn as an outlined control: a faint fill inside a thin outline
    /// that brightens under the pointer.
    in property <bool> outlined;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    callback clicked();
    /// Pressed with the right button, for a second action.
    callback right-clicked();

    border-radius: Size.radius;
    background: root.selected || (touch.pressed && root.enabled) ? root.lit
        : touch.has-hover && root.enabled ? root.hover : root.rest;
    border-width: root.outlined ? 1px : 0px;
    border-color: touch.has-hover && root.enabled ? Theme.control-edge-hover : Theme.control-edge;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.about;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.right-clicked();
            }
        }
    }

    @children
}

/// A square button holding one icon.
export component IconButton inherits Press {
    in property <string> glyph;
    in property <length> glyph-size: 14px;
    in property <color> glyph-color: Theme.icon-base;
    /// Its name, shown under it when the pointer rests on it; its label
    /// unless set, and none when empty.
    in property <string> tip: self.label;
    in property <string> keys;

    width: 26px;
    height: 26px;

    HoverTip {
        text: root.tip;
        keys: root.keys;
        hovered: root.hovered;
        pressed: root.pressed;
        button-x: root.absolute-position.x;
        button-y: root.absolute-position.y;
        button-width: root.width;
        button-height: root.height;
    }

    Icon {
        text: root.glyph;
        font-size: root.glyph-size;
        color: root.glyph-color;
    }
}

/// A one pixel line across.
export component HLine inherits Rectangle {
    height: 1px;
    background: Theme.border-weak-base;
}

/// A one pixel line down.
export component VLine inherits Rectangle {
    width: 1px;
    background: Theme.border-weak-base;
}

/// A round dot.
export component Dot inherits Rectangle {
    in property <length> size: 7px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
}

/// Children that fade in and out, slowly, while something works.
///
/// Every breathing indicator keeps time with the same clock, so they
/// breathe together.
export component Breathing inherits Rectangle {
    opacity: Motion.breath-low + (1 - Motion.breath-low)
        * (0.5 - 0.5 * cos(animation-tick() / Motion.breath * 360deg));
    @children
}

/// The working spinner: an open circle that turns, the one sign of work in
/// progress everywhere. With motion off it holds still.
export component Spinner inherits Rectangle {
    in property <length> size: 13px;
    in property <color> tint: Theme.accent-ink;
    /// One turn, at the designed speed.
    property <float> turn-ms: 900;

    width: root.size + 2px;
    min-height: root.size + 2px;
    accessible-role: none;

    Rectangle {
        width: root.size;
        height: root.size;
        transform-rotation: Motion.speed > 0
            ? Math.mod(animation-tick() / 1ms, root.turn-ms) / root.turn-ms * 360deg : 0deg;
        Icon {
            text: Icons.loader;
            font-size: root.size;
            color: root.tint;
        }
    }
}

/// A line that fades in, rising a little, when it first shows and again
/// whenever its text changes, so a new error catches the eye.
export component ErrorLine inherits Rectangle {
    in property <string> text;
    property <float> shown: 0;
    // Lets a changed text start the fade again from nothing.
    property <bool> jump;
    animate shown {
        duration: Motion.appear;
        easing: Curves.settle;
        enabled: !root.jump;
    }
    init => {
        root.shown = 1;
    }
    changed text => {
        root.jump = true;
        root.shown = 0;
        root.jump = false;
        root.shown = 1;
    }

    height: line.preferred-height + Motion.rise / 2;
    line := Text {
        y: (1 - root.shown) * Motion.rise / 2;
        width: parent.width;
        text: root.text;
        wrap: word-wrap;
        font-size: Size.small;
        color: Theme.icon-critical-base;
        opacity: root.shown;
    }
}

/// A one-line text field with a placeholder and an optional leading icon.
export component Field inherits Rectangle {
    in property <string> placeholder;
    /// What screen readers call the field; the placeholder when empty.
    in property <string> label;
    in property <string> glyph;
    in property <brush> fill: Theme.field-fill;
    in property <brush> idle-edge: Theme.control-edge;
    in property <length> text-size: Size.text;
    /// Hides what's typed, as for a token.
    in property <bool> secret;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted();

    forward-focus: input;

    border-radius: Size.radius;
    background: root.fill;
    border-width: 1px;
    border-color: input.has-focus ? Theme.border-interactive-focus : root.idle-edge;
    min-height: 34px;
    accessible-role: none;

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 9px;

        if root.glyph != "": Icon {
            text: root.glyph;
            font-size: 15px;
            color: Theme.icon-quiet;
        }

        Rectangle {
            horizontal-stretch: 1;

            Text {
                x: 0;
                width: 100%;
                text: root.placeholder;
                visible: input.text == "";
                color: Theme.text-weaker;
                font-size: root.text-size;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }

            input := TextInput {
                width: 100%;
                single-line: true;
                input-type: root.secret ? InputType.password : InputType.text;
                vertical-alignment: center;
                color: Theme.text-strong;
                font-size: root.text-size;
                selection-background-color: Theme.selection;
                accessible-label: root.label != "" ? root.label : root.placeholder;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
        }
    }
}

/// An on/off switch, labelled for screen readers and tests.
export component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled();

    width: 34px;
    height: 20px;
    border-radius: self.height / 2;
    background: root.on ? Theme.surface-interactive-base : Theme.control-edge-hover;
    animate background { duration: Motion.appear; easing: Curves.settle; }
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-label: root.label;
    accessible-action-default => { root.toggled(); }

    Rectangle {
        width: parent.height - 4px;
        height: self.width;
        y: 2px;
        x: root.on ? parent.width - self.width - 2px : 2px;
        animate x { duration: Motion.appear; easing: Curves.settle; }
        border-radius: self.height / 2;
        background: root.on ? Theme.text-on-interactive-base : Theme.text-weak;
    }

    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }
}
