// The narrow icon rails on the window's left and right edges.

import { Theme, Size, Motion } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Logic, Tips } from "data.slint";
import { Icon, Press, VLine } from "widgets.slint";

/// A square rail button. Its name shows beside it when the pointer rests
/// on it, with the keys that do the same.
component RailButton inherits Press {
    in property <string> glyph;
    in property <string> keys;
    /// Whether the name opens to the left, from the right rail.
    in property <bool> leftward;
    width: Size.rail-button;
    height: Size.rail-button;

    changed hovered => {
        if !self.hovered && Tips.text == root.label {
            Tips.text = "";
        }
    }
    Timer {
        interval: Motion.tip-delay;
        running: root.hovered && Tips.text != root.label;
        triggered => {
            Tips.keys = root.keys;
            Tips.leftward = root.leftward;
            Tips.x = root.leftward ? root.absolute-position.x - 6px
                : root.absolute-position.x + root.width + 6px;
            Tips.y = root.absolute-position.y + root.height / 2;
            Tips.text = root.label;
        }
    }

    Icon {
        text: root.glyph;
        font-size: Size.rail-icon;
        // An open panel's button takes the accent; the phone placeholder,
        // shown as on but not yet working, stays plain.
        color: root.selected && root.enabled ? Theme.accent-ink
            : root.selected ? Theme.icon-selected : Theme.icon-base;
    }
}

/// The left rail: the sidebar toggle, then the phone link, shortcuts,
/// stats, settings and the avatar.
export component LeftRail inherits Rectangle {
    // Settings showing its Shortcuts section lights the keyboard button.
    property <bool> shortcuts-shown: State.sheet == 2 && State.settings-section == State.shortcuts-section
        && State.settings-query == "";
    property <bool> phone-shown: State.sheet == 2 && State.settings-section == State.phone-section
        && State.settings-query == "";
    width: Size.rail;
    background: Theme.background-stronger;

    HorizontalLayout {
        VerticalLayout {
            width: Size.rail - 1px;
            padding-top: 11px;
            padding-bottom: 11px;
            spacing: 8px;
            alignment: stretch;

            HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: Icons.sidebar;
                    label: "Toggle sidebar";
                    clicked => { Logic.toggle-sidebar(); }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: center;
                // Opens Settings → Phone, and shows as on while it's there.
                RailButton {
                    glyph: Icons.phone;
                    label: "Phone";
                    selected: root.phone-shown;
                    clicked => { Logic.open-section(State.phone-section); }
                }
            }
            HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: Icons.keyboard;
                    label: "Keyboard shortcuts";
                    selected: root.shortcuts-shown;
                    clicked => { Logic.open-section(State.shortcuts-section); }
                }
            }
            HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: Icons.stats;
                    label: "Stats";
                    selected: State.sheet == 1;
                    clicked => { Logic.toggle-sheet(1); }
                }
            }
            HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: Icons.settings;
                    label: "Settings";
                    keys: "Ctrl+,";
                    selected: State.sheet == 2 && !root.shortcuts-shown && !root.phone-shown;
                    clicked => { Logic.toggle-sheet(2); }
                }
            }

            Rectangle {
                height: Size.rail-button + 8px;
                // Unplaced, it sits in the middle.
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    clip: true;
                    accessible-role: image;
                    accessible-label: "You";
                    Image {
                        width: 100%;
                        height: 100%;
                        source: @image-url("images/avatar-penguin.png");
                        image-fit: cover;
                    }
                }
            }
        }
        VLine { }
    }
}

/// A rail button's name, beside it; see `Tips`.
export component RailTip inherits Rectangle {
    width: row.preferred-width;
    height: row.preferred-height;
    x: Tips.leftward ? Tips.x - self.width : Tips.x;
    y: Tips.y - self.height / 2;
    background: Theme.card;
    border-radius: Size.radius;
    border-width: 1px;
    border-color: Theme.menu-edge;
    drop-shadow-color: #00000059;
    drop-shadow-offset-y: 4px;
    drop-shadow-blur: 14px;

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        // The button already carries the name for screen readers.
        Text {
            text: Tips.text;
            font-size: Size.label;
            color: Theme.text-strong;
            accessible-role: none;
        }
        if Tips.keys != "": Text {
            text: Tips.keys;
            font-size: Size.small;
            color: Theme.text-weak;
            accessible-role: none;
        }
    }
}

/// The right rail: one button per tool panel, and the terminal at the bottom.
export component RightRail inherits Rectangle {
    width: Size.rail;
    background: Theme.background-stronger;

    HorizontalLayout {
        VLine { }
        VerticalLayout {
            width: Size.rail - 1px;
            padding-top: 11px;
            padding-bottom: 11px;
            spacing: 8px;

            for panel[index] in [
                { glyph: Icons.context, label: "Context" },
                { glyph: Icons.todos, label: "Todos" },
                { glyph: Icons.changes, label: "Changes" },
                { glyph: Icons.files, label: "Files" },
                { glyph: Icons.notes, label: "Notes" },
            ]: HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: panel.glyph;
                    label: panel.label;
                    leftward: true;
                    selected: State.panels-shown[index];
                    clicked => { Logic.toggle-panel(index); }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: Icons.terminal;
                    label: "Terminal";
                    leftward: true;
                    selected: State.terminals-shown;
                    clicked => { Logic.toggle-terminal(); }
                }
            }
        }
    }
}
