// The narrow icon rails on the window's left and right edges.

import { Theme, Size, Motion } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Logic, Tips, MeterRow } from "data.slint";
import { Icon, Press, VLine, HLine, Ring, Makers } from "widgets.slint";

/// The avatars to pick from, in the order of `AVATARS` in Rust.
export global Avatars {
    /// For the picker; twice the size they're drawn at, for dense screens.
    out property <[image]> pictures: [
        @image-url("images/avatars/penguin-classic-128.png"),
        @image-url("images/avatars/penguin-beanie-128.png"),
        @image-url("images/avatars/penguin-glasses-128.png"),
        @image-url("images/avatars/penguin-headphones-128.png"),
        @image-url("images/avatars/penguin-jacket-128.png"),
        @image-url("images/avatars/penguin-scarf-128.png"),
    ];
    /// For the rail, likewise.
    out property <[image]> small: [
        @image-url("images/avatars/penguin-classic-64.png"),
        @image-url("images/avatars/penguin-beanie-64.png"),
        @image-url("images/avatars/penguin-glasses-64.png"),
        @image-url("images/avatars/penguin-headphones-64.png"),
        @image-url("images/avatars/penguin-jacket-64.png"),
        @image-url("images/avatars/penguin-scarf-64.png"),
    ];
    out property <[string]> names: ["Classic", "Beanie", "Glasses", "Headphones", "Jacket", "Scarf"];
}

/// A round avatar, ringed when it's the one in use.
component AvatarFace inherits Rectangle {
    in property <image> picture;
    in property <bool> ringed;
    in property <length> side: 32px;
    width: root.side;
    height: root.side;
    border-radius: root.side / 2;
    border-width: root.ringed ? 2px : 0;
    border-color: Theme.border-interactive-focus;

    // The pictures are round already, with soft edges, inside a margin of
    // 6 of every 256 pixels; drawn a little larger, their circle fills the
    // face. A rounded clip would cut a hard, stepped edge instead.
    property <length> face: root.width - (root.ringed ? 8px : 0);
    Image {
        width: root.face * 256 / 244;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        source: root.picture;
        image-fit: contain;
    }
}

/// A square rail button. Its name shows beside it when the pointer rests
/// on it, with the keys that do the same.
component RailButton inherits Press {
    in property <string> glyph;
    in property <string> keys;
    /// What its name beside it says; its label unless set.
    in property <string> tip: self.label;
    /// A small amber pause mark on its corner.
    in property <bool> paused;
    /// A number on its corner, when above 0.
    in property <int> count;
    /// Whether the name opens to the left, from the right rail.
    in property <bool> leftward;
    /// Pressed since the pointer came: its name stays away until it leaves.
    property <bool> quiet;
    width: Size.rail-button;
    height: Size.rail-button;
    hover: Theme.selected-tint.mix(Theme.background-stronger, 0.6);
    lit: Theme.selected-tint;

    changed hovered => {
        if !self.hovered {
            root.quiet = false;
            if Tips.text == root.tip {
                Tips.text = "";
            }
        }
    }
    // Once it's pressed, the panel or page it opens matters more.
    changed pressed => {
        if self.pressed {
            root.quiet = true;
            if Tips.text == root.tip {
                Tips.text = "";
            }
        }
    }
    Timer {
        interval: Motion.tip-delay;
        running: root.hovered && !root.quiet && Tips.text != root.tip;
        triggered => {
            Tips.keys = root.keys;
            Tips.leftward = root.leftward;
            Tips.above = false;
            Tips.below = false;
            Tips.x = root.leftward ? root.absolute-position.x - 6px
                : root.absolute-position.x + root.width + 6px;
            Tips.y = root.absolute-position.y + root.height / 2;
            Tips.text = root.tip;
        }
    }

    Icon {
        text: root.glyph;
        font-size: Size.rail-icon;
        // An open panel's button takes the accent; the phone placeholder,
        // shown as on but not yet working, stays plain.
        color: (root.selected || root.hovered) && root.enabled ? Theme.accent-ink
            : root.selected ? Theme.icon-selected : Theme.icon-base;
    }
    if root.count > 0: Rectangle {
        x: parent.width - self.width - 2px;
        y: 2px;
        width: max(14px, badge.preferred-width + 6px);
        height: 14px;
        border-radius: 7px;
        background: Theme.surface-interactive-base;
        badge := Text {
            text: root.count;
            font-size: 9px;
            font-weight: 600;
            color: Theme.text-on-interactive-base;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.paused: Rectangle {
        x: parent.width - self.width - 3px;
        y: parent.height - self.height - 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.icon-warning-base;
        border-width: 2px;
        border-color: Theme.background-stronger;
        for bar in 2: Rectangle {
            x: (parent.width - 6px) / 2 + bar * 4px;
            y: (parent.height - 6px) / 2;
            width: 2px;
            height: 6px;
            background: Theme.on-warning;
        }
    }
    @children
}

/// A maker's logo in its tone, or a plain chip where Harlo has none.
component MakerLogo inherits Rectangle {
    /// The logo's number, from 1, or 0.
    in property <int> maker;
    in property <color> tone;
    in property <length> side: 14px;
    width: root.side;
    height: root.side;
    if root.maker == 0 || root.maker > Makers.logos.length: Icon {
        text: Icons.cpu;
        font-size: root.side;
        color: Theme.icon-quiet;
    }
    if root.maker > 0 && root.maker <= Makers.logos.length: Image {
        width: root.side;
        height: root.side;
        source: Makers.logos[root.maker - 1];
        colorize: root.tone;
    }
}

/// The colour of a limit's use: the accent with plenty left, amber
/// getting close, red nearly or fully used.
global Levels {
    pure public function tint(level: int) -> color {
        level >= 2 ? Theme.icon-critical-base : level == 1 ? Theme.icon-warning-base : Theme.accent-ink
    }
}

/// A row of the usage meter's menu: a name, a few quiet characters after
/// it, and a check when it's the choice.
component MeterItem inherits Press {
    in property <string> name;
    in property <string> hint;
    in property <bool> marked;
    /// A logo before the name, by its number from 1; -1 for none.
    in property <int> maker: -1;
    in property <color> tone;
    height: Size.menu-row;
    label: root.name;
    about: root.hint;
    accessible-checked: root.marked;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.maker >= 0: VerticalLayout {
            alignment: center;
            MakerLogo {
                maker: root.maker;
                tone: root.tone;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.name;
            vertical-alignment: center;
            overflow: elide;
            font-size: Size.text;
            color: Theme.text-strong;
        }
        Text {
            text: root.hint;
            vertical-alignment: center;
            font-size: Size.small;
            color: Theme.text-weak;
        }
        Icon {
            width: 14px;
            text: root.marked ? Icons.check : "";
            font-size: 13px;
            color: Theme.accent-ink;
        }
    }
}

/// The left rail: the sidebar toggle, then the phone link, shortcuts,
/// stats, settings and the avatar.
export component LeftRail inherits Rectangle {
    // Settings showing its Shortcuts section lights the keyboard button.
    property <bool> shortcuts-shown: State.sheet == 2 && State.settings-section == State.shortcuts-section
        && State.settings-query == "";
    property <bool> phone-shown: State.sheet == 2 && State.settings-section == State.phone-section
        && State.settings-query == "";
    width: Size.rail;
    background: Theme.background-stronger;

    HorizontalLayout {
        VerticalLayout {
            width: Size.rail - 1px;
            padding-top: 11px;
            padding-bottom: 11px;
            spacing: 8px;
            alignment: stretch;

            HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: Icons.sidebar;
                    label: "Toggle sidebar";
                    clicked => { Logic.toggle-sidebar(); }
                }
            }

            Rectangle { vertical-stretch: 1; }

            // How much of a provider's limits is used: the one pinned from
            // its menu, else the one used last. A ring where the provider
            // tells of a limit, its logo alone where it tells of none.
            if State.meter-shown: HorizontalLayout {
                alignment: center;
                meter := RailButton {
                    width: Size.rail-button + 8px;
                    height: 52px;
                    label: "Usage";
                    about: State.meter-tip;
                    tip: State.meter-tip;
                    clicked => { usage.show(); }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                if State.meter-ringed: Ring {
                                    fraction: State.meter-fraction;
                                    tint: Levels.tint(State.meter-level);
                                }
                                MakerLogo {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    side: State.meter-ringed ? 13px : 18px;
                                    maker: State.meter-maker;
                                    tone: State.meter-tone;
                                }
                            }
                        }
                        Text {
                            text: State.meter-label;
                            horizontal-alignment: center;
                            font-size: 10px;
                            color: State.meter-level >= 2 ? Theme.icon-critical-base : Theme.text-weak;
                        }
                    }

                    // Hangs right of the rail, level with the meter, and stays
                    // inside the window.
                    usage := PopupWindow {
                        x: root.absolute-position.x + Size.rail + 6px - meter.absolute-position.x;
                        y: clamp(meter.absolute-position.y, root.absolute-position.y + 8px,
                            root.absolute-position.y + root.height - self.height - 8px)
                            - meter.absolute-position.y;
                        width: 280px;
                        height: rows.preferred-height;
                        close-policy: close-on-click-outside;

                        Rectangle {
                            background: Theme.card;
                            border-radius: Size.menu-radius;
                            border-width: 1px;
                            border-color: Theme.menu-edge;
                            drop-shadow-color: #00000073;
                            drop-shadow-offset-y: 10px;
                            drop-shadow-blur: 28px;
                        }
                        rows := VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 10px;
                                spacing: 9px;
                                Text {
                                    text: State.meter-name;
                                    font-size: Size.text;
                                    font-weight: 600;
                                    color: Theme.text-strong;
                                    overflow: elide;
                                }
                                for line in State.meter-lines: VerticalLayout {
                                    spacing: 5px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: line.label;
                                            font-size: Size.small;
                                            color: Theme.text-base;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: line.value;
                                            horizontal-alignment: right;
                                            overflow: elide;
                                            font-size: Size.small;
                                            color: line.level >= 2 ? Theme.icon-critical-base : Theme.text-weak;
                                        }
                                    }
                                    Rectangle {
                                        height: 3px;
                                        border-radius: 1.5px;
                                        background: Theme.border-weak-base;
                                        if line.fraction > 0: Rectangle {
                                            x: 0;
                                            width: max(parent.height, parent.width * min(1, line.fraction));
                                            border-radius: parent.border-radius;
                                            background: Levels.tint(line.level);
                                        }
                                    }
                                }
                                if State.meter-note != "": Text {
                                    text: State.meter-note;
                                    wrap: word-wrap;
                                    font-size: Size.small;
                                    color: Theme.text-weak;
                                }
                            }
                            HLine { }
                            MeterItem {
                                name: "Last used";
                                hint: State.meter-last;
                                marked: State.meter-follows;
                                clicked => {
                                    Logic.pin-meter("");
                                    usage.close();
                                }
                            }
                            if State.meter-rows.length > 0: HLine { }
                            for row in State.meter-rows: MeterItem {
                                name: row.name;
                                hint: row.hint;
                                marked: row.pinned;
                                maker: row.maker;
                                tone: row.tone;
                                clicked => {
                                    Logic.pin-meter(row.id);
                                    usage.close();
                                }
                            }
                            HLine { }
                            if State.meter-manage != "": MeterItem {
                                name: "Manage usage…";
                                clicked => {
                                    Logic.link(State.meter-manage);
                                    usage.close();
                                }
                            }
                            MeterItem {
                                name: "All limits…";
                                clicked => {
                                    Logic.open-section(State.providers-section);
                                    usage.close();
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                // With a phone paired, a click pauses or resumes its
                // notifications; otherwise, and on a right-click, it opens
                // Settings → Phone, shown as on while it's there.
                RailButton {
                    glyph: Icons.phone;
                    label: State.phone-paired ? "Phone notifications" : "Phone";
                    about: !State.phone-paired ? "" : State.phone-paused ? "Paused" : "On";
                    tip: !State.phone-paired ? "Phone: pair a device"
                        : State.phone-paused
                        ? "Phone notifications paused. Click to resume. Right-click to pair a device."
                        : "Phone notifications on. Click to pause. Right-click to pair a device.";
                    paused: State.phone-paired && State.phone-paused;
                    selected: root.phone-shown;
                    clicked => {
                        if State.phone-paired {
                            Logic.toggle-phone-pause();
                        } else {
                            Logic.open-section(State.phone-section);
                        }
                    }
                    right-clicked => { Logic.open-section(State.phone-section); }
                }
            }
            HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: Icons.keyboard;
                    label: "Keyboard shortcuts";
                    selected: root.shortcuts-shown;
                    clicked => { Logic.open-section(State.shortcuts-section); }
                }
            }
            HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: Icons.stats;
                    label: "Stats";
                    selected: State.sheet == 1;
                    clicked => { Logic.toggle-sheet(1); }
                }
            }
            HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: Icons.settings;
                    label: "Settings";
                    keys: "Ctrl+,";
                    selected: State.sheet == 2 && !root.shortcuts-shown && !root.phone-shown;
                    clicked => { Logic.toggle-sheet(2); }
                }
            }

            HorizontalLayout {
                alignment: center;
                me := Press {
                    width: Size.rail-button;
                    height: Size.rail-button;
                    border-radius: self.height / 2;
                    label: "Your avatar";
                    about: Avatars.names[State.avatar];
                    clicked => { picker.show(); }
                    AvatarFace {
                        picture: Avatars.small[State.avatar];
                    }
                }
            }
        }
        VLine { }
    }

    // Hangs right of the rail, its foot level with the avatar's.
    picker := PopupWindow {
        x: Size.rail + 6px;
        y: me.absolute-position.y - root.absolute-position.y + me.height - self.height;
        width: grid.preferred-width;
        height: grid.preferred-height;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.card;
            border-radius: Size.menu-radius;
            border-width: 1px;
            border-color: Theme.menu-edge;
            drop-shadow-color: #00000073;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 28px;
        }
        grid := VerticalLayout {
            padding: 14px;
            spacing: 12px;
            Text {
                text: "Your avatar";
                font-size: Size.text;
                font-weight: 600;
                color: Theme.text-strong;
            }
            for row in 2: HorizontalLayout {
                spacing: 12px;
                for column in 3: Press {
                    property <int> index: row * 3 + column;
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    label: Avatars.names[self.index];
                    selected: self.index == State.avatar;
                    lit: transparent;
                    accessible-role: radio-button;
                    accessible-checked: self.selected;
                    clicked => {
                        Logic.pick-avatar(self.index);
                        picker.close();
                    }
                    AvatarFace {
                        side: 64px;
                        picture: Avatars.pictures[parent.index];
                        ringed: parent.selected;
                    }
                }
            }
        }
    }
}

/// A button's name, beside a rail button or over or under one in a row;
/// see `Tips`.
export component RailTip inherits Rectangle {
    /// The window's width, which a centred tip stays inside.
    in property <length> room;
    property <bool> centred: Tips.above || Tips.below;
    width: row.preferred-width;
    height: row.preferred-height;
    // Centred over or under a button in a row, kept inside the window.
    x: root.centred ? clamp(Tips.x - self.width / 2, 4px, root.room - self.width - 4px)
        : Tips.leftward ? Tips.x - self.width : Tips.x;
    y: Tips.above ? Tips.y - self.height : Tips.below ? Tips.y : Tips.y - self.height / 2;
    background: Theme.card;
    border-radius: Size.radius;
    border-width: 1px;
    border-color: Theme.menu-edge;
    drop-shadow-color: #00000059;
    drop-shadow-offset-y: 4px;
    drop-shadow-blur: 14px;

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        // The button already carries the name for screen readers.
        Text {
            text: Tips.text;
            font-size: Size.label;
            color: Theme.text-strong;
            accessible-role: none;
        }
        if Tips.keys != "": Text {
            text: Tips.keys;
            font-size: Size.small;
            color: Theme.text-weak;
            accessible-role: none;
        }
    }
}

/// The right rail: one button per tool panel, and the terminal at the bottom.
export component RightRail inherits Rectangle {
    width: Size.rail;
    background: Theme.background-stronger;

    HorizontalLayout {
        VLine { }
        VerticalLayout {
            width: Size.rail - 1px;
            padding-top: 11px;
            padding-bottom: 11px;
            spacing: 8px;

            for panel[index] in [
                { glyph: Icons.context, label: "Context" },
                { glyph: Icons.todos, label: "Todos" },
                { glyph: Icons.bot, label: "Subagents" },
                { glyph: Icons.changes, label: "Changes" },
                { glyph: Icons.files, label: "Files" },
                { glyph: Icons.notes, label: "Notes" },
                { glyph: Icons.aside, label: "Side questions" },
            ]: HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: panel.glyph;
                    label: panel.label;
                    leftward: true;
                    selected: State.panels-shown[index];
                    // Subagents counts those at work; Side questions those
                    // still being answered.
                    count: index == 2 ? State.subagents-working : index == 6 ? State.asides-waiting : 0;
                    clicked => { Logic.toggle-panel(index); }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: center;
                RailButton {
                    glyph: Icons.terminal;
                    label: "Terminal";
                    leftward: true;
                    selected: State.terminals-shown;
                    clicked => { Logic.toggle-terminal(); }
                }
            }
        }
    }
}
