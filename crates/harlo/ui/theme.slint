// The theme: colours set from the app's theme tokens, and the design's sizes
// and fonts.

import "fonts/Geist-Regular.ttf";
import "fonts/Geist-Medium.ttf";
import "fonts/Geist-SemiBold.ttf";
import "fonts/Geist-Bold.ttf";
import "fonts/Geist-Italic.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/FileIcons.ttf";

/// Colours, from the theme's tokens; Rust sets them when the theme loads.
export global Theme {
    in property <color> background-base: #101010;
    in property <color> background-stronger: #0a0a0a;
    in property <color> surface-inset-base: #161616;
    in property <color> surface-raised-base: #1c1c1c;
    in property <color> surface-raised-strong: #242424;
    in property <color> surface-base-hover: #ffffff10;
    in property <color> surface-base-active: #ffffff18;
    in property <color> surface-brand-base: #fab283;
    in property <color> border-weaker-base: #ffffff0c;
    in property <color> border-weak-base: #ffffff14;
    in property <color> border-base: #ffffff20;
    in property <color> text-strong: #ededed;
    in property <color> text-base: #c8c8c8;
    in property <color> text-weak: #8f8f8f;
    in property <color> text-weaker: #6a6a6a;
    in property <color> text-interactive-base: #9dbefe;
    in property <color> icon-base: #c8c8c8;
    /// Secondary icons, faint but readable; see `quiet_icon` in Rust.
    in property <color> icon-quiet: #8f8f8f;
    in property <color> icon-selected: #ededed;
    in property <color> icon-success-base: #12c905;
    in property <color> icon-warning-base: #fcd53a;
    in property <color> icon-critical-base: #fc533a;
    in property <color> icon-info-base: #9dbefe;
    in property <color> surface-brand-hover: #f9a46d;
    in property <color> surface-interactive-base: #3a5a9e;
    in property <color> surface-interactive-hover: #4568b0;
    in property <color> surface-interactive-weak: #22324f;
    in property <color> text-on-brand-base: #000000;
    in property <color> text-on-interactive-base: #ffffff;
    in property <color> border-interactive-base: #3a5a9e;
    in property <color> border-interactive-hover: #4568b0;
    in property <color> border-interactive-focus: #5b80cf;
    /// The brand colour as text and icons, such as a project's name, and
    /// the accent as icons and accent lines, such as the open tab's
    /// underline; see `ink` in Rust.
    in property <color> brand-ink: #fab283;
    in property <color> accent-ink: #5b80cf;
    /// Links in answers.
    in property <color> link-ink: #9dbefe;
    /// Whether the logo shows its own colours (Harlo's themes), rather than
    /// the theme's brand and accent colours.
    in property <bool> own-logo: true;

    // Mixed from the tokens above.
    /// A chip's fill under the pointer.
    in property <color> chip-hover: #2e2e2e;
    /// The outline of a menu card.
    in property <color> menu-edge: #393939;
    /// The outline of the composer.
    in property <color> composer-edge: #2e3440;
    /// Selected text's highlight.
    in property <color> selection: #9dbefe4c;
    /// The tint under an added diff line, and under a removed one.
    in property <color> added-line: #172a16;
    in property <color> removed-line: #3a1b17;
    /// Behind the selected item, such as the open session: a soft wash of
    /// the interactive colour.
    in property <color> selected-tint: #2a3550;
    /// The main button's fill while it can't be pressed.
    in property <color> primary-off: #5d5d5d;
    /// The outline of a card asking for approval, and of one asking questions.
    in property <color> warning-edge: #6b5426;
    /// A button's label for an action that can't be taken back, readable
    /// on the button.
    in property <color> risky-ink: #ffb1b2;
    /// Marks on an amber badge, such as the phone's pause.
    in property <color> on-warning: #000000;
    in property <color> question-edge: #4b5a78;
    /// The shade over the window behind a dialog: lighter on a light theme.
    in property <color> scrim: #00000066;
    /// Added and removed lines and counts in diffs.
    in property <color> added-ink: #6ce78a;
    in property <color> removed-ink: #ffb1b2;

    /// Whether menus and dialogs are glass: translucent, blurring what's
    /// under them (Skia only; elsewhere they're just translucent).
    in property <bool> glass: false;
    /// A menu's or dialog's fill, and how much it blurs what's under it.
    out property <color> card: root.glass ? root.surface-raised-strong.with-alpha(0.7)
        : root.surface-raised-strong;
    out property <length> card-blur: root.glass ? 24px : 0px;
}

/// Sizes in logical pixels, measured from the design.
///
/// Text sizes follow the scales chosen in Settings → Appearance: the
/// interface's and the chat's text, and code's.
export global Size {
    /// How much larger or smaller than designed text is, and code.
    in property <float> text-scale: 1;
    in property <float> code-scale: 1;
    /// The widest the chat's column gets.
    in property <length> chat-width: 780px;
    /// Width of the left and right rails.
    out property <length> rail: 56px;
    /// Width of the sidebar.
    out property <length> sidebar: 288px;
    /// A square rail button.
    out property <length> rail-button: 36px;
    /// Rail icons.
    out property <length> rail-icon: 18px;
    /// Body text.
    out property <length> text: 14px * root.text-scale;
    /// Prompts and answers in the timeline.
    out property <length> answer: 14.5px * root.text-scale;
    /// Code, paths and commands.
    out property <length> code: 12.5px * root.code-scale;
    /// Secondary text.
    out property <length> small: 12.5px * root.text-scale;
    /// Project names and hints.
    out property <length> label: 13px * root.text-scale;
    /// The wordmark beside the logo.
    out property <length> wordmark: 27px;
    /// Panel titles.
    out property <length> title: 19px * root.text-scale;
    /// The open session's title.
    out property <length> session-title: 18.5px * root.text-scale;
    /// Height of a tab strip.
    out property <length> tab-bar: 34px;
    /// The empty state's question.
    out property <length> headline: 26px * root.text-scale;
    /// Corner radius of buttons and fields.
    out property <length> radius: 6px;
    /// Corner radius of the composer.
    out property <length> composer-radius: 8px;
    /// Corner radius of a menu card.
    out property <length> menu-radius: 10px;
    /// Height of a picker menu row.
    out property <length> menu-row: 32px;
    /// What a menu row with a line under its name adds to `menu-row`.
    out property <length> two-line-extra: 16px;
}

/// Font families.
export global Fonts {
    /// The interface font.
    out property <string> sans: "Geist";
    /// Code, paths and commands.
    out property <string> mono: "JetBrains Mono";
    /// File-type icons.
    out property <string> file-icons: "Harlo File Icons";
}

/// Motion: short and quiet. It confirms that something happened (a prompt
/// went out, a file was attached, the sidebar opened) or that work is going
/// on, and never delays anything.
export global Motion {
    /// How long motion takes as a share of its design, from Settings →
    /// Appearance; 0 turns it off.
    in property <float> speed: 1;
    /// How long something new takes to fade in, and how far it rises.
    out property <duration> appear: 220ms * root.speed;
    out property <length> rise: 8px;
    /// How long the sidebar takes to slide open or closed.
    out property <duration> slide: 200ms * root.speed;
    /// How long the pointer rests on a rail button before its name shows.
    /// A wait, not motion, so the motion setting leaves it alone.
    out property <duration> tip-delay: 450ms;
    /// A whole breath of work in progress, dim to bright and back; slow
    /// enough to read as breathing rather than blinking.
    out property <duration> breath: 1800ms;
    /// The dimmest a breathing indicator gets; with motion off it stays
    /// lit.
    out property <float> breath-low: root.speed > 0 ? 0.35 : 1;
}

/// Motion's easing curves. They're kept apart from [`Motion`], which Rust
/// sets, because Slint can't hand `easing` properties to Rust.
export global Curves {
    /// Something new slows as it settles: an ease-out cubic.
    out property <easing> settle: cubic-bezier(0.33, 1, 0.68, 1);
    /// A slide speeds up, then slows: an ease-in-out cubic.
    out property <easing> glide: cubic-bezier(0.65, 0, 0.35, 1);
}
