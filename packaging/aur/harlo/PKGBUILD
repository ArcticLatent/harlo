# Maintainer: ArcticLatent <17465603+ArcticLatent@users.noreply.github.com>
#
# Builds a harlo release from source, against Arch's own Qt:
#   cd packaging/aur/harlo && makepkg -si
# (For a release: set pkgver, then `updpkgsums`.)

pkgname=harlo
pkgver=1.0.0
pkgrel=1
pkgdesc="Desktop app for coding agents: Harlo (its own) and Claude Code"
arch=('x86_64' 'aarch64')
url="https://harlo.run"
license=('MIT' 'OFL-1.1')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-svg' 'git' 'gcc-libs' 'glibc')
# cmake and clang build the bundled whisper.cpp (dictation).
makedepends=('cargo' 'cmake' 'clang' 'curl')
optdepends=('layer-shell-qt: drop-down window on Wayland'
            'libnotify: desktop notifications (notify-send)'
            'openssh: projects on remote machines (Settings → Remote Instances)')
# The C++ parts (cxx-qt) must stay plain object code: with makepkg's LTO
# flags they become GCC bytecode that Rust's linker cannot read.
options=('!lto')
conflicts=('harlo-git' 'harlo-bin')
source=("harlo-$pkgver.tar.gz::https://github.com/ArcticLatent/harlo/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "harlo-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
    # (The static copy for other machines, when Rust has musl here.)
    if [ -d "$(rustc --print target-libdir --target x86_64-unknown-linux-musl 2>/dev/null)" ]; then
        cargo fetch --locked --target x86_64-unknown-linux-musl
    fi
}

build() {
    cd "harlo-$pkgver"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target QMAKE=qmake6
    cargo build --frozen --release -p harlo-app
    cargo build --frozen --release -p harlo-core --bin harlo-engines --no-default-features
    cargo build --frozen --profile agent -p harlo-agent
    # Its copy for other machines: static (musl), so it runs whatever C
    # library they have. Without Rust's musl target here, Harlo isn't
    # offered on other machines.
    if [ -d "$(rustc --print target-libdir --target x86_64-unknown-linux-musl 2>/dev/null)" ]; then
        CC_x86_64_unknown_linux_musl=gcc cargo build --frozen --profile agent -p harlo-agent --target x86_64-unknown-linux-musl
    fi
    # OpenWiki, which keeps a project's wiki: its pinned Node and package
    # (downloaded and checked against their checksums).
    packaging/openwiki/fetch.sh target/openwiki
}

check() {
    cd "harlo-$pkgver"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target QMAKE=qmake6
    cargo test --frozen --release -p harlo-core -p harlo-harness
}

package() {
    cd "harlo-$pkgver"
    install -Dm755 target/release/harlo "$pkgdir/usr/bin/harlo"
    # (What harlo puts on another machine to run model servers there.)
    install -Dm755 target/release/harlo-engines "$pkgdir/usr/lib/harlo/harlo-engines"
    # (Harlo, harlo's own agent.)
    install -Dm755 target/agent/harlo-agent "$pkgdir/usr/lib/harlo/harlo-agent"
    if [ -f target/x86_64-unknown-linux-musl/agent/harlo-agent ]; then
        install -Dm755 target/x86_64-unknown-linux-musl/agent/harlo-agent "$pkgdir/usr/lib/harlo/harlo-agent-x86_64"
    fi
    cp -a target/openwiki "$pkgdir/usr/lib/harlo/openwiki"
    install -Dm644 packaging/harlo.desktop "$pkgdir/usr/share/applications/harlo.desktop"
    install -Dm644 crates/harlo-app/icons/app/harlo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/harlo.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # Bundled third-party material.
    install -Dm644 crates/harlo-app/themes/LICENSE "$pkgdir/usr/share/licenses/$pkgname/themes-LICENSE"
    install -Dm644 crates/harlo-app/fonts/FileIcons-LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/file-icons-LICENSE"
    install -Dm644 crates/harlo-app/icons/REMIXICON-LICENSE "$pkgdir/usr/share/licenses/$pkgname/remixicon-LICENSE"
    install -Dm644 crates/harlo-app/icons/providers/OPENCHAMBER-LICENSE "$pkgdir/usr/share/licenses/$pkgname/provider-logos-LICENSE"
    install -Dm644 crates/harlo-app/phone/TWEETNACL-LICENSE "$pkgdir/usr/share/licenses/$pkgname/tweetnacl-LICENSE"
    install -Dm644 crates/harlo-app/assets/mermaid/LICENSE "$pkgdir/usr/share/licenses/$pkgname/mermaid-LICENSE"
    install -Dm644 crates/harlo-app/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/jetbrains-mono-OFL.txt"
    install -Dm644 crates/harlo-app/fonts/Geist-OFL.txt "$pkgdir/usr/share/licenses/$pkgname/geist-OFL.txt"
    install -Dm644 crates/harlo-app/icons/PASEO-NOTICE "$pkgdir/usr/share/licenses/$pkgname/paseo-NOTICE"
    install -Dm644 crates/harlo-app/sounds/NOTICE "$pkgdir/usr/share/licenses/$pkgname/sounds-NOTICE"
    install -Dm644 crates/harlo-app/sounds/CC-BY-SA-4.0.txt "$pkgdir/usr/share/licenses/$pkgname/sounds-CC-BY-SA-4.0.txt"
    for f in node openwiki packages; do
        install -Dm644 "target/openwiki/LICENSES/$f.txt" "$pkgdir/usr/share/licenses/$pkgname/openwiki-$f.txt"
    done
}
