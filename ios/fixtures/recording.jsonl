{"args":{"key":"ses_df0838e72ffeMD2Sd4Yn817mX8","path":"src/sidebar.rs"},"call":"file","reply":{"cut":false,"id":14,"lines":["use crate::projects::project_rows;","","/// The sidebar's rows: each project's sessions, newest first.","pub fn rebuild(rows: &amp;mut Vec&lt;Row&gt;, input: &amp;SidebarInput) {","    for project in &amp;input.projects {","        let fresh = project_rows(project, input);","        merge_by_key(rows, fresh);","    }","}","","/// Rows matched by key: changed ones updated in place, new ones inserted.","pub fn merge_by_key(rows: &amp;mut Vec&lt;Row&gt;, fresh: Vec&lt;Row&gt;) {","    rows.retain(|r| fresh.iter().any(|f| f.key == r.key));","    for f in fresh {","        match rows.iter_mut().find(|r| r.key == f.key) {","            Some(r) =&gt; *r = f,","            None =&gt; rows.push(f),","        }","    }","}"],"path":"src/sidebar.rs","total":20}}
