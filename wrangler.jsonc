// harlo.run: the website in site/, served by Cloudflare (Workers static
// assets, no code). Deployed by Cloudflare's build on pushes to main:
// `npx wrangler deploy`. site/_headers and site/_redirects apply.
{
  "name": "harlo",
  "compatibility_date": "2026-06-01",
  // Only at harlo.run (and www): no workers.dev address, no preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    // /download serves download.html; unknown pages get 404.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
